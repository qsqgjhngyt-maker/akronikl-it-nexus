// В новой отдельной базе. Общий модуль уже создан по инструкции.
Процедура ПриНачалеРаботыСистемы()
    Данные = УчебныеСоединенияR3.ПодготовитьНабор(30, 45, "Сервис");
    Строки = УчебныеСоединенияR3.ВыполнитьЗапрос(
        УчебныеСоединенияR3.ТекстДетальногоЗапроса(), Данные.Ключи);
    Итоги = УчебныеСоединенияR3.ВыполнитьЗапрос(
        УчебныеСоединенияR3.ТекстИтоговогоЗапроса(), Данные.Ключи);

    Сообщить("После соединения: клиент | заявка | минуты");
    Для Каждого СтрокаРезультата Из Строки Цикл
        Клиент = УчебныеСоединенияR3.МеткаКлиента(СтрокаРезультата.Клиент, Данные);
        Если ТипЗнч(СтрокаРезультата.Заявка) = Тип("Null") Тогда
            МеткаЗаявки = "NULL";
        ИначеЕсли СтрокаРезультата.Заявка = Данные.ПерваяЗаявка Тогда
            МеткаЗаявки = "J1";
        Иначе
            МеткаЗаявки = "J2";
        КонецЕсли;
        Сообщить(Клиент + " | " + МеткаЗаявки + " | "
            + УчебныеСоединенияR3.ТекстМинут(СтрокаРезультата.Минуты));
    КонецЦикла;

    Сообщить("После группировки: клиент | минуты");
    Для Каждого СтрокаРезультата Из Итоги Цикл
        Клиент = УчебныеСоединенияR3.МеткаКлиента(СтрокаРезультата.Клиент, Данные);
        Сообщить(Клиент + " | " + Строка(СтрокаРезультата.Минуты));
    КонецЦикла;
КонецПроцедуры
