#Если ТолстыйКлиентУправляемоеПриложение Тогда
Перем УспешныеПроверки;

Процедура Проверить(Условие, Идентификатор)
    Если Условие <> Истина Тогда
        ВызватьИсключение "NEXUS_CHECK_FAILED: " + Идентификатор;
    КонецЕсли;
    УспешныеПроверки.Добавить(Идентификатор + "|PASS");
КонецПроцедуры

// P2.1: один и тот же алгоритм в русской и английской записи.
Функция ДобавитьМинуты(Первое, Второе)
    Возврат Первое + Второе;
КонецФункции

Function AddMinutes(LeftValue, RightValue)
    Return LeftValue + RightValue;
EndFunction

// P2.2: ноль является допустимым числом, строка "30" числом не является.
Функция ЭтоЧислоМинут(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Значение >= 0 И Значение <= 1440;
КонецФункции

// P2.3: порядок ветвей задаёт решение для граничных значений.
Функция КлассДлительности(Минуты)
    Если Не ЭтоЧислоМинут(Минуты) Тогда
        Возврат "Отклонено";
    ИначеЕсли Минуты = 0 Тогда
        Возврат "БезЗатрат";
    ИначеЕсли Минуты <= 60 Тогда
        Возврат "Короткая";
    Иначе
        Возврат "Длинная";
    КонецЕсли;
КонецФункции

// P2.4: ограниченный обход, исходный массив не меняется.
Функция СуммаМинут(Значения)
    Итог = 0;
    Для Каждого Элемент Из Значения Цикл
        Если Не ЭтоЧислоМинут(Элемент) Тогда
            ВызватьИсключение "Недопустимые учебные минуты";
        КонецЕсли;
        Итог = Итог + Элемент;
    КонецЦикла;
    Возврат Итог;
КонецФункции

// P2.5: входы здесь уже числа; правила разбора произвольного текста не подразумеваются.
Функция УчебнаяСтоимость(Минуты, Тариф)
    Возврат Минуты * Тариф / 60;
КонецФункции

Процедура ПроверитьP2()
    Проверить(4 + 2 * 3 = 10, "P2.1.precedence");
    Проверить((4 + 2) * 3 = 18, "P2.1.parentheses");
    Проверить(3 / 2 = 1.5, "P2.1.division");
    Проверить("REQ-" + "001" = "REQ-001", "P2.1.concatenation");
    Проверить(ДобавитьМинуты(30, 45) = 75, "P2.1.russian-keywords");
    Проверить(AddMinutes(30, 45) = 75, "P2.1.english-keywords");
    Проверить(ТипЗнч(Неопределено) = Тип("Неопределено"), "P2.2.undefined-type");
    Проверить(ТипЗнч(Null) = Тип("Null"), "P2.2.null-type");
    Проверить(ТипЗнч(Неопределено) <> ТипЗнч(Null), "P2.2.distinct-empty-types");
    Проверить(ЭтоЧислоМинут(0), "P2.2.zero-is-valid");
    Проверить(Не ЭтоЧислоМинут("30"), "P2.2.text-is-not-number");
    Проверить(Не ЭтоЧислоМинут(Неопределено), "P2.2.undefined-rejected");
    Проверить(Число("12") = 12, "P2.2.explicit-conversion");
    КонверсияОтклонена = Ложь;
    Попытка
        РезультатКонверсии = Число("не число");
    Исключение
        КонверсияОтклонена = Истина;
    КонецПопытки;
    Проверить(КонверсияОтклонена, "P2.2.bad-conversion");
    Проверить(Не ЗначениеЗаполнено(0), "P2.2.filled-is-not-validation");
    Проверить(КлассДлительности(-1) = "Отклонено", "P2.3.negative");
    Проверить(КлассДлительности(0) = "БезЗатрат", "P2.3.zero");
    Проверить(КлассДлительности(60) = "Короткая", "P2.3.inclusive-boundary");
    Проверить(КлассДлительности(61) = "Длинная", "P2.3.next-boundary");
    Проверить(КлассДлительности(1440) = "Длинная", "P2.3.maximum");
    Проверить(КлассДлительности(1441) = "Отклонено", "P2.3.over-maximum");
    Проверить(КлассДлительности("60") = "Отклонено", "P2.3.wrong-type");
    Длительности = Новый Массив;
    Длительности.Добавить(30); Длительности.Добавить(45); Длительности.Добавить(0);
    Проверить(СуммаМинут(Длительности) = 75, "P2.4.foreach-total");
    Проверить(Длительности.Количество() = 3, "P2.4.input-preserved");
    Проверить(СуммаМинут(Новый Массив) = 0, "P2.4.empty-array");
    Итог = 0;
    Для Номер = 1 По 3 Цикл Итог = Итог + Номер; КонецЦикла;
    Проверить(Итог = 6, "P2.4.inclusive-for");
    Счетчик = 0;
    Пока Счетчик < 3 Цикл Счетчик = Счетчик + 1; КонецЦикла;
    Проверить(Счетчик = 3, "P2.4.while-termination");
    Выбрано = 0;
    Для Номер = 1 По 5 Цикл
        Если Номер = 2 Тогда Продолжить; КонецЕсли;
        Если Номер = 4 Тогда Прервать; КонецЕсли;
        Выбрано = Выбрано + Номер;
    КонецЦикла;
    Проверить(Выбрано = 4, "P2.4.continue-break");
    ПлохойНабор = Новый Массив; ПлохойНабор.Добавить(-1);
    НаборОтклонен = Ложь;
    Попытка Итог = СуммаМинут(ПлохойНабор); Исключение НаборОтклонен = Истина; КонецПопытки;
    Проверить(НаборОтклонен, "P2.4.invalid-element");
    Проверить(0.1 + 0.2 = 0.3, "P2.5.decimal-sum");
    Проверить(УчебнаяСтоимость(30, 600) = 300, "P2.5.cost");
    Проверить(Формат(12.5, "ЧДЦ=2; ЧРД=.; ЧГ=0") = "12.50", "P2.5.explicit-format");
    Начало = Дата(2026, 10, 31, 9, 30, 0);
    Проверить(Год(Начало) = 2026 И Месяц(Начало) = 10 И День(Начало) = 31, "P2.5.date-components");
    Проверить((Начало + 60) - Начало = 60, "P2.5.date-seconds");
    Проверить(СтрДлина("Заявка") = 6, "P2.5.string-length");
КонецПроцедуры

Функция КлиентПоКоду(Код, Имя)
    Ссылка = Справочники.Клиенты.НайтиПоКоду(Код);
    Если Ссылка.Пустая() Тогда
        Объект = Справочники.Клиенты.СоздатьЭлемент();
        Объект.Код = Код; Объект.Наименование = Имя; Объект.Записать();
        Ссылка = Объект.Ссылка;
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Функция УслугаПоКоду(Код, Имя, Тариф)
    Ссылка = Справочники.Услуги.НайтиПоКоду(Код);
    Если Ссылка.Пустая() Тогда
        Объект = Справочники.Услуги.СоздатьЭлемент();
        Объект.Код = Код; Объект.Наименование = Имя; Объект.ТарифЗаЧас = Тариф; Объект.Записать();
        Ссылка = Объект.Ссылка;
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Процедура СоздатьЗаявку(Номер, Клиент, Услуга, Минуты, Статус)
    Ссылка = Документы.ЗаявкаУслуги.НайтиПоНомеру(Номер);
    Если Не Ссылка.Пустая() Тогда Возврат; КонецЕсли;
    Объект = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Объект.Номер = Номер; Объект.Дата = Дата(2026, 10, 31, 10, 0, 0);
    Объект.Клиент = Клиент; Объект.Услуга = Услуга;
    Объект.ДлительностьМинут = Минуты; Объект.Статус = Статус;
    Объект.Комментарий = "Синтетическая учебная запись"; Объект.Записать();
КонецПроцедуры

Процедура ЗаполнитьСтенд()
    Альфа = КлиентПоКоду("C001", "Учебный клиент Альфа");
    Бета = КлиентПоКоду("C002", "Учебный клиент Бета");
    ДругаяАльфа = КлиентПоКоду("C003", "Учебный клиент Альфа");
    Диагностика = УслугаПоКоду("S001", "Диагностика", 600);
    Настройка = УслугаПоКоду("S002", "Настройка", 900);
    СоздатьЗаявку("A200001", Альфа, Диагностика, 30, Перечисления.СтатусыЗаявки.Новая);
    СоздатьЗаявку("A200002", Бета, Настройка, 45, Перечисления.СтатусыЗаявки.ВРаботе);
КонецПроцедуры

Функция КоличествоСтрок(Таблица)
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + Таблица);
    Строка = Запрос.Выполнить().Выбрать(); Строка.Следующий(); Возврат Строка.Число;
КонецФункции

Процедура ПроверитьОтказЗаписи(БезКлиента)
    Объект = Документы.ЗаявкаУслуги.СоздатьДокумент(); Объект.Дата = Дата(2026, 10, 31);
    Объект.Услуга = Справочники.Услуги.НайтиПоКоду("S001"); Объект.Статус = Перечисления.СтатусыЗаявки.Новая;
    Если Не БезКлиента Тогда Объект.Клиент = Справочники.Клиенты.НайтиПоКоду("C001"); КонецЕсли;
    Объект.ДлительностьМинут = ?(БезКлиента, 30, -1);
    Отклонено = Ложь;
    Попытка Объект.Записать(); Исключение Отклонено = Истина; КонецПопытки;
    Проверить(Отклонено, ?(БезКлиента, "A2.empty-reference-rejected", "A2.negative-minutes-rejected"));
КонецПроцедуры

Функция ПроверитьДанные(Копия)
    Проверить(КоличествоСтрок("Справочник.Клиенты") = 3, "A2.customer-count");
    Проверить(КоличествоСтрок("Справочник.Услуги") = 2, "A2.service-count");
    Проверить(КоличествоСтрок("Документ.ЗаявкаУслуги") = 2, "A2.document-count");
    Альфа = Справочники.Клиенты.НайтиПоКоду("C001"); ДругаяАльфа = Справочники.Клиенты.НайтиПоКоду("C003");
    Проверить(Альфа <> ДругаяАльфа И Альфа.Наименование = ДругаяАльфа.Наименование, "A2.identity-not-presentation");
    Первая = Документы.ЗаявкаУслуги.НайтиПоНомеру("A200001").ПолучитьОбъект();
    Вторая = Документы.ЗаявкаУслуги.НайтиПоНомеру("A200002").ПолучитьОбъект();
    Проверить(Первая.Клиент = Альфа И Вторая.Клиент.Код = "C002"
        И Первая.Услуга.Код = "S001" И Вторая.Услуга.Код = "S002"
        И Первая.Услуга.ТарифЗаЧас = 600 И Вторая.Услуга.ТарифЗаЧас = 900, "A2.reference-links");
    Проверить(Не Первая.Проведен И Не Вторая.Проведен, "A2.saved-not-posted");
    Итог = Первая.ДлительностьМинут + Вторая.ДлительностьМинут;
    Проверить(Итог = ?(Копия, 90, 75), "A2.persisted-total");
    Проверить(Первая.Статус = Перечисления.СтатусыЗаявки.Новая
        И Вторая.Статус = Перечисления.СтатусыЗаявки.ВРаботе
        И Первая.Дата = Дата(2026, 10, 31, 10, 0, 0)
        И Вторая.Дата = Дата(2026, 10, 31, 10, 0, 0), "A2.business-state-not-posting");
    Снимок = "C001=" + Строка(Альфа.УникальныйИдентификатор()) + Символы.ПС;
    Снимок = Снимок + "C003=" + Строка(ДругаяАльфа.УникальныйИдентификатор()) + Символы.ПС;
    Снимок = Снимок + "A200001=" + Строка(Первая.Ссылка.УникальныйИдентификатор()) + "|30" + Символы.ПС;
    Возврат Снимок + "A200002=" + Строка(Вторая.Ссылка.УникальныйИдентификатор()) + "|" + Формат(Вторая.ДлительностьМинут, "ЧГ=0");
КонецФункции

Процедура ЗаписатьРезультат(Путь, Текст)
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8); Запись.ЗаписатьСтроку(Текст); Запись.Закрыть();
КонецПроцедуры

Процедура ПриНачалеРаботыСистемы()
    Если ПараметрЗапуска = "" Тогда
        Сообщить("Учебная сервисная служба A2/P2. Для своих работ используйте отдельную копию. Автоматическое заполнение не выполнялось.");
        Возврат;
    КонецЕсли;
    Части = СтрРазделить(ПараметрЗапуска, "|");
    Если Части.Количество() <> 2 Тогда ВызватьИсключение "Нужны режим и новый путь результата"; КонецЕсли;
    Режим = Части[0]; Путь = Части[1];
    Если Режим <> "seed" И Режим <> "verify" И Режим <> "edit-copy" И Режим <> "verify-copy" Тогда ВызватьИсключение "Неизвестный режим"; КонецЕсли;
    Попытка
    УспешныеПроверки = Новый Массив;
    ПроверитьP2();
    Если Режим = "seed" Тогда ЗаполнитьСтенд(); КонецЕсли;
    Если Режим = "edit-copy" Тогда
        Объект = Документы.ЗаявкаУслуги.НайтиПоНомеру("A200002").ПолучитьОбъект();
        Объект.ДлительностьМинут = 60; Объект.Комментарий = "Изменение только отдельной копии"; Объект.Записать();
    КонецЕсли;
    Копия = Режим = "edit-copy" Или Режим = "verify-copy";
    Снимок = ПроверитьДанные(Копия);
    ПроверитьОтказЗаписи(Истина); ПроверитьОтказЗаписи(Ложь);
    Проверить(КоличествоСтрок("Документ.ЗаявкаУслуги") = 2, "A2.failed-writes-preserved-count");
    ЗаписатьРезультат(Путь, "NEXUS_A2P2|customers=3|services=2|documents=2|minutes=" + ?(Копия, "90", "75") + "|checks=" + Формат(УспешныеПроверки.Количество(), "ЧГ=0") + "|PASS");
    ЗаписатьРезультат(Путь + ".cases.txt", СтрСоединить(УспешныеПроверки, Символы.ПС));
    ЗаписатьРезультат(Путь + ".snapshot.txt", Снимок);
    Исключение
        Причина = ОписаниеОшибки();
        Позиция = СтрНайти(Причина, "NEXUS_CHECK_FAILED:");
        Если Позиция > 0 Тогда
            Детали = СтрРазделить(Сред(Причина, Позиция), Символы.ПС);
            ЗаписатьРезультат(Путь, "NEXUS_A2P2|FAIL|" + Детали[0]);
        Иначе
            ЗаписатьРезультат(Путь, "NEXUS_A2P2|FAIL|RUNTIME_ERROR");
        КонецЕсли;
    КонецПопытки;
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

#КонецЕсли
