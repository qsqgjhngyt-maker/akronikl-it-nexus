// Оригинальный учебный probe P1. Это модуль официальной платформы, не JS.
// В P1 данные существуют в памяти. Справочники/документы добавляются в A2/P4.
Процедура ПроверитьУсловие(Условие, Метка)
    Если Не Условие Тогда
        ВызватьИсключение "NEXUS_TEST_FAILED: " + Метка;
    КонецЕсли;
КонецПроцедуры

Функция ДопустимыйСтатус(Статус)
    Возврат Статус = "Новая" Или Статус = "В работе" Или Статус = "Закрыта";
КонецФункции

Процедура ПриНачалеРаботыСистемы()
    Заявки = Новый Массив;
    Заявки.Добавить(Новый Структура("Код,Минуты,Статус", "REQ-001", 30, "Новая"));
    Заявки.Добавить(Новый Структура("Код,Минуты,Статус", "REQ-002", 45, "В работе"));
    Заявки.Добавить(Новый Структура("Код,Минуты,Статус", "REQ-003", 30, "Закрыта"));
    Минуты = 0;
    Для Каждого Заявка Из Заявки Цикл
        ПроверитьУсловие(ДопустимыйСтатус(Заявка.Статус), "статус заявки");
        Минуты = Минуты + Заявка.Минуты;
    КонецЦикла;
    ПроверитьУсловие(Заявки.Количество() = 3, "число заявок");
    ПроверитьУсловие(Минуты = 105, "сумма минут");
    ПроверитьУсловие(Не ДопустимыйСтатус(""), "пустой статус отклонён");
    ПроверитьУсловие(Не ДопустимыйСтатус("Оплачена"), "чужой статус отклонён");
    Результат = "NEXUS_1C_P1|requests=3|minutes=105|negative=2|PASS";
    Сообщить(Результат);
    Если ПараметрЗапуска <> "" Тогда
        Запись = Новый ЗаписьТекста(ПараметрЗапуска, КодировкаТекста.UTF8);
        Запись.ЗаписатьСтроку(Результат);
        Запись.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
    КонецЕсли;
КонецПроцедуры
