    Набор.Имя = "Заявки"; Набор.ИсточникДанных = "Основной";
    Набор.Запрос = "ВЫБРАТЬ З.Ссылка КАК Ссылка, З.Минуты КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З";
    Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных")); Поле.ПутьКДанным = "Минуты"; Поле.Поле = "Минуты"; Поле.Заголовок = "Минуты";
