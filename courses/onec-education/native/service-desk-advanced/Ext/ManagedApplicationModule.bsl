    Проверить(РольДоступна("УчебныйЧитатель") И Не РольДоступна("УчебныйАдминистратор"), "ADV.RLS.actual-restricted-role");
    Таблица = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ З.Ссылка, З.Минуты ИЗ Документ.ЗаявкаУслуги КАК З"); Данные = Таблица.Выполнить().Выгрузить();
