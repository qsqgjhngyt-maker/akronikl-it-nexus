    Выбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); Выбор.Поле = Новый ПолеКомпоновкиДанных("Минуты"); Выбор.Использование = Истина;
    ВыборСсылки = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); ВыборСсылки.Поле = Новый ПолеКомпоновкиДанных("Ссылка"); ВыборСсылки.Использование = Истина;
    Группа = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных")); Группа.Использование = Истина;
    ВыборГруппы = Группа.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = Компоновщик.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет);
    Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    Таблица = Вывод.Вывести(Процессор);
    Если Таблица.Количество() <> 12 Или Таблица.Итог("Минуты") <> 440 Тогда ВызватьИсключение "DCS_ROWS=" + Строка(Таблица.Количество()) + ";SUM=" + Строка(Таблица.Итог("Минуты")); КонецЕсли;
    Проверить(Таблица.Количество() = 12 И Таблица.Итог("Минуты") = 440, "ADV.DCS.native-twelve-rows-440");
    Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Минуты"); Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше; Отбор.ПравоеЗначение = 60; Отбор.Использование = Истина;
    Макет = Компоновщик.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); Процессор.Инициализировать(Макет); Таблица = Вывод.Вывести(Процессор);
    Ожидание = Новый Запрос("ВЫБРАТЬ З.Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Минуты > 60"); Ожидаемые = Ожидание.Выполнить().Выгрузить();
