Процедура ПриНачалеРаботыСистемы()
    Если ПараметрЗапуска = "" Тогда Сообщить("Оригинальный расширенный учебный QA Nexus"); Возврат; КонецЕсли;
    Аргументы = СтрРазделить(ПараметрЗапуска, "|"); Путь = Аргументы[1]; УспешныеПроверки = Новый Массив;
    Попытка
        Если Аргументы[0] = "reader" Тогда ПроверитьЧитателя();
