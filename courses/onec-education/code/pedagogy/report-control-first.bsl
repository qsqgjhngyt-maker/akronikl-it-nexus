// Не обязательный код прикладного ученика; оригинальный инженерный контроль его набора.
Функция ОпытОтбораОтчёта() Экспорт
    ОбщийЗапрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество, ЕСТЬNULL(СУММА(З.ДлительностьМинут),0) КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ НЕ З.ПометкаУдаления");
    До = ОбщийЗапрос.Выполнить().Выгрузить();
    Альфа = Справочники.Клиенты.СоздатьЭлемент(); Альфа.Наименование = "Учебный A7 — Альфа"; Альфа.Записать();
    Бета = Справочники.Клиенты.СоздатьЭлемент(); Бета.Наименование = "Учебный A7 — Бета"; Бета.Записать();
    ДругаяАльфа = Справочники.Клиенты.СоздатьЭлемент(); ДругаяАльфа.Наименование = "Учебный A7 — Альфа"; ДругаяАльфа.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная A7 — диагностика"; Услуга.Записать();
    Для Индекс = 1 По 3 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,9+Индекс,0,0);
        Документ.Клиент = ?(Индекс < 3,Альфа.Ссылка,Бета.Ссылка); Документ.Услуга = Услуга.Ссылка;
        Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,30,?(Индекс = 2,45,15)); Документ.Записать();
    КонецЦикла;
    После = ОбщийЗапрос.Выполнить().Выгрузить();
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество, ЕСТЬNULL(СУММА(З.ДлительностьМинут),0) КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ НЕ З.ПометкаУдаления И З.Клиент = &Клиент");
    Запрос.УстановитьПараметр("Клиент",Альфа.Ссылка); ИтогАльфа = Запрос.Выполнить().Выгрузить();
    Запрос.УстановитьПараметр("Клиент",Бета.Ссылка); ИтогБета = Запрос.Выполнить().Выгрузить();
    Запрос.УстановитьПараметр("Клиент",ДругаяАльфа.Ссылка); ИтогДругой = Запрос.Выполнить().Выгрузить();
    ВсеЧислаВерны = После[0].Количество - До[0].Количество = 3 И После[0].Минуты - До[0].Минуты = 90
        И ИтогАльфа[0].Количество = 2 И ИтогАльфа[0].Минуты = 75
        И ИтогБета[0].Количество = 1 И ИтогБета[0].Минуты = 15;
    ОдинаковоеИмяНеСсылка = Альфа.Наименование = ДругаяАльфа.Наименование И Альфа.Ссылка <> ДругаяАльфа.Ссылка
        И ИтогДругой[0].Количество = 0 И ИтогДругой[0].Минуты = 0;
    Возврат Новый Структура("ВсеЧислаВерны,ОдинаковоеИмяНеСсылка,Альфа,Бета,ДругаяАльфа",ВсеЧислаВерны,ОдинаковоеИмяНеСсылка,Альфа.Ссылка,Бета.Ссылка,ДругаяАльфа.Ссылка);
КонецФункции
