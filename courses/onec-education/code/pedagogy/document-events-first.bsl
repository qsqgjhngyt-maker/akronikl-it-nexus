Функция ОпытОтказаПриЗаписи() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный P5 — проверка"; Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебная P5 — проверка"; Услуга.Записать();
    Документ = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Документ.Дата = Дата(2026,11,2,13,0,0);
    Документ.Услуга = Услуга.Ссылка;
    Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
    Документ.ДлительностьМинут = 30;
    КлиентОбязателен = Ложь;
    Попытка Документ.Записать(); Исключение КлиентОбязателен = Документ.Ссылка.Пустая(); КонецПопытки;
    Документ.Клиент = Клиент.Ссылка;
    Документ.ДлительностьМинут = 1441;
    ГраницаПроверена = Ложь;
    Попытка Документ.Записать(); Исключение ГраницаПроверена = Документ.Ссылка.Пустая(); КонецПопытки;
    Документ.ДлительностьМинут = 30;
    Документ.Записать();
    Сохраненный = Документ.Ссылка.ПолучитьОбъект();
    ИсправлениеСохранено = Сохраненный.Клиент = Клиент.Ссылка И Сохраненный.Услуга = Услуга.Ссылка
        И Сохраненный.ДлительностьМинут = 30;
    Возврат Новый Структура("КлиентОбязателен,ГраницаПроверена,ИсправлениеСохранено,Ссылка",КлиентОбязателен,ГраницаПроверена,ИсправлениеСохранено,Документ.Ссылка);
КонецФункции
