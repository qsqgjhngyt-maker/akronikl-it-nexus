Функция ОпытИдентичности() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебная идентичность — до";
    Клиент.Записать();
    СсылкаДо = Клиент.Ссылка;
    Клиент.Наименование = "Учебная идентичность — после";
    Клиент.Записать();
    Другой = Справочники.Клиенты.СоздатьЭлемент();
    Другой.Наименование = Клиент.Наименование;
    Другой.Записать();
    Возврат Новый Структура("ПереименованиеСохранилоСсылку,ОдинаковыеИменаРазныеСсылки",
        Клиент.Ссылка = СсылкаДо, Другой.Ссылка <> СсылкаДо);
КонецФункции
