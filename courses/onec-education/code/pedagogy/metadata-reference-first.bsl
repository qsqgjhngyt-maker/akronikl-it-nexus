Функция ОпытСвязаннойЗаявки() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебная связь — до";
    Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебная проверка ссылки";
    Услуга.ТарифЗаЧас = 600;
    Услуга.Записать();
    Заявка = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Заявка.Дата = Дата(2026, 11, 2, 10, 0, 0);
    Заявка.Клиент = Клиент.Ссылка;
    Заявка.Услуга = Услуга.Ссылка;
    Заявка.ДлительностьМинут = 30;
    Заявка.Статус = Перечисления.СтатусыЗаявки.Новая;
    Заявка.Комментарий = "Собственная учебная проверка связи";
    Заявка.Записать();
    СсылкаКлиента = Клиент.Ссылка;
    Клиент.Наименование = "Учебная связь — после";
    Клиент.Записать();
    Повторно = Заявка.Ссылка.ПолучитьОбъект();
    Возврат Новый Структура("СвязьСохранена,МинутыСохранены,ТекущееИмя",
        Повторно.Клиент = СсылкаКлиента, Повторно.ДлительностьМинут = 30,
        Повторно.Клиент.Наименование);
КонецФункции
