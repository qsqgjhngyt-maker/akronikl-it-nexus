// Только инженерная проверка собственной синтетической базы; не обязательный код ученика.
Функция ПодготовитьИсходник() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Код = "A50000001";
    Клиент.Наименование = "Учебный A5";
    Клиент.УчебнаяЗаметка = "Заметка A4 сохранена";
    Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Код = "S50000001";
    Услуга.Наименование = "Диагностика A5";
    Услуга.Записать();
    Заявка = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Заявка.Номер = "A50000001";
    Заявка.Дата = Дата(2026, 11, 2, 10, 0, 0);
    Заявка.Клиент = Клиент.Ссылка;
    Заявка.Услуга = Услуга.Ссылка;
    Заявка.ДлительностьМинут = 30;
    Заявка.Статус = Перечисления.СтатусыЗаявки.Новая;
    Заявка.Комментарий = "Исходная шапка A5";
    Заявка.Записать();
    Возврат СнимокИсходника();
КонецФункции

Функция СнимокИсходника() Экспорт
    Клиент = Справочники.Клиенты.НайтиПоКоду("A50000001");
    Услуга = Справочники.Услуги.НайтиПоКоду("S50000001");
    Заявка = Документы.ЗаявкаУслуги.НайтиПоНомеру("A50000001");
    Возврат Строка(Клиент.УникальныйИдентификатор()) + "|" + Клиент.Код + "|" + Клиент.Наименование + "|" + Клиент.УчебнаяЗаметка
        + "|" + Строка(Услуга.УникальныйИдентификатор()) + "|" + Услуга.Код + "|" + Услуга.Наименование
        + "|" + Строка(Заявка.УникальныйИдентификатор()) + "|" + Заявка.Номер + "|" + Формат(Заявка.Дата,"ДФ=yyyyMMddHHmmss")
        + "|" + Строка(Заявка.Клиент.УникальныйИдентификатор()) + "|" + Строка(Заявка.Услуга.УникальныйИдентификатор())
        + "|" + Строка(Заявка.ДлительностьМинут) + "|" + Строка(Заявка.Статус) + "|" + Заявка.Комментарий
        + "|" + Строка(Заявка.ПометкаУдаления) + "|" + Строка(Заявка.Проведен);
КонецФункции

Процедура Утверждение(Условие, Имя, Проверки)
    Если Не Условие Тогда ВызватьИсключение "A5: " + Имя; КонецЕсли;
    Проверки.Добавить(Имя);
КонецПроцедуры

Функция ПроверитьНовыеДанные() Экспорт
    Проверки = Новый Массив;
    Исходная = Документы.ЗаявкаУслуги.НайтиПоНомеру("A50000001");
    Утверждение(Исходная.ПолучитьОбъект().Работы.Количество() = 0, "older-document-empty-new-rows", Проверки);
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный A5 — опыт";
    Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Диагностика A5 — выезд";
    Услуга.Записать();
    Заявка = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Заявка.Дата = Дата(2026, 11, 2, 11, 0, 0);
    Заявка.Клиент = Клиент.Ссылка;
    Заявка.Услуга = Услуга.Ссылка;
    Заявка.Статус = Перечисления.СтатусыЗаявки.Новая;
    Заявка.ДлительностьМинут = 30;
    Первая = Заявка.Работы.Добавить(); Первая.Услуга = Услуга.Ссылка; Первая.Минуты = 20;
    Вторая = Заявка.Работы.Добавить(); Вторая.Услуга = Исходная.Услуга; Вторая.Минуты = 10;
    Заявка.Записать();
    Сохраненная = Заявка.Ссылка.ПолучитьОбъект();
    Утверждение(Сохраненная.ДлительностьМинут = 30 И Сохраненная.Работы.Количество() = 2, "header-and-two-rows-persisted", Проверки);
    Утверждение(Сохраненная.Работы[0].Минуты = 20 И Сохраненная.Работы[1].Минуты = 10, "row-order-values-persisted", Проверки);
    Клиент.Наименование = "Учебный A5 — уточнено"; Клиент.Записать();
    Услуга.Наименование = "Диагностика A5 — проверено"; Услуга.Записать();
    Сохраненная = Заявка.Ссылка.ПолучитьОбъект();
    Утверждение(Сохраненная.Клиент = Клиент.Ссылка И Сохраненная.Услуга = Услуга.Ссылка, "rename-preserves-references", Проверки);
    // Иной итог строк специально не рассчитывается в шапке: это отрицательный контроль ложного ожидания.
    Сохраненная.Работы[0].Минуты = 21; Сохраненная.Записать();
    Перечитанная = Заявка.Ссылка.ПолучитьОбъект();
    Утверждение(Перечитанная.ДлительностьМинут = 30 И Перечитанная.Работы[0].Минуты + Перечитанная.Работы[1].Минуты = 31, "no-implicit-header-recalculation", Проверки);
    Перечитанная.Работы[0].Минуты = 20; Перечитанная.Записать();
    Отрицательная = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Отрицательная.Дата = Дата(2026, 11, 2); Отрицательная.Услуга = Услуга.Ссылка;
    Отрицательная.Статус = Перечисления.СтатусыЗаявки.Новая;
    СтрокаРабот = Отрицательная.Работы.Добавить(); СтрокаРабот.Услуга = Услуга.Ссылка; СтрокаРабот.Минуты = 20;
    Отклонена = Ложь;
    Попытка Отрицательная.Записать(); Исключение Отклонена = Истина; КонецПопытки;
    Утверждение(Отклонена И Отрицательная.Ссылка.Пустая(), "rows-do-not-bypass-required-customer", Проверки);
    Возврат Новый Структура("Проверки,Ссылка", Проверки, Заявка.Ссылка);
КонецФункции
