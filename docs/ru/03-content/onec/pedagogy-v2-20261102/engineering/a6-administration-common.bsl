// Инженерная проверка своей синтетической базы. Не обязательный код начинающего ученика.
Функция ПодготовитьA6() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Код = "A60000001";
    Клиент.Наименование = "Контроль A6"; Клиент.УчебнаяЗаметка = "Заметка A4 сохранена"; Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Код = "S60000001";
    Услуга.Наименование = "Контроль A6"; Услуга.Записать();
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Номер = ?(Индекс = 1,"A60000001","A60000002");
        Документ.Дата = Дата(2026,11,2,10+Индекс,0,0); Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка;
        Документ.ДлительностьМинут = ?(Индекс = 1,30,45); Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.Комментарий = "Контроль сохранности A6"; Документ.Записать();
    КонецЦикла;
    Возврат СнимокA6();
КонецФункции

Функция СнимокA6() Экспорт
    Клиент = Справочники.Клиенты.НайтиПоКоду("A60000001"); Услуга = Справочники.Услуги.НайтиПоКоду("S60000001");
    Текст = Строка(Клиент.УникальныйИдентификатор()) + "|" + Клиент.Код + "|" + Клиент.Наименование + "|" + Клиент.УчебнаяЗаметка
        + "|" + Строка(Услуга.УникальныйИдентификатор()) + "|" + Услуга.Код + "|" + Услуга.Наименование;
    Для Каждого Номер Из СтрРазделить("A60000001|A60000002","|") Цикл
        Документ = Документы.ЗаявкаУслуги.НайтиПоНомеру(Номер).ПолучитьОбъект();
        Текст = Текст + Символы.ПС + Строка(Документ.Ссылка.УникальныйИдентификатор()) + "|" + Документ.Номер
            + "|" + Формат(Документ.Дата,"ДФ=yyyyMMddHHmmss") + "|" + Строка(Документ.Клиент.УникальныйИдентификатор())
            + "|" + Строка(Документ.Услуга.УникальныйИдентификатор()) + "|" + Строка(Документ.ДлительностьМинут)
            + "|" + Строка(Документ.Статус) + "|" + Документ.Комментарий + "|" + Строка(Документ.ПометкаУдаления)
            + "|" + Строка(Документ.Проведен) + "|" + Строка(Документ.Работы.Количество());
    КонецЦикла;
    Возврат Текст;
КонецФункции

Процедура ПроверитьA6(Условие,Имя,Проверки)
    Если Не Условие Тогда ВызватьИсключение "A6: " + Имя; КонецЕсли;
    Проверки.Добавить(Имя);
КонецПроцедуры

Функция ПодготовитьПрофилиA6() Экспорт
    Проверки = Новый Массив;
    Услуга = Справочники.Услуги.НайтиПоКоду("S60000001");
    ПроверитьA6(Услуга.УчебноеОписание = "","old-service-new-field-empty",Проверки);
    Для Каждого Имя Из СтрРазделить("NexusA6Admin|NexusA6Reader","|") Цикл
        Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя(); Пользователь.Имя = Имя;
        Пользователь.АутентификацияСтандартная = Истина; Пользователь.АутентификацияОС = Ложь;
        Роль = Метаданные.Роли.Найти(?(Имя = "NexusA6Admin","УчебныйАдминистраторA6","УчебныйЧитательA6"));
        Пользователь.Роли.Добавить(Роль); Пользователь.Записать();
    КонецЦикла;
    ПроверитьA6(ПользователиИнформационнойБазы.НайтиПоИмени("NexusA6Admin") <> Неопределено
        И ПользователиИнформационнойБазы.НайтиПоИмени("NexusA6Reader") <> Неопределено,"two-own-synthetic-profiles",Проверки);
    Возврат Проверки;
КонецФункции

Функция ПроверитьЧитателяA6() Экспорт
    Проверки = Новый Массив;
    ПроверитьA6(ПравоДоступа("Чтение",Метаданные.Документы.ЗаявкаУслуги),"reader-read-granted",Проверки);
    ПроверитьA6(Не ПравоДоступа("Изменение",Метаданные.Документы.ЗаявкаУслуги),"reader-update-not-granted",Проверки);
    Ссылка = Документы.ЗаявкаУслуги.НайтиПоНомеру("A60000001");
    ПроверитьA6(Не Ссылка.Пустая() И Ссылка.ДлительностьМинут = 30,"reader-actual-document-read",Проверки);
    Документ = Ссылка.ПолучитьОбъект(); Документ.ДлительностьМинут = 31; Отказ = Ложь;
    Попытка Документ.Записать(); Исключение Отказ = Истина; КонецПопытки;
    ПроверитьA6(Отказ И Ссылка.ДлительностьМинут = 30,"reader-valid-update-rejected-no-change",Проверки);
    Возврат Проверки;
КонецФункции

Функция ПроверитьОбновлениеA6() Экспорт
    Проверки = Новый Массив;
    Клиент = Справочники.Клиенты.НайтиПоКоду("A60000001");
    ПроверитьA6(Клиент.УчебнаяЗаметка = "Заметка A4 сохранена","old-note-retained",Проверки);
    Услуга = Справочники.Услуги.НайтиПоКоду("S60000001").ПолучитьОбъект(); Услуга.УчебноеОписание = "Учебная проверка A6"; Услуга.Записать();
    ПроверитьA6(Услуга.Ссылка.УчебноеОписание = "Учебная проверка A6","new-description-written-reread",Проверки);
    Документ = Документы.ЗаявкаУслуги.НайтиПоНомеру("A60000001").ПолучитьОбъект(); Документ.ДлительностьМинут = 45; Документ.Записать();
    Запрос = Новый Запрос("ВЫБРАТЬ СУММА(З.ДлительностьМинут) КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент");
    Запрос.УстановитьПараметр("Клиент",Клиент); Итог = Запрос.Выполнить().Выгрузить();
    ПроверитьA6(Итог[0].Минуты = 90,"copy-only-total-90",Проверки);
    Документ.ДлительностьМинут = 1441; Отклонена = Ложь;
    Попытка Документ.Записать(); Исключение Отклонена = Истина; КонецПопытки;
    ПроверитьA6(Отклонена И Документ.Ссылка.ДлительностьМинут = 45,"diagnosis-business-rejection-preserved-45",Проверки);
    Возврат Проверки;
КонецФункции
