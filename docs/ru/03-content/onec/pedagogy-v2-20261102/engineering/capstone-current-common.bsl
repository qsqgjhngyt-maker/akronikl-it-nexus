// Оригинальный инженерный эталон A8/P12; собственная отдельная база, не код новичка.
Функция ИтоговыйОпыт(Режим) Экспорт
    Если Режим = "seed" Тогда
        Для Индекс = 1 По 3 Цикл
            Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Код = "A8C" + Строка(Индекс); Клиент.Наименование = ?(Индекс = 2,"Учебная Бета","Учебная Альфа"); Клиент.Записать();
        КонецЦикла;
        Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Код = "A8S1"; Услуга.Наименование = "Учебная консультация"; Услуга.Записать();
        Части = СтрРазделить("30,45,15,0,60,20,25,35,40,50,55,65",",");
        Для Индекс = 0 По 11 Цикл
            Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Номер = "F" + Прав("00000000"+СокрЛП(Строка(Индекс+1)),8); Документ.Дата = Дата(2026,11,2,12,0,0);
            Документ.Клиент = Справочники.Клиенты.НайтиПоКоду(?(Индекс % 2 = 0,"A8C1","A8C2")); Документ.Услуга = Услуга.Ссылка;
            Документ.Статус = Перечисления.СтатусыЗаявки.Новая; Документ.ДлительностьМинут = Число(Части[Индекс]); Документ.Комментарий = "A8 собственная " + Строка(Индекс+1); Документ.Записать();
        КонецЦикла;
    КонецЕсли;
    Если Режим = "edit" Тогда
        Документ = Документы.ЗаявкаУслуги.НайтиПоНомеру("F00000012").ПолучитьОбъект(); Документ.ДлительностьМинут = 80; Документ.Записать();
    КонецЕсли;
    Если Режим = "invalid" Тогда
        Ссылка = Документы.ЗаявкаУслуги.НайтиПоНомеру("F00000001"); Документ = Ссылка.ПолучитьОбъект();
        Отказ = Ложь; Попытка Документ.ДлительностьМинут = 1441; Документ.Записать(); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Или Ссылка.ДлительностьМинут <> 30 Тогда ВызватьИсключение "A8 отказ не сохранил30"; КонецЕсли;
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.Номер,З.Дата,З.Клиент,З.Услуга,З.Статус,З.ДлительностьМинут КАК Минуты,З.Комментарий КАК Заметка ИЗ Документ.ЗаявкаУслуги КАК З УПОРЯДОЧИТЬ ПО З.Номер");
    Таблица = Запрос.Выполнить().Выгрузить(); Ожидание = ?(Режим = "edit" Или Режим = "verify-copy",455,440);
    Если Таблица.Количество() <> 12 Или Таблица.Итог("Минуты") <> Ожидание Тогда ВызватьИсключение "A8 количество/сумма"; КонецЕсли;
    Альфа = Справочники.Клиенты.НайтиПоКоду("A8C1"); Бета = Справочники.Клиенты.НайтиПоКоду("A8C2"); Пустой = Справочники.Клиенты.НайтиПоКоду("A8C3");
    ИтогА = 0; ИтогБ = 0; Пустых = 0; Снимок = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Если Строка.Клиент = Альфа Тогда ИтогА = ИтогА + Строка.Минуты; КонецЕсли;
        Если Строка.Клиент = Бета Тогда ИтогБ = ИтогБ + Строка.Минуты; КонецЕсли;
        Если Строка.Клиент = Пустой Тогда Пустых = Пустых + 1; КонецЕсли;
        Снимок.Добавить(Строка.Номер+"|"+Строка(Строка.Ссылка.УникальныйИдентификатор())+"|"+Строка(Строка.Клиент.УникальныйИдентификатор())+"|"+Строка(Строка.Услуга.УникальныйИдентификатор())+"|"+Строка(Строка.Дата)+"|"+Строка(Строка.Статус)+"|"+Строка(Строка.Минуты)+"|"+Строка.Заметка);
    КонецЦикла;
    Если ИтогА <> 225 Или ИтогБ <> Ожидание - 225 Или Пустых <> 0 Или Альфа = Пустой Или Альфа.Наименование <> Пустой.Наименование Тогда ВызватьИсключение "A8 состав по ключам"; КонецЕсли;
    Возврат СтрСоединить(Снимок,Символы.ПС);
КонецФункции
