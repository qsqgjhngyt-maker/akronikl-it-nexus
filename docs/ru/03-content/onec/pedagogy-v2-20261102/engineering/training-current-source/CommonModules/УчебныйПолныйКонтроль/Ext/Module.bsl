// Общая подготовка P6; определение в серверном модуле добавляется один раз.
Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытИсторииТарифа() Экспорт
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная история тарифа"; Услуга.Записать();
    Первая = РегистрыСведений.ТарифыУслуг.СоздатьМенеджерЗаписи(); Первая.Период = Дата(2026,11,1); Первая.Услуга = Услуга.Ссылка; Первая.Тариф = 100; Первая.Записать();
    Вторая = РегистрыСведений.ТарифыУслуг.СоздатьМенеджерЗаписи(); Вторая.Период = Дата(2026,11,15); Вторая.Услуга = Услуга.Ссылка; Вторая.Тариф = 150; Вторая.Записать();
    Отбор = Новый Структура("Услуга",Услуга.Ссылка);
    До = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,14),Отбор);
    НаГранице = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,15),Отбор);
    Раньше = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,10,31),Отбор);
    Возврат Новый Структура("ДоВерно,ГраницаВерна,РаньшеНет,Услуга",До.Количество() = 1 И До[0].Тариф = 100,НаГранице.Количество() = 1 И НаГранице[0].Тариф = 150,Раньше.Количество() = 0,Услуга.Ссылка);
КонецФункции


Функция ОпытОстатковОбязательств() Экспорт
    Набор = НовыйНаборРегистров(30,10);
    Для Индекс = 0 По 1 Цикл
        Записи = РегистрыНакопления.Обязательства.СоздатьНаборЗаписей(); Записи.Отбор.Регистратор.Установить(?(Индекс = 0,Набор.Первая,Набор.Вторая));
        Движение = Записи.Добавить(); Движение.Период = Дата(2026,11,2,14,0,0); Движение.Клиент = Набор.Клиент;
        Движение.ВидДвижения = ?(Индекс = 0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
        Движение.Минуты = ?(Индекс = 0,30,10); Записи.Записать(Истина);
    КонецЦикла;
    Остаток = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Новый Структура("Клиент",Набор.Клиент));
    До = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,1),Новый Структура("Клиент",Набор.Клиент));
    Другой = Справочники.Клиенты.СоздатьЭлемент(); Другой.Наименование = "Учебный без движений"; Другой.Записать();
    ЧужойОстаток = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Новый Структура("Клиент",Другой.Ссылка));
    Возврат Новый Структура("ОстатокВерный,ДоНет,РазныеКлиенты,Клиент",Остаток.Количество() = 1 И Остаток[0].Минуты = 20,До.Количество() = 0,ЧужойОстаток.Количество() = 0,Набор.Клиент);
КонецФункции


Функция ОпытОборотовТрудозатрат() Экспорт
    Набор = НовыйНаборРегистров(30,45); Первая = Набор.Первая.ПолучитьОбъект(); Вторая = Набор.Вторая.ПолучитьОбъект();
    Первая.Записать(РежимЗаписиДокумента.Проведение); Вторая.Записать(РежимЗаписиДокумента.Проведение);
    Запрос = Новый Запрос("ВЫБРАТЬ Т.МинутыОборот КАК Минуты ИЗ РегистрНакопления.Трудозатраты.Обороты(&Начало,&Конец,,Клиент = &Клиент) КАК Т");
    Запрос.УстановитьПараметр("Начало",Дата(2026,11,2)); Запрос.УстановитьПараметр("Конец",Дата(2026,11,3)); Запрос.УстановитьПараметр("Клиент",Набор.Клиент);
    Итог = Запрос.Выполнить().Выгрузить();
    Сырые = Новый Запрос("ВЫБРАТЬ Т.Регистратор ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Клиент = &Клиент"); Сырые.УстановитьПараметр("Клиент",Набор.Клиент); Строки = Сырые.Выполнить().Выгрузить();
    Запрос.УстановитьПараметр("Начало",Дата(2026,10,1)); Запрос.УстановитьПараметр("Конец",Дата(2026,10,2)); Раньше = Запрос.Выполнить().Выгрузить();
    Возврат Новый Структура("ОборотВерный,ДваРегистратора,ПустойПериод,Клиент",Итог.Количество() = 1 И Итог[0].Минуты = 75,Строки.Количество() = 2,Раньше.Количество() = 0,Набор.Клиент);
КонецФункции


Функция ОпытУчебнойПроводки() Экспорт
    Набор = НовыйНаборРегистров(); Суффикс = Лев(Строка(Новый УникальныйИдентификатор),8);
    Дебет = ПланыСчетов.УчебныеСчета.СоздатьСчет(); Дебет.Код = "Д" + Суффикс; Дебет.Наименование = "Учебный дебет"; Дебет.Вид = ВидСчета.Активный; Дебет.Записать();
    Кредит = ПланыСчетов.УчебныеСчета.СоздатьСчет(); Кредит.Код = "К" + Суффикс; Кредит.Наименование = "Учебный кредит"; Кредит.Вид = ВидСчета.Пассивный; Кредит.Записать();
    Записи = РегистрыБухгалтерии.УчебныеПроводки.СоздатьНаборЗаписей(); Записи.Отбор.Регистратор.Установить(Набор.Первая);
    Проводка = Записи.Добавить(); Проводка.Период = Дата(2026,11,2,15,0,0); Проводка.СчетДт = Дебет.Ссылка; Проводка.СчетКт = Кредит.Ссылка; Проводка.Сумма = 100; Записи.Записать(Истина);
    Запрос = Новый Запрос("ВЫБРАТЬ П.СчетДт, П.СчетКт, П.Сумма ИЗ РегистрБухгалтерии.УчебныеПроводки КАК П ГДЕ П.Регистратор = &Документ"); Запрос.УстановитьПараметр("Документ",Набор.Первая); Таблица = Запрос.Выполнить().Выгрузить();
    ВернаСумма = Таблица.Количество() = 1 И Таблица[0].Сумма = 100;
    ВерныСчета = Таблица.Количество() = 1 И Таблица[0].СчетДт = Дебет.Ссылка И Таблица[0].СчетКт = Кредит.Ссылка И Дебет.Ссылка <> Кредит.Ссылка;
    Возврат Новый Структура("ВернаСумма,ВерныСчета,Регистратор",ВернаСумма,ВерныСчета,Набор.Первая);
КонецФункции


Функция ОпытПовторногоПроведения() Экспорт
    Набор = НовыйНаборРегистров(30,45); Первая = Набор.Первая.ПолучитьОбъект(); Вторая = Набор.Вторая.ПолучитьОбъект();
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Т.Минуты),0) КАК Минуты ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Клиент = &Клиент"); Запрос.УстановитьПараметр("Клиент",Набор.Клиент);
    Первая.Записать(РежимЗаписиДокумента.Проведение); Вторая.Записать(РежимЗаписиДокумента.Проведение); ПервыйИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Первая.Записать(РежимЗаписиДокумента.Проведение); ПовторныйИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Первая.ДлительностьМинут = 45; Первая.Записать(РежимЗаписиДокумента.Проведение); НовыйИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Первая.Записать(РежимЗаписиДокумента.ОтменаПроведения); ЧужойИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Вторая.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПустойИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Возврат Новый Структура("НачалоВерно,ПовторНеУдвоил,ЗаменаВерна,ДругойСохранен,СвоиОтменены,Клиент",ПервыйИтог = 75,ПовторныйИтог = 75,НовыйИтог = 90,ЧужойИтог = 45,ПустойИтог = 0,Набор.Клиент);
КонецФункции


Функция ОпытПараметров() Экспорт
    Д = НовыйНаборРегистров();
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка, З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент И З.Дата >= &Начало И З.Дата < &Конец");
    Запрос.УстановитьПараметр("Клиент", Д.Клиент);
    Запрос.УстановитьПараметр("Начало", Дата(2026,11,2,12,0,0));
    Запрос.УстановитьПараметр("Конец", Дата(2026,11,2,13,0,0));
    Таблица = Запрос.Выполнить().Выгрузить();
    НаГранице = Таблица.Количество() = 1 И Таблица[0].Ссылка = Д.Первая И Таблица.Итог("Минуты") = 30;
    Запрос.УстановитьПараметр("Клиент", Справочники.Клиенты.ПустаяСсылка());
    Возврат Новый Структура("ГраницаВерна,ПустойКлюч", НаГранице, Запрос.Выполнить().Пустой());
КонецФункции


Функция ОпытСоединения() Экспорт
    Д = НовыйНаборРегистров();
    Пустой = Справочники.Клиенты.СоздатьЭлемент(); Пустой.Наименование = Д.Клиент.Наименование; Пустой.Записать();
    Ключи = Новый Массив; Ключи.Добавить(Д.Клиент); Ключи.Добавить(Пустой.Ссылка);
    Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Клиент, ЕСТЬNULL(СУММА(З.ДлительностьМинут),0) КАК Минуты ИЗ Справочник.Клиенты КАК К ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаУслуги КАК З ПО З.Клиент = К.Ссылка ГДЕ К.Ссылка В (&Ключи) СГРУППИРОВАТЬ ПО К.Ссылка");
    Запрос.УстановитьПараметр("Ключи", Ключи); Таблица = Запрос.Выполнить().Выгрузить();
    Первая = Таблица.Найти(Д.Клиент,"Клиент"); Вторая = Таблица.Найти(Пустой.Ссылка,"Клиент");
    Возврат Новый Структура("ДваКлюча,ИтогВерный,ПустойСохранен",Таблица.Количество() = 2, Первая <> Неопределено И Первая.Минуты = 75, Вторая <> Неопределено И Вторая.Минуты = 0);
КонецФункции


Функция ОпытВременнойТаблицы() Экспорт
    Д = НовыйНаборРегистров(); Менеджер = Новый МенеджерВременныхТаблиц;
    Запрос = Новый Запрос; Запрос.МенеджерВременныхТаблиц = Менеджер;
    Запрос.Текст = "ВЫБРАТЬ З.Ссылка, З.ДлительностьМинут КАК Минуты ПОМЕСТИТЬ СвоиЗаявки ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент";
    Запрос.УстановитьПараметр("Клиент", Д.Клиент); Запрос.Выполнить();
    Итоги = Новый Запрос("ВЫБРАТЬ СУММА(Т.Минуты) КАК Минуты, КОЛИЧЕСТВО(*) КАК ЧислоСтрок ИЗ СвоиЗаявки КАК Т");
    Итоги.МенеджерВременныхТаблиц = Менеджер; Таблица = Итоги.Выполнить().Выгрузить();
    Верно = Таблица[0].Минуты = 75 И Таблица[0].ЧислоСтрок = 2;
    Менеджер.Закрыть();
    Отказ = Ложь; Попытка Итоги.Выполнить(); Исключение Отказ = Истина; КонецПопытки;
    Возврат Новый Структура("НаборВерный,КонтекстЗакрыт",Верно,Отказ);
КонецФункции


Функция ОпытЧислаЗапросов() Экспорт
    Д = НовыйНаборРегистров(); Ссылки = Новый Массив; Ссылки.Добавить(Д.Первая); Ссылки.Добавить(Д.Вторая);
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах(); Сумма = 0; ОтдельныхВызовов = 0;
    Для Каждого Ссылка Из Ссылки Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка = &Ключ");
        Запрос.УстановитьПараметр("Ключ", Ссылка); Сумма = Сумма + Запрос.Выполнить().Выгрузить()[0].Минуты; ОтдельныхВызовов = ОтдельныхВызовов + 1;
    КонецЦикла;
    ОтдельноМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пакет = Новый Запрос("ВЫБРАТЬ З.Ссылка, З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка В (&Ключи)");
    Пакет.УстановитьПараметр("Ключи",Ссылки); Таблица = Пакет.Выполнить().Выгрузить();
    ПакетомМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Возврат Новый Структура("Эквивалентно,ВызовыУменьшены,ОтдельноМс,ПакетомМс",Сумма = 75 И Таблица.Количество() = 2 И Таблица.Итог("Минуты") = Сумма, ОтдельныхВызовов = 2, ОтдельноМс, ПакетомМс);
КонецФункции


Функция ОпытКомпоновки() Экспорт
    Д = НовыйНаборРегистров();
    Схема = Новый СхемаКомпоновкиДанных;
    Источник = Схема.ИсточникиДанных.Добавить(); Источник.Имя = "Основной"; Источник.ТипИсточникаДанных = "Local";
    Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных")); Набор.Имя = "Заявки"; Набор.ИсточникДанных = "Основной";
    Набор.Запрос = "ВЫБРАТЬ З.Ссылка КАК Ссылка, З.Клиент КАК Клиент, З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З";
    Для Каждого Имя Из СтрРазделить("Ссылка,Клиент,Минуты",",") Цикл
        Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных")); Поле.ПутьКДанным = Имя; Поле.Поле = Имя; Поле.Заголовок = Имя;
    КонецЦикла;
    Настройки = Новый НастройкиКомпоновкиДанных;
    Для Каждого Имя Из СтрРазделить("Ссылка,Минуты",",") Цикл
        Выбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); Выбор.Поле = Новый ПолеКомпоновкиДанных(Имя); Выбор.Использование = Истина;
    КонецЦикла;
    Группа = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных")); Группа.Использование = Истина; Группа.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
    Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Клиент"); Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; Отбор.ПравоеЗначение = Д.Клиент; Отбор.Использование = Истина;
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет);
    Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; Таблица = Вывод.Вывести(Процессор);
    ПолныйВерный = Таблица.Количество() = 2 И Таблица.Итог("Минуты") = 75;
    ОтборМинут = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); ОтборМинут.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Минуты"); ОтборМинут.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше; ОтборМинут.ПравоеЗначение = 30; ОтборМинут.Использование = Истина;
    Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); Процессор.Инициализировать(Макет); Таблица = Вывод.Вывести(Процессор);
    Возврат Новый Структура("ПолныйВерный,ОтборВерный",ПолныйВерный,Таблица.Количество() = 1 И Таблица[0].Ссылка = Д.Вторая И Таблица.Итог("Минуты") = 45);
КонецФункции


Функция ОпытЛокальнойБлокировки() Экспорт
    Д = НовыйНаборРегистров(); НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("Документ.ЗаявкаУслуги"); Элемент.УстановитьЗначение("Ссылка",Д.Первая); Блокировка.Заблокировать();
        Объект = Д.Первая.ПолучитьОбъект(); Объект.ДлительностьМинут = 99; Объект.Записать(); ОтменитьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("ОткатСохранил,ДругойСохранен",Д.Первая.ДлительностьМинут = 30,Д.Вторая.ДлительностьМинут = 45);
КонецФункции

Функция ПроверитьПакет(Текст) Экспорт
    Если ТипЗнч(Текст) <> Тип("Строка") Тогда ВызватьИсключение "Нужен текст"; КонецЕсли;
    Если СтрДлина(Текст) > 4096 Тогда ВызватьИсключение "Пакет слишком большой"; КонецЕсли;
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "Нужен объект"; КонецЕсли;
    Если Данные.Количество() <> 3 Тогда ВызватьИсключение "Ровно три поля"; КонецЕсли;
    Версия = Неопределено; Минуты = Неопределено; Метка = Неопределено;
    Если Не Данные.Свойство("schemaVersion",Версия) Или Не Данные.Свойство("minutes",Минуты) Или Не Данные.Свойство("text",Метка) Тогда ВызватьИсключение "Неверные поля"; КонецЕсли;
    Если ТипЗнч(Версия) <> Тип("Число") Или ТипЗнч(Минуты) <> Тип("Число") Или ТипЗнч(Метка) <> Тип("Строка") Тогда ВызватьИсключение "Неверные типы"; КонецЕсли;
    Если Версия <> 1 Или Минуты < 0 Или Минуты > 1440 Или Цел(Минуты) <> Минуты Или СтрДлина(Метка) > 80 Тогда ВызватьИсключение "Неверные значения"; КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ОпытJSONXML() Экспорт
    Данные = ПроверитьПакет("{""schemaVersion"":1,""minutes"":30,""text"":""Учебный & <текст>""}");
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись,Данные); Текст = Запись.Закрыть(); Повтор = ПроверитьПакет(Текст);
    Отказ = Ложь; Попытка ПроверитьПакет("{""schemaVersion"":1,""minutes"":""30"",""text"":""Учебный""}"); Исключение Отказ = Истина; КонецПопытки;
    Запись = Новый ЗаписьXML; Запись.УстановитьСтроку(); Запись.ЗаписатьНачалоЭлемента("request"); Запись.ЗаписатьАтрибут("minutes",Строка(Данные.minutes)); Запись.ЗаписатьТекст(Данные.text); Запись.ЗаписатьКонецЭлемента(); XML = Запись.Закрыть();
    Чтение = Новый ЧтениеXML; Чтение.УстановитьСтроку(XML); Чтение.Прочитать();
    XMLВерный = Чтение.Имя = "request" И Чтение.ПолучитьАтрибут("minutes") = "30"; Чтение.Закрыть();
    Возврат Новый Структура("JSONВерный,ТипОтклонен,XMLВерный",Повтор.minutes = 30 И Повтор.text = Данные.text,Отказ,XMLВерный);
КонецФункции

Функция ОдинПакет(Знач Позиция,Размер,Всего) Экспорт
    Если ТипЗнч(Позиция) <> Тип("Число") Или ТипЗнч(Размер) <> Тип("Число") Или ТипЗнч(Всего) <> Тип("Число") Тогда ВызватьИсключение "Нужны числа"; КонецЕсли;
    Если Позиция < 0 Или Размер < 1 Или Всего < Позиция Или Цел(Позиция) <> Позиция Или Цел(Размер) <> Размер Или Цел(Всего) <> Всего Тогда ВызватьИсключение "Неверная граница пакета"; КонецЕсли;
    Возврат Мин(Позиция + Размер,Всего);
КонецФункции

Функция ОпытРучногоОбработчика() Экспорт
    Первая = ОдинПакет(0,5,12); Вторая = ОдинПакет(Первая,5,12); Третья = ОдинПакет(Вторая,5,12); ПовторКонца = ОдинПакет(Третья,5,12);
    Отказ = Ложь; Попытка ОдинПакет(0,0,12); Исключение Отказ = Истина; КонецПопытки;
    Возврат Новый Структура("ГраницыВерны,НольОтклонен",Первая = 5 И Вторая = 10 И Третья = 12 И ПовторКонца = 12,Отказ);
КонецФункции


// Последовательный опыт. Два конкурирующих получателя и crash recovery отдельно не доказаны.
Функция ПринятьУчебнуюОперацию(Ключ,Минуты,Клиент,Услуга) Экспорт
    Если ТипЗнч(Ключ) <> Тип("Строка") Или ТипЗнч(Минуты) <> Тип("Число") Тогда ВызватьИсключение "Неверные типы"; КонецЕсли;
    Если СтрДлина(Ключ) <> 36 Или Минуты < 0 Или Минуты > 1440 Тогда ВызватьИсключение "Неверный договор"; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты,З.Клиент,З.Услуга ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Ключ");
        Запрос.УстановитьПараметр("Ключ",Ключ); Найдено = Запрос.Выполнить().Выгрузить();
        Если Найдено.Количество() > 0 Тогда
            Если Найдено.Количество() <> 1 Или Найдено[0].Минуты <> Минуты Или Найдено[0].Клиент <> Клиент Или Найдено[0].Услуга <> Услуга Тогда ВызватьИсключение "Конфликт ключа/содержимого"; КонецЕсли;
            Ссылка = Найдено[0].Ссылка;
        Иначе
            Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,12,0,0); Документ.Клиент = Клиент; Документ.Услуга = Услуга; Документ.Статус = Перечисления.СтатусыЗаявки.Новая; Документ.ДлительностьМинут = Минуты; Документ.Комментарий = Ключ; Документ.Записать(); Ссылка = Документ.Ссылка;
        КонецЕсли;
        ЗафиксироватьТранзакцию(); Возврат Ссылка;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ОпытПовторногоПриёма() Экспорт
    Д = НовыйНаборРегистров(); Ключ = Строка(Новый УникальныйИдентификатор);
    Первая = ПринятьУчебнуюОперацию(Ключ,30,Д.Клиент,Д.Услуга); Повтор = ПринятьУчебнуюОперацию(Ключ,30,Д.Клиент,Д.Услуга);
    Конфликт = Ложь; Попытка ПринятьУчебнуюОперацию(Ключ,31,Д.Клиент,Д.Услуга); Исключение Конфликт = Истина; КонецПопытки;
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Ключ"); Запрос.УстановитьПараметр("Ключ",Ключ);
    Возврат Новый Структура("ПовторТотЖе,КонфликтОтклонен,ОдинЭффект",Первая = Повтор,Конфликт,Запрос.Выполнить().Выгрузить().Количество() = 1 И Первая.ДлительностьМинут = 30);
КонецФункции

