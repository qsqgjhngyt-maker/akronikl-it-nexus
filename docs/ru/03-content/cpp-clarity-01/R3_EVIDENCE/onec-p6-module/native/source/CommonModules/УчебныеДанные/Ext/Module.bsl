Функция ОпытИсторииТарифа() Экспорт
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная история тарифа"; Услуга.Записать();
    Первая = РегистрыСведений.ТарифыУслуг.СоздатьМенеджерЗаписи(); Первая.Период = Дата(2026,11,1); Первая.Услуга = Услуга.Ссылка; Первая.Тариф = 100; Первая.Записать();
    Вторая = РегистрыСведений.ТарифыУслуг.СоздатьМенеджерЗаписи(); Вторая.Период = Дата(2026,11,15); Вторая.Услуга = Услуга.Ссылка; Вторая.Тариф = 150; Вторая.Записать();
    Отбор = Новый Структура("Услуга",Услуга.Ссылка);
    До = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,14),Отбор);
    НаГранице = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,15),Отбор);
    Раньше = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,10,31),Отбор);
    Возврат Новый Структура("ДоВерно,ГраницаВерна,РаньшеНет,Услуга",До.Количество() = 1 И До[0].Тариф = 100,НаГранице.Количество() = 1 И НаГранице[0].Тариф = 150,Раньше.Количество() = 0,Услуга.Ссылка);
КонецФункции

Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытОборотовТрудозатрат() Экспорт
    Набор = НовыйНаборРегистров(30,45); Первая = Набор.Первая.ПолучитьОбъект(); Вторая = Набор.Вторая.ПолучитьОбъект();
    Первая.Записать(РежимЗаписиДокумента.Проведение); Вторая.Записать(РежимЗаписиДокумента.Проведение);
    Запрос = Новый Запрос("ВЫБРАТЬ Т.МинутыОборот КАК Минуты ИЗ РегистрНакопления.Трудозатраты.Обороты(&Начало,&Конец,,Клиент = &Клиент) КАК Т");
    Запрос.УстановитьПараметр("Начало",Дата(2026,11,2)); Запрос.УстановитьПараметр("Конец",Дата(2026,11,3)); Запрос.УстановитьПараметр("Клиент",Набор.Клиент);
    Итог = Запрос.Выполнить().Выгрузить();
    Сырые = Новый Запрос("ВЫБРАТЬ Т.Регистратор ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Клиент = &Клиент"); Сырые.УстановитьПараметр("Клиент",Набор.Клиент); Строки = Сырые.Выполнить().Выгрузить();
    Запрос.УстановитьПараметр("Начало",Дата(2026,10,1)); Запрос.УстановитьПараметр("Конец",Дата(2026,10,2)); Раньше = Запрос.Выполнить().Выгрузить();
    Возврат Новый Структура("ОборотВерный,ДваРегистратора,ПустойПериод,Клиент",Итог.Количество() = 1 И Итог[0].Минуты = 75,Строки.Количество() = 2,Раньше.Количество() = 0,Набор.Клиент);
КонецФункции

Функция ОпытОстатковОбязательств() Экспорт
    Набор = НовыйНаборРегистров(30,10);
    Для Индекс = 0 По 1 Цикл
        Записи = РегистрыНакопления.Обязательства.СоздатьНаборЗаписей(); Записи.Отбор.Регистратор.Установить(?(Индекс = 0,Набор.Первая,Набор.Вторая));
        Движение = Записи.Добавить(); Движение.Период = Дата(2026,11,2,14,0,0); Движение.Клиент = Набор.Клиент;
        Движение.ВидДвижения = ?(Индекс = 0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
        Движение.Минуты = ?(Индекс = 0,30,10); Записи.Записать(Истина);
    КонецЦикла;
    Остаток = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Новый Структура("Клиент",Набор.Клиент));
    До = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,1),Новый Структура("Клиент",Набор.Клиент));
    Другой = Справочники.Клиенты.СоздатьЭлемент(); Другой.Наименование = "Учебный без движений"; Другой.Записать();
    ЧужойОстаток = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Новый Структура("Клиент",Другой.Ссылка));
    Возврат Новый Структура("ОстатокВерный,ДоНет,РазныеКлиенты,Клиент",Остаток.Количество() = 1 И Остаток[0].Минуты = 20,До.Количество() = 0,ЧужойОстаток.Количество() = 0,Набор.Клиент);
КонецФункции

Функция ОпытПовторногоПроведения() Экспорт
    Набор = НовыйНаборРегистров(30,45); Первая = Набор.Первая.ПолучитьОбъект(); Вторая = Набор.Вторая.ПолучитьОбъект();
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Т.Минуты),0) КАК Минуты ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Клиент = &Клиент"); Запрос.УстановитьПараметр("Клиент",Набор.Клиент);
    Первая.Записать(РежимЗаписиДокумента.Проведение); Вторая.Записать(РежимЗаписиДокумента.Проведение); ПервыйИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Первая.Записать(РежимЗаписиДокумента.Проведение); ПовторныйИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Первая.ДлительностьМинут = 45; Первая.Записать(РежимЗаписиДокумента.Проведение); НовыйИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Первая.Записать(РежимЗаписиДокумента.ОтменаПроведения); ЧужойИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Вторая.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПустойИтог = Запрос.Выполнить().Выгрузить()[0].Минуты;
    Возврат Новый Структура("НачалоВерно,ПовторНеУдвоил,ЗаменаВерна,ДругойСохранен,СвоиОтменены,Клиент",ПервыйИтог = 75,ПовторныйИтог = 75,НовыйИтог = 90,ЧужойИтог = 45,ПустойИтог = 0,Набор.Клиент);
КонецФункции

Функция ОпытУчебнойПроводки() Экспорт
    Набор = НовыйНаборРегистров(); Суффикс = Лев(Строка(Новый УникальныйИдентификатор),8);
    Дебет = ПланыСчетов.УчебныеСчета.СоздатьСчет(); Дебет.Код = "Д" + Суффикс; Дебет.Наименование = "Учебный дебет"; Дебет.Вид = ВидСчета.Активный; Дебет.Записать();
    Кредит = ПланыСчетов.УчебныеСчета.СоздатьСчет(); Кредит.Код = "К" + Суффикс; Кредит.Наименование = "Учебный кредит"; Кредит.Вид = ВидСчета.Пассивный; Кредит.Записать();
    Записи = РегистрыБухгалтерии.УчебныеПроводки.СоздатьНаборЗаписей(); Записи.Отбор.Регистратор.Установить(Набор.Первая);
    Проводка = Записи.Добавить(); Проводка.Период = Дата(2026,11,2,15,0,0); Проводка.СчетДт = Дебет.Ссылка; Проводка.СчетКт = Кредит.Ссылка; Проводка.Сумма = 100; Записи.Записать(Истина);
    Запрос = Новый Запрос("ВЫБРАТЬ П.СчетДт, П.СчетКт, П.Сумма ИЗ РегистрБухгалтерии.УчебныеПроводки КАК П ГДЕ П.Регистратор = &Документ"); Запрос.УстановитьПараметр("Документ",Набор.Первая); Таблица = Запрос.Выполнить().Выгрузить();
    ВернаСумма = Таблица.Количество() = 1 И Таблица[0].Сумма = 100;
    ВерныСчета = Таблица.Количество() = 1 И Таблица[0].СчетДт = Дебет.Ссылка И Таблица[0].СчетКт = Кредит.Ссылка И Дебет.Ссылка <> Кредит.Ссылка;
    Возврат Новый Структура("ВернаСумма,ВерныСчета,Регистратор",ВернаСумма,ВерныСчета,Набор.Первая);
КонецФункции

