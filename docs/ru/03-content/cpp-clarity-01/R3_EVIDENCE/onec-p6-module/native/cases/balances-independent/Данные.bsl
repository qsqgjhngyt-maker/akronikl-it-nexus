// Общая подготовка P6; определение в серверном модуле добавляется один раз.
Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытЗаменыРасхода() Экспорт
    Набор = НовыйНаборРегистров(90,25);
    Для Индекс = 0 По 1 Цикл
        Записи = РегистрыНакопления.Обязательства.СоздатьНаборЗаписей();
        Записи.Отбор.Регистратор.Установить(?(Индекс = 0,Набор.Первая,Набор.Вторая));
        Строка = Записи.Добавить(); Строка.Период = Дата(2026,11,2,14,0,0); Строка.Клиент = Набор.Клиент;
        Строка.ВидДвижения = ?(Индекс = 0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
        Строка.Минуты = ?(Индекс = 0,90,25); Записи.Записать(Истина);
    КонецЦикла;
    Отбор = Новый Структура("Клиент",Набор.Клиент);
    До = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Отбор);
    Замена = РегистрыНакопления.Обязательства.СоздатьНаборЗаписей(); Замена.Отбор.Регистратор.Установить(Набор.Вторая);
    Строка = Замена.Добавить(); Строка.Период = Дата(2026,11,2,14,0,0); Строка.Клиент = Набор.Клиент;
    Строка.ВидДвижения = ВидДвиженияНакопления.Расход; Строка.Минуты = 15; Замена.Записать(Истина);
    После = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Отбор);
    Другой = Справочники.Клиенты.СоздатьЭлемент(); Другой.Наименование = "P6 без обязательств"; Другой.Записать();
    Чужой = РегистрыНакопления.Обязательства.Остатки(Дата(2026,11,3),Новый Структура("Клиент",Другой.Ссылка));
    Возврат Новый Структура("До,После,ДругойПустой",До[0].Минуты,После[0].Минуты,Чужой.Количество() = 0);
КонецФункции
