// Общая подготовка P6; определение в серверном модуле добавляется один раз.
Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытЧислаДвижений() Экспорт
    Набор = НовыйНаборРегистров(20,40); Первая = Набор.Первая.ПолучитьОбъект(); Вторая = Набор.Вторая.ПолучитьОбъект();
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Строк,ЕСТЬNULL(СУММА(Т.Минуты),0) КАК Минуты ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Клиент = &Клиент");
    Запрос.УстановитьПараметр("Клиент",Набор.Клиент);
    Первая.Записать(РежимЗаписиДокумента.Проведение); Вторая.Записать(РежимЗаписиДокумента.Проведение); До = Запрос.Выполнить().Выгрузить()[0];
    Первая.ДлительностьМинут = 50; Первая.Записать(РежимЗаписиДокумента.Проведение); После = Запрос.Выполнить().Выгрузить()[0];
    Вторая.Записать(РежимЗаписиДокумента.ОтменаПроведения); Один = Запрос.Выполнить().Выгрузить()[0];
    Первая.Записать(РежимЗаписиДокумента.ОтменаПроведения); Ноль = Запрос.Выполнить().Выгрузить()[0];
    Возврат Новый Структура("ДоСтрок,ДоМинут,ПослеСтрок,ПослеМинут,ОдинСтрок,ОдинМинут,НольСтрок",
        До.Строк,До.Минуты,После.Строк,После.Минуты,Один.Строк,Один.Минуты,Ноль.Строк);
КонецФункции
