// Общая подготовка P6; определение в серверном модуле добавляется один раз.
Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытНаправленияПроводки() Экспорт
    Набор = НовыйНаборРегистров(); Суффикс = Лев(Строка(Новый УникальныйИдентификатор),8);
    Дебет = ПланыСчетов.УчебныеСчета.СоздатьСчет(); Дебет.Код = "Д" + Суффикс; Дебет.Наименование = "P6 новый дебет"; Дебет.Вид = ВидСчета.Активный; Дебет.Записать();
    Кредит = ПланыСчетов.УчебныеСчета.СоздатьСчет(); Кредит.Код = "К" + Суффикс; Кредит.Наименование = "P6 новый кредит"; Кредит.Вид = ВидСчета.Пассивный; Кредит.Записать();
    Для Индекс = 0 По 1 Цикл
        Записи = РегистрыБухгалтерии.УчебныеПроводки.СоздатьНаборЗаписей();
        Записи.Отбор.Регистратор.Установить(?(Индекс = 0,Набор.Первая,Набор.Вторая));
        Проводка = Записи.Добавить(); Проводка.Период = Дата(2026,11,2,15,0,0); Проводка.Сумма = 250;
        Проводка.СчетДт = ?(Индекс = 0,Дебет.Ссылка,Кредит.Ссылка);
        Проводка.СчетКт = ?(Индекс = 0,Кредит.Ссылка,Дебет.Ссылка); Записи.Записать(Истина);
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ П.СчетДт,П.СчетКт,П.Сумма ИЗ РегистрБухгалтерии.УчебныеПроводки КАК П ГДЕ П.Регистратор = &Документ");
    Запрос.УстановитьПараметр("Документ",Набор.Первая); Верная = Запрос.Выполнить().Выгрузить()[0];
    Запрос.УстановитьПараметр("Документ",Набор.Вторая); Обратная = Запрос.Выполнить().Выгрузить()[0];
    Возврат Новый Структура("Сумма,ВерноеНаправление,ОбратноеПодходит",Верная.Сумма,
        Верная.СчетДт = Дебет.Ссылка И Верная.СчетКт = Кредит.Ссылка,
        Обратная.СчетДт = Дебет.Ссылка И Обратная.СчетКт = Кредит.Ссылка);
КонецФункции
