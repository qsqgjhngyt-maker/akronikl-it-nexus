Функция ОпытСрезаДругойУслуги() Экспорт
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "P6 новая история"; Услуга.Записать();
    Первая = РегистрыСведений.ТарифыУслуг.СоздатьМенеджерЗаписи();
    Первая.Период = Дата(2026,11,1); Первая.Услуга = Услуга.Ссылка; Первая.Тариф = 600; Первая.Записать();
    Вторая = РегистрыСведений.ТарифыУслуг.СоздатьМенеджерЗаписи();
    Вторая.Период = Дата(2026,11,15); Вторая.Услуга = Услуга.Ссылка; Вторая.Тариф = 900; Вторая.Записать();
    Отбор = Новый Структура("Услуга",Услуга.Ссылка);
    До = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,14),Отбор);
    НаГранице = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,15),Отбор);
    Другая = Справочники.Услуги.СоздатьЭлемент(); Другая.Наименование = "P6 без истории"; Другая.Записать();
    Чужой = РегистрыСведений.ТарифыУслуг.СрезПоследних(Дата(2026,11,15),Новый Структура("Услуга",Другая.Ссылка));
    Возврат Новый Структура("До,НаГранице,ДругаяПустая",До[0].Тариф,НаГранице[0].Тариф,Чужой.Количество() = 0);
КонецФункции
