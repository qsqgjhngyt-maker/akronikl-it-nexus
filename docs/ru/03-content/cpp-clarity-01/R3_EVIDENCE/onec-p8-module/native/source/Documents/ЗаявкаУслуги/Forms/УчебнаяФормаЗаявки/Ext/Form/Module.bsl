// P8: модуль существующей управляемой УчебнаяФормаЗаявки.
// Добавьте реквизит формы ИтогОпыта: Строка(120), ВерсияЗапроса: Число(10,0).
&НаСервере
Функция СверитьБуфер() Экспорт
    ДокументОбъект = РеквизитФормыВЗначение("Объект");
    Сохранено = Объект.Ссылка.ПолучитьОбъект();
    Возврат Новый Структура("ВФорме,ВОбъекте,ВБазе",Объект.ДлительностьМинут,ДокументОбъект.ДлительностьМинут,Сохранено.ДлительностьМинут);
КонецФункции

&НаСервереБезКонтекста
Функция ЧасыНаСервере(Минуты) Экспорт
    Если ТипЗнч(Минуты) <> Тип("Число") Тогда ВызватьИсключение "Нужно число"; КонецЕсли;
    Если Минуты < 0 Или Минуты > 1440 Тогда ВызватьИсключение "Диапазон0..1440"; КонецЕсли;
    Возврат Минуты / 60;
КонецФункции

&НаКлиенте
Процедура ПроверитьЧасы(Команда) Экспорт
    ИтогОпыта = Строка(ЧасыНаСервере(Объект.ДлительностьМинут));
    Сообщить(ИтогОпыта);
КонецПроцедуры

&НаКлиенте
Процедура УчебноеПодтверждение(Команда) Экспорт
    ВерсияЗапроса = ВерсияЗапроса + 1;
    Снимок = Новый Структура("Версия,Минуты",ВерсияЗапроса,Объект.ДлительностьМинут);
    Оповещение = Новый ОписаниеОповещения("ПослеПодтверждения",ЭтотОбъект,Снимок);
    ПоказатьВопрос(Оповещение,"Проверить часы без записи документа?",РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтверждения(Ответ,Снимок) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда ИтогОпыта = "Отменено"; Возврат; КонецЕсли;
    Если Снимок.Версия <> ВерсияЗапроса Или Снимок.Минуты <> Объект.ДлительностьМинут Тогда
        ИтогОпыта = "Устаревшее намерение"; Возврат;
    КонецЕсли;
    ИтогОпыта = Строка(ЧасыНаСервере(Снимок.Минуты));
    Сообщить(ИтогОпыта);
КонецПроцедуры

// Новые самостоятельные решения P8; прежние методы выше сохраняются.
&НаСервереБезКонтекста
Функция ЧасыДвухРабот(ПервыеМинуты,ВторыеМинуты) Экспорт
    ЧасыНаСервере(ПервыеМинуты);
    ЧасыНаСервере(ВторыеМинуты);
    Возврат ЧасыНаСервере(ПервыеМинуты + ВторыеМинуты);
КонецФункции

&НаСервереБезКонтекста
Функция СтоимостьРаботы(Минуты,Тариф) Экспорт
    Если ТипЗнч(Тариф) <> Тип("Число") Тогда ВызватьИсключение "Нужен числовой тариф"; КонецЕсли;
    Если Тариф < 0 Тогда ВызватьИсключение "Тариф неотрицательный"; КонецЕсли;
    Возврат ЧасыНаСервере(Минуты) * Тариф;
КонецФункции

&НаКлиенте
Процедура НовоеПодтверждение(Команда) Экспорт
    ВерсияЗапроса = ВерсияЗапроса + 1;
    Снимок = Новый Структура("Версия,Минуты",ВерсияЗапроса,Объект.ДлительностьМинут);
    ИтогОпыта = "Ожидание";
    Оповещение = Новый ОписаниеОповещения("ПослеНовогоПодтверждения",ЭтотОбъект,Снимок);
    ПоказатьВопрос(Оповещение,"Посчитать часы один раз без записи?",РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеНовогоПодтверждения(Ответ,Снимок) Экспорт
    Если Снимок.Версия <> ВерсияЗапроса Или Снимок.Минуты <> Объект.ДлительностьМинут Тогда
        ИтогОпыта = "Устаревшее намерение"; Возврат;
    КонецЕсли;
    Если ОбработаннаяВерсия = Снимок.Версия Тогда ИтогОпыта = "Уже обработано"; Возврат; КонецЕсли;
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        ОбработаннаяВерсия = Снимок.Версия; ИтогОпыта = "Отменено"; Возврат;
    КонецЕсли;
    Часы = ЧасыНаСервере(Снимок.Минуты);
    ОбработаннаяВерсия = Снимок.Версия;
    РасчетовОпыта = РасчетовОпыта + 1;
    ИтогОпыта = Строка(Часы);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьБуфер(Команда) Экспорт
    Р = СверитьБуфер();
    Сообщить("В форме: " + Строка(Р.ВФорме));
    Сообщить("В объекте: " + Строка(Р.ВОбъекте));
    Сообщить("В базе: " + Строка(Р.ВБазе));
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСервер(Команда) Экспорт
    Сообщить("Часы: " + Строка(ЧасыНаСервере(90)));
    Отказ = Ложь;
    Попытка ЧасыНаСервере(1441); Исключение Отказ = Истина; КонецПопытки;
    Сообщить("Диапазон отклонён: " + Строка(Отказ));
    Отказ = Ложь;
    Попытка ЧасыНаСервере("90"); Исключение Отказ = Истина; КонецПопытки;
    Сообщить("Строка отклонена: " + Строка(Отказ));
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДирективы(Команда) Экспорт
    Объект.ДлительностьМинут = 77;
    Сообщить("В буфере: " + Строка(СверитьБуфер().ВФорме));
    Сообщить("Явные 90 минут: " + Строка(ЧасыНаСервере(90)));
    Сообщить("В базе: " + Строка(СверитьБуфер().ВБазе));
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПродолжение(Команда) Экспорт
    ВерсияЗапроса = 2;
    Объект.ДлительностьМинут = 90;
    ПослеПодтверждения(КодВозвратаДиалога.Нет,Новый Структура("Версия,Минуты",2,90));
    Сообщить("Нет: " + ИтогОпыта);
    ПослеПодтверждения(КодВозвратаДиалога.Да,Новый Структура("Версия,Минуты",1,90));
    Сообщить("Старое Да: " + ИтогОпыта);
    ПослеПодтверждения(КодВозвратаДиалога.Да,Новый Структура("Версия,Минуты",2,90));
    Сообщить("Текущее Да: " + ИтогОпыта);
    Сообщить("В базе: " + Строка(СверитьБуфер().ВБазе));
КонецПроцедуры
