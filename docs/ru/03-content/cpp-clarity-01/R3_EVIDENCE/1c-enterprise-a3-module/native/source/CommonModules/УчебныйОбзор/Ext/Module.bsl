Функция НовыйКлиент(Код, Имя)
    О = Справочники.Клиенты.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция НоваяУслуга(Код, Имя)
    О = Справочники.Услуги.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.ТарифЗаЧас = 0; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция Заявка(Номер, Клиент, Услуга, Минуты, Комментарий)
    О = Документы.ЗаявкаУслуги.СоздатьДокумент(); О.Номер = Номер; О.Дата = Дата(2026,11,8,12,0,0); О.Клиент = Клиент; О.Услуга = Услуга; О.ДлительностьМинут = Минуты; О.Статус = Перечисления.СтатусыЗаявки.Новая; О.Комментарий = Комментарий; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция СколькоЗаявок()
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги");
    Возврат Запрос.Выполнить().Выгрузить().Количество();
КонецФункции
Функция СнимокЗаявки(Ссылка)
    О = Ссылка.ПолучитьОбъект(); Возврат Строка(Ссылка.УникальныйИдентификатор()) + "|" + О.Номер + "|" + Строка(О.Клиент.УникальныйИдентификатор()) + "|" + Строка(О.Услуга.УникальныйИдентификатор()) + "|" + Строка(О.Дата) + "|" + Строка(О.ДлительностьМинут) + "|" + Строка(О.Статус) + "|" + О.Комментарий;
КонецФункции

Функция Снимки()
    Результат = Новый Массив; Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги УПОРЯДОЧИТЬ ПО Номер");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл Результат.Добавить(СнимокЗаявки(Р.Ссылка)); КонецЦикла;
    Возврат Результат;
КонецФункции
Функция Числа(Порог = Неопределено, Убывание = Ложь)
    Текст = "ВЫБРАТЬ ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги";
    Если Порог <> Неопределено Тогда Текст = Текст + " ГДЕ ДлительностьМинут >= &Порог"; КонецЕсли;
    Текст = Текст + " УПОРЯДОЧИТЬ ПО ДлительностьМинут" + ?(Убывание," УБЫВ","") + ", Номер";
    Запрос = Новый Запрос(Текст); Если Порог <> Неопределено Тогда Запрос.УстановитьПараметр("Порог",Порог); КонецЕсли;
    Массив = Новый Массив; Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл Массив.Добавить(Р.Минуты); КонецЦикла; Возврат Массив;
КонецФункции
Процедура ОписатьСтрокиСКД(Строки, Итог, Уровень = 0)
    Для Каждого Р Из Строки Цикл
        Клиент = ""; Если ЗначениеЗаполнено(Р.Клиент) Тогда Клиент = Строка(Р.Клиент.УникальныйИдентификатор()); КонецЕсли;
        Итог.Добавить(Новый Структура("level,customer,count,minutes",Уровень,Клиент,Р.Количество,Р.Минуты));
        Если ТипЗнч(Р) = Тип("СтрокаДереваЗначений") Тогда ОписатьСтрокиСКД(Р.Строки,Итог,Уровень+1); КонецЕсли;
    КонецЦикла;
КонецПроцедуры
Функция ГотовыйОтчет(Клиент = Неопределено)
    ОбъектОтчета = Отчеты.ЗаявкиПоКлиентам.Создать(); Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"); Настройки = Схема.НастройкиПоУмолчанию;
    Если Клиент <> Неопределено Тогда Элемент = Настройки.Отбор.Элементы[0]; Элемент.Использование = Истина; Элемент.ПравоеЗначение = Клиент; КонецЕсли;
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных; Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет); Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; Коллекция = Вывод.Вывести(Процессор);
    Строки = ?(ТипЗнч(Коллекция) = Тип("ДеревоЗначений"),Коллекция.Строки,Коллекция); Итог = Новый Массив; ОписатьСтрокиСКД(Строки,Итог); Возврат Итог;
КонецФункции
Функция Набор(Самостоятельный = Ложь) Экспорт
    Если СколькоЗаявок() <> 0 Тогда ВызватьИсключение "Для контрольного набора нужна отдельная новая база"; КонецЕсли;
    Первый = НовыйКлиент("A3N1",?(Самостоятельный,"Учебный Восток","Учебный Север")); Второй = НовыйКлиент("A3S1",?(Самостоятельный,"Учебный Запад","Учебный Юг")); Услуга = НоваяУслуга("A3U1","Учебная диагностика");
    Минуты = Новый Массив; Минуты.Добавить(?(Самостоятельный,20,30)); Минуты.Добавить(?(Самостоятельный,55,45)); Минуты.Добавить(?(Самостоятельный,40,30)); Минуты.Добавить(?(Самостоятельный,45,15));
    Для Индекс=0 По 3 Цикл Заявка("A3000000"+Строка(Индекс+1),?(Индекс=3,Второй,Первый),Услуга,Минуты[Индекс],"Учебный контроль "+Строка(Индекс+1)); КонецЦикла;
    До = Снимки(); Все = ГотовыйОтчет(); Отбор = ГотовыйОтчет(Первый); Снова = ГотовыйОтчет(); После = Снимки(); Неизменны = Истина;
    Для Индекс=0 По До.Количество()-1 Цикл Если До[Индекс] <> После[Индекс] Тогда Неизменны = Ложь; КонецЕсли; КонецЦикла;
    Возврат Новый Структура("count,snapshots,firstCustomer,secondCustomer,ascending,descending,filtered,reportAll,reportFirst,reportAfterClear,recordsUnchanged",СколькоЗаявок(),До,Строка(Первый.УникальныйИдентификатор()),Строка(Второй.УникальныйИдентификатор()),Числа(),Числа(Неопределено,Истина),Числа(?(Самостоятельный,40,45)),Все,Отбор,Снова,Неизменны);
КонецФункции
Функция ПроверитьВвод() Экспорт
    Клиент = НовыйКлиент("A3V1","Учебная проверка ввода"); Услуга = НоваяУслуга("A3U1","Учебная диагностика"); О = Документы.ЗаявкаУслуги.СоздатьДокумент(); О.Номер = "A3V000001"; О.Дата = Дата(2026,11,8,12,0,0); О.Услуга = Услуга; О.ДлительностьМинут = 30; О.Статус = Перечисления.СтатусыЗаявки.Новая;
    ПустойКлиентОтказ = Ложь; Попытка О.Записать(); Исключение ПустойКлиентОтказ = Истина; КонецПопытки; ПослеОтказа = СколькоЗаявок(); О.Клиент = Клиент; О.Записать(); Прочитано30 = О.Ссылка.ДлительностьМинут;
    Новая = Документы.ЗаявкаУслуги.СоздатьДокумент(); Новая.Номер="A3V000002"; Новая.Дата=О.Дата; Новая.Клиент=Клиент; Новая.Услуга=Услуга; Новая.Статус=О.Статус; Новая.ДлительностьМинут=1441;
    ВерхОтказ=Ложь; Попытка Новая.Записать(); Исключение ВерхОтказ=Истина; КонецПопытки; ПослеВерхОтказа=СколькоЗаявок(); Новая.ДлительностьМинут=25; Новая.Записать(); Прочитано25=Новая.Ссылка.ДлительностьМинут;
    Ноль = Заявка("A3V000003",Клиент,Услуга,0,"Разрешённый ноль"); Верх = Заявка("A3V000004",Клиент,Услуга,1440,"Разрешённая граница");
    МинусОтказ=Ложь; Попытка Заявка("A3V000005",Клиент,Услуга,-1,"Отклоняемое значение"); Исключение МинусОтказ=Истина; КонецПопытки;
    Возврат Новый Структура("missingCustomerRefused,countAfterMissing,corrected30,tooLargeRefused,countAfterTooLarge,corrected25,zeroRead,upperRead,negativeRefused,count",ПустойКлиентОтказ,ПослеОтказа,Прочитано30,ВерхОтказ,ПослеВерхОтказа,Прочитано25,Ноль.ДлительностьМинут,Верх.ДлительностьМинут,МинусОтказ,СколькоЗаявок());
КонецФункции
Функция ПовторноеЧтение() Экспорт
    Возврат Новый Структура("count,snapshots",СколькоЗаявок(),Снимки());
КонецФункции
