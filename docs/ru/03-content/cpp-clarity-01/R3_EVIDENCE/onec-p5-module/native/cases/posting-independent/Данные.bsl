Функция ОпытПерепроведения() Экспорт

    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный P5 — новая работа"; Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебная P5 — новая работа"; Услуга.Записать();
    Документ = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Документ.Дата = Дата(2026,11,8,12,0,0);
    Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка;
    Документ.Статус = Перечисления.СтатусыЗаявки.Новая;

    Документ.ДлительностьМинут = 45;
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    СсылкаДо = Документ.Ссылка;
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Строк, ЕСТЬNULL(СУММА(Т.Минуты),0) КАК Минуты ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Регистратор = &Заявка");
    Запрос.УстановитьПараметр("Заявка",СсылкаДо);
    Первое = Запрос.Выполнить().Выгрузить();
    ПервыйФакт = Первое[0].Строк = 1 И Первое[0].Минуты = 45;
    Документ.ДлительностьМинут = 75;
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    Второе = Запрос.Выполнить().Выгрузить();
    НеНакоплено = Второе[0].Строк = 1 И Второе[0].Минуты = 75;
    Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    Третье = Запрос.Выполнить().Выгрузить();
    ОтменаВерна = Третье[0].Строк = 0 И Не СсылкаДо.Пустая() И Не СсылкаДо.Проведен;
    Возврат Новый Структура("ПервыйФакт,НеНакоплено,ОтменаВерна",ПервыйФакт,НеНакоплено,ОтменаВерна);
КонецФункции
