Функция ОпытПарыВТранзакции() Экспорт
    Метка = "P5 пара " + Строка(Новый УникальныйИдентификатор);
    НачатьТранзакцию();
    Попытка
        Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = Метка;
        Клиент.Записать();
        Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = Метка;
        Услуга.ТарифЗаЧас = 600; Услуга.Записать();
        ВызватьИсключение "Учебный отказ после обеих записей";
    Исключение
        ОтменитьТранзакцию();
    КонецПопытки;
    НетКлиента = Справочники.Клиенты.НайтиПоНаименованию(Метка,Истина).Пустая();
    НетУслуги = Справочники.Услуги.НайтиПоНаименованию(Метка,Истина).Пустая();
    НачатьТранзакцию();
    Попытка
        Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = Метка + " принято";
        Клиент.Записать();
        Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = Метка + " принято";
        Услуга.ТарифЗаЧас = 900; Услуга.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ЕстьКлиент = Справочники.Клиенты.НайтиПоНаименованию(Метка + " принято",Истина) = Клиент.Ссылка;
    ЕстьУслуга = Справочники.Услуги.НайтиПоНаименованию(Метка + " принято",Истина) = Услуга.Ссылка
        И Услуга.Ссылка.ПолучитьОбъект().ТарифЗаЧас = 900;
    Возврат Новый Структура("НетКлиента,НетУслуги,ЕстьКлиент,ЕстьУслуга",НетКлиента,НетУслуги,ЕстьКлиент,ЕстьУслуга);
КонецФункции
