Функция ОпытЗакрытияЗаявки() Экспорт

    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный P5 — новая работа"; Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебная P5 — новая работа"; Услуга.Записать();
    Документ = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Документ.Дата = Дата(2026,11,8,12,0,0);
    Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка;
    Документ.Статус = Перечисления.СтатусыЗаявки.Новая;

    Документ.ДлительностьМинут = 45; Документ.Записать();
    СсылкаДо = Документ.Ссылка;
    Объект = СсылкаДо.ПолучитьОбъект();
    Объект.ДлительностьМинут = 75;
    Объект.Статус = Перечисления.СтатусыЗаявки.Закрыта;
    Объект.Записать();
    Факт = СсылкаДо.ПолучитьОбъект();
    Возврат Новый Структура("ТаЖеЗаявка,Минуты75,СтатусЗакрыта,БезПроведения",
        Факт.Ссылка = СсылкаДо И Факт.Клиент = Клиент.Ссылка И Факт.Услуга = Услуга.Ссылка,
        Факт.ДлительностьМинут = 75,
        Факт.Статус = Перечисления.СтатусыЗаявки.Закрыта, Не Факт.Проведен);
КонецФункции
