Функция ОпытЖизненногоЦикла() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный P5 — жизненный цикл"; Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебная P5 — диагностика"; Услуга.Записать();
    Документ = Документы.ЗаявкаУслуги.СоздатьДокумент();
    ДоЗаписиПусто = Документ.Ссылка.Пустая();
    Документ.Дата = Дата(2026,11,2,12,0,0);
    Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка;
    Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
    Документ.ДлительностьМинут = 30;
    Документ.Записать();
    Ссылка = Документ.Ссылка;
    ПослеЗаписи = Ссылка.ПолучитьОбъект();
    ПерваяЗаписьВерна = Не Ссылка.Пустая() И ПослеЗаписи.ДлительностьМинут = 30 И Не ПослеЗаписи.Проведен;
    ПослеЗаписи.ДлительностьМинут = 60;
    ПослеЗаписи.Статус = Перечисления.СтатусыЗаявки.ВРаботе;
    ПослеЗаписи.Записать();
    Перечитанный = Ссылка.ПолучитьОбъект();
    ОбновленаТаЖеЗаявка = Перечитанный.Ссылка = Ссылка И Перечитанный.ДлительностьМинут = 60
        И Перечитанный.Статус = Перечисления.СтатусыЗаявки.ВРаботе;
    Возврат Новый Структура("ДоЗаписиПусто,ПерваяЗаписьВерна,ОбновленаТаЖеЗаявка,Ссылка",ДоЗаписиПусто,ПерваяЗаписьВерна,ОбновленаТаЖеЗаявка,Ссылка);
КонецФункции

