Функция ОпытПроведенияИОтмены() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P5 — проведение"; Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P5 — проведение"; Услуга.Записать();
    Документ = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Документ.Дата = Дата(2026,11,2,14,0,0); Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка;
    Документ.Статус = Перечисления.СтатусыЗаявки.Новая; Документ.ДлительностьМинут = 30;
    Документ.Записать(); Ссылка = Документ.Ссылка;
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Строк, ЕСТЬNULL(СУММА(Т.Минуты),0) КАК Минуты ИЗ РегистрНакопления.Трудозатраты КАК Т ГДЕ Т.Регистратор = &Заявка");
    Запрос.УстановитьПараметр("Заявка",Ссылка);
    До = Запрос.Выполнить().Выгрузить();
    ОбычнаяЗаписьБезДвижений = До[0].Строк = 0 И Не Ссылка.Проведен;
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    После = Запрос.Выполнить().Выгрузить();
    ПроведениеПроверено = Ссылка.Проведен И После[0].Строк = 1 И После[0].Минуты = 30;
    Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ПослеОтмены = Запрос.Выполнить().Выгрузить();
    ОтменаПроверена = Не Ссылка.Проведен И ПослеОтмены[0].Строк = 0 И Не Ссылка.Пустая();
    Возврат Новый Структура("ОбычнаяЗаписьБезДвижений,ПроведениеПроверено,ОтменаПроверена,Ссылка",ОбычнаяЗаписьБезДвижений,ПроведениеПроверено,ОтменаПроверена,Ссылка);
КонецФункции

Функция ОпытГраницыТранзакции() Экспорт
    УникальноеИмя = "Учебный P5 TX " + Строка(Новый УникальныйИдентификатор);
    НачатьТранзакцию();
    Попытка
        Черновик = Справочники.Клиенты.СоздатьЭлемент(); Черновик.Наименование = УникальноеИмя;
        Черновик.Записать();
        ВызватьИсключение "Учебный отказ после записи внутри транзакции";
    Исключение
        ОтменитьТранзакцию();
    КонецПопытки;
    ПослеОтказаНетЗаписи = Справочники.Клиенты.НайтиПоНаименованию(УникальноеИмя,Истина).Пустая();
    НачатьТранзакцию();
    Попытка
        Принятый = Справочники.Клиенты.СоздатьЭлемент(); Принятый.Наименование = УникальноеИмя + " принято";
        Принятый.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ПослеФиксацииЕстьЗапись = Справочники.Клиенты.НайтиПоНаименованию(УникальноеИмя + " принято",Истина) = Принятый.Ссылка;
    Возврат Новый Структура("ПослеОтказаНетЗаписи,ПослеФиксацииЕстьЗапись,Ссылка",ПослеОтказаНетЗаписи,ПослеФиксацииЕстьЗапись,Принятый.Ссылка);
КонецФункции

