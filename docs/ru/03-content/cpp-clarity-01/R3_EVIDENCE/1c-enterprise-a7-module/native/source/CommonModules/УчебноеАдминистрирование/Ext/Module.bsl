Функция СнятьСостояниеA6() Экспорт
    Итог=УчебныйОбзор.СнятьСостояниеA5(); Описания=Новый Массив; Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Услуги УПОРЯДОЧИТЬ ПО Код");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл О=Р.Ссылка.ПолучитьОбъект(); Описания.Добавить(Новый Структура("id,code,name,rate,description",Строка(Р.Ссылка.УникальныйИдентификатор()),О.Код,О.Наименование,О.ТарифЗаЧас,О.УчебноеОписание)); КонецЦикла;
    Итог.Вставить("descriptions",Описания); Реквизит=Метаданные.Справочники.Услуги.Реквизиты.Найти("УчебноеОписание"); Итог.Вставить("descriptionMetadata",Новый Структура("name,length,fillChecking",Реквизит.Имя,Реквизит.Тип.КвалификаторыСтроки.Длина,Строка(Реквизит.ПроверкаЗаполнения))); Возврат Итог;
КонецФункции
Функция НовыеПрофилиA6() Экспорт
    До=СнятьСостояниеA6(); Имена=СтрРазделить("NexusA6Admin|NexusA6Reader","|");
    Для Каждого Имя Из Имена Цикл
      Если ПользователиИнформационнойБазы.НайтиПоИмени(Имя)<>Неопределено Тогда ВызватьИсключение "Нужна новая отдельная копия без этих учебных профилей"; КонецЕсли;
      Пользователь=ПользователиИнформационнойБазы.СоздатьПользователя(); Пользователь.Имя=Имя; Пользователь.АутентификацияСтандартная=Истина; Пользователь.АутентификацияОС=Ложь;
      Пользователь.Роли.Добавить(Метаданные.Роли.Найти(?(Имя="NexusA6Admin","УчебныйАдминистраторA6","УчебныйЧитательA6"))); Пользователь.Записать();
    КонецЦикла;
    Возврат Новый Структура("before,createdProfiles,passwordsUsed,osAuthenticationUsed",До,Имена,Ложь,Ложь);
КонецФункции
Функция ПроверитьЧтениеA6() Экспорт
    Ссылка=Документы.ЗаявкаУслуги.НайтиПоНомеру("A52000001"); До=Ссылка.ДлительностьМинут; Чтение=ПравоДоступа("Чтение",Метаданные.Документы.ЗаявкаУслуги); Изменение=ПравоДоступа("Изменение",Метаданные.Документы.ЗаявкаУслуги);
    О=Ссылка.ПолучитьОбъект(); О.ДлительностьМинут=41; Отказ=Ложь; Попытка О.Записать(); Исключение Отказ=Истина; КонецПопытки;
    Возврат Новый Структура("readAllowed,writeAllowed,number,before,attempted,refused,after",Чтение,Изменение,Ссылка.Номер,До,41,Отказ,Ссылка.ДлительностьМинут);
КонецФункции
Функция ИзменитьКопиюA6() Экспорт
    До=СнятьСостояниеA6(); Услуга=Справочники.Услуги.НайтиПоКоду("A5U2").ПолучитьОбъект(); ПустоеОписание=Услуга.УчебноеОписание=""; Услуга.УчебноеОписание="Самостоятельное описание A6"; Услуга.Записать(); ПослеОписания=СнятьСостояниеA6();
    Ссылка=Документы.ЗаявкаУслуги.НайтиПоНомеру("A52000001"); О=Ссылка.ПолучитьОбъект(); О.ДлительностьМинут=50; О.Записать(); ПослеИзменения=СнятьСостояниеA6();
    О=Ссылка.ПолучитьОбъект(); О.ДлительностьМинут=1441; Отказ=Ложь; Попытка О.Записать(); Исключение Отказ=Истина; КонецПопытки; ПослеОтказа=Ссылка.ДлительностьМинут;
    О.ДлительностьМинут=50; О.Записать(); После=СнятьСостояниеA6();
    Возврат Новый Структура("before,descriptionInitiallyEmpty,afterDescription,afterMinutes,businessRefused,afterBusinessRefusal,corrected50Read,after",До,ПустоеОписание,ПослеОписания,ПослеИзменения,Отказ,ПослеОтказа,Ссылка.ДлительностьМинут,После);
КонецФункции
