Функция НовыйКлиент(Код, Имя)
    О = Справочники.Клиенты.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция НоваяУслуга(Код, Имя)
    О = Справочники.Услуги.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.ТарифЗаЧас = 0; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция Заявка(Номер, Клиент, Услуга, Минуты, Комментарий)
    О = Документы.ЗаявкаУслуги.СоздатьДокумент(); О.Номер = Номер; О.Дата = Дата(2026,11,8,12,0,0); О.Клиент = Клиент; О.Услуга = Услуга; О.ДлительностьМинут = Минуты; О.Статус = Перечисления.СтатусыЗаявки.Новая; О.Комментарий = Комментарий; О.Записать(); Возврат О.Ссылка;
КонецФункции
Процедура ОписатьСтрокиСКД(Строки, Итог, Уровень = 0)
    Для Каждого Р Из Строки Цикл
        Клиент = ""; Если ЗначениеЗаполнено(Р.Клиент) Тогда Клиент = Строка(Р.Клиент.УникальныйИдентификатор()); КонецЕсли;
        ПустойИтог=ТипЗнч(Р.Количество)=Тип("Null"); Итог.Добавить(Новый Структура("level,customer,count,minutes,nativeNullTotal",Уровень,Клиент,?(ПустойИтог,0,Р.Количество),?(ТипЗнч(Р.Минуты)=Тип("Null"),0,Р.Минуты),ПустойИтог));
        Если ТипЗнч(Р) = Тип("СтрокаДереваЗначений") Тогда ОписатьСтрокиСКД(Р.Строки,Итог,Уровень+1); КонецЕсли;
    КонецЦикла;
КонецПроцедуры
Функция ГотовыйОтчет(Клиент = Неопределено)
    ОбъектОтчета = Отчеты.ЗаявкиПоКлиентам.Создать(); Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"); Настройки = Схема.НастройкиПоУмолчанию;
    Если Клиент <> Неопределено Тогда Элемент = Настройки.Отбор.Элементы[0]; Элемент.Использование = Истина; Элемент.ПравоеЗначение = Клиент; КонецЕсли;
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных; Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет); Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; Коллекция = Вывод.Вывести(Процессор);
    Строки = ?(ТипЗнч(Коллекция) = Тип("ДеревоЗначений"),Коллекция.Строки,Коллекция); Итог = Новый Массив; ОписатьСтрокиСКД(Строки,Итог); Возврат Итог;
КонецФункции



Функция СнятьСостояниеA7() Экспорт
 Возврат УчебноеАдминистрирование.СнятьСостояниеA6();
КонецФункции
Функция ПроверитьОтборA7() Экспорт
 До=СнятьСостояниеA7(); Альфа=Справочники.Клиенты.НайтиПоКоду("A7A1"); Бета=Справочники.Клиенты.НайтиПоКоду("A7B1"); Пустая=Справочники.Клиенты.НайтиПоКоду("A7A2"); Свой=Справочники.Клиенты.НайтиПоКоду("A5C1"); Север=Справочники.Клиенты.НайтиПоКоду("A3N1");
 Итог=Новый Структура("before,all,alpha,beta,emptyTwin,own,north,returnOwn,clear,after",До,ГотовыйОтчет(),ГотовыйОтчет(Альфа),ГотовыйОтчет(Бета),ГотовыйОтчет(Пустая),ГотовыйОтчет(Свой),ГотовыйОтчет(Север),ГотовыйОтчет(Свой),ГотовыйОтчет(),СнятьСостояниеA7()); Возврат Итог;
КонецФункции
Функция ПодготовитьA7() Экспорт
 До=СнятьСостояниеA7(); Если До.count<>9 Тогда ВызватьИсключение "Нужна новая копия A6: девять заявок"; КонецЕсли;
 Альфа=НовыйКлиент("A7A1","Учебный A7 — Альфа"); Бета=НовыйКлиент("A7B1","Учебный A7 — Бета"); Пустая=НовыйКлиент("A7A2","Учебный A7 — Альфа"); Услуга=НоваяУслуга("A7U1","Учебная услуга A7");
 Заявка("A71000001",Альфа,Услуга,30,"Контроль A7"); Заявка("A71000002",Альфа,Услуга,45,"Контроль A7"); Заявка("A71000003",Бета,Услуга,15,"Контроль A7");
 Возврат Новый Структура("before,filters",До,ПроверитьОтборA7());
КонецФункции
Функция ИзменитьДанныеA7() Экспорт
 До=СнятьСостояниеA7(); Если До.count<>12 Тогда ВызватьИсключение "Нужны двенадцать заявок новой копии"; КонецЕсли;
 О=Документы.ЗаявкаУслуги.НайтиПоНомеру("A71000001").ПолучитьОбъект(); Если О.ДлительностьМинут<>30 Тогда ВызватьИсключение "Контроль уже изменён"; КонецЕсли; О.ДлительностьМинут=35; О.Записать(); ПослеКонтроля=ПроверитьОтборA7();
 О=Документы.ЗаявкаУслуги.НайтиПоНомеру("A52000002").ПолучитьОбъект(); Если О.ДлительностьМинут<>25 Тогда ВызватьИсключение "Самостоятельная заявка уже изменена"; КонецЕсли; О.ДлительностьМинут=30; О.Записать();
 Возврат Новый Структура("before,afterMain,afterOwn",До,ПослеКонтроля,ПроверитьОтборA7());
КонецФункции
