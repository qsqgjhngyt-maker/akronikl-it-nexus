Функция НовыйКлиент(Код, Имя)
    О = Справочники.Клиенты.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция НоваяУслуга(Код, Имя)
    О = Справочники.Услуги.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.ТарифЗаЧас = 0; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция Заявка(Номер, Клиент, Услуга, Минуты, Комментарий)
    О = Документы.ЗаявкаУслуги.СоздатьДокумент(); О.Номер = Номер; О.Дата = Дата(2026,11,8,12,0,0); О.Клиент = Клиент; О.Услуга = Услуга; О.ДлительностьМинут = Минуты; О.Статус = Перечисления.СтатусыЗаявки.Новая; О.Комментарий = Комментарий; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция СколькоЗаявок()
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги");
    Возврат Запрос.Выполнить().Выгрузить().Количество();
КонецФункции
Функция СнимокЗаявки(Ссылка)
    О = Ссылка.ПолучитьОбъект(); Возврат Строка(Ссылка.УникальныйИдентификатор()) + "|" + О.Номер + "|" + Строка(О.Клиент.УникальныйИдентификатор()) + "|" + Строка(О.Услуга.УникальныйИдентификатор()) + "|" + Строка(О.Дата) + "|" + Строка(О.ДлительностьМинут) + "|" + Строка(О.Статус) + "|" + О.Комментарий;
КонецФункции

Функция Снимки()
    Результат = Новый Массив; Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги УПОРЯДОЧИТЬ ПО Номер");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл Результат.Добавить(СнимокЗаявки(Р.Ссылка)); КонецЦикла;
    Возврат Результат;
КонецФункции
Функция Числа(Порог = Неопределено, Убывание = Ложь)
    Текст = "ВЫБРАТЬ ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги";
    Если Порог <> Неопределено Тогда Текст = Текст + " ГДЕ ДлительностьМинут >= &Порог"; КонецЕсли;
    Текст = Текст + " УПОРЯДОЧИТЬ ПО ДлительностьМинут" + ?(Убывание," УБЫВ","") + ", Номер";
    Запрос = Новый Запрос(Текст); Если Порог <> Неопределено Тогда Запрос.УстановитьПараметр("Порог",Порог); КонецЕсли;
    Массив = Новый Массив; Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл Массив.Добавить(Р.Минуты); КонецЦикла; Возврат Массив;
КонецФункции
Процедура ОписатьСтрокиСКД(Строки, Итог, Уровень = 0)
    Для Каждого Р Из Строки Цикл
        Клиент = ""; Если ЗначениеЗаполнено(Р.Клиент) Тогда Клиент = Строка(Р.Клиент.УникальныйИдентификатор()); КонецЕсли;
        Итог.Добавить(Новый Структура("level,customer,count,minutes",Уровень,Клиент,Р.Количество,Р.Минуты));
        Если ТипЗнч(Р) = Тип("СтрокаДереваЗначений") Тогда ОписатьСтрокиСКД(Р.Строки,Итог,Уровень+1); КонецЕсли;
    КонецЦикла;
КонецПроцедуры
Функция ГотовыйОтчет(Клиент = Неопределено)
    ОбъектОтчета = Отчеты.ЗаявкиПоКлиентам.Создать(); Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"); Настройки = Схема.НастройкиПоУмолчанию;
    Если Клиент <> Неопределено Тогда Элемент = Настройки.Отбор.Элементы[0]; Элемент.Использование = Истина; Элемент.ПравоеЗначение = Клиент; КонецЕсли;
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных; Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет); Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; Коллекция = Вывод.Вывести(Процессор);
    Строки = ?(ТипЗнч(Коллекция) = Тип("ДеревоЗначений"),Коллекция.Строки,Коллекция); Итог = Новый Массив; ОписатьСтрокиСКД(Строки,Итог); Возврат Итог;
КонецФункции

Функция СвойстваРеквизита(Реквизит)
    Если Реквизит = Неопределено Тогда Возврат Новый Структура("exists",Ложь); КонецЕсли;
    Возврат Новый Структура("exists,name,synonym,type,length,fillChecking",Истина,Реквизит.Имя,Реквизит.Синоним,Строка(Реквизит.Тип),Реквизит.Тип.КвалификаторыСтроки.Длина,Строка(Реквизит.ПроверкаЗаполнения));
КонецФункции
Функция СнятьСостояниеA4() Экспорт
    ДиагШаг("state-start"); Клиенты = Новый Массив; Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Клиенты УПОРЯДОЧИТЬ ПО Код"); Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл
        О=Р.Ссылка.ПолучитьОбъект(); Клиенты.Добавить(Новый Структура("id,code,name,note",Строка(Р.Ссылка.УникальныйИдентификатор()),О.Код,О.Наименование,О.УчебнаяЗаметка));
    КонецЦикла;
    ДиагШаг("customers-read"); Реквизит=Метаданные.Документы.ЗаявкаУслуги.Реквизиты.Найти("УчебныйКанал"); Каналы=Новый Массив;
    Если Реквизит<>Неопределено Тогда Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги УПОРЯДОЧИТЬ ПО Номер"); Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл
        О=Р.Ссылка.ПолучитьОбъект(); Каналы.Добавить(Новый Структура("number,channel",О.Номер,О["УчебныйКанал"]));
    КонецЦикла; КонецЕсли;
    ДиагШаг("before-return"); Возврат Новый Структура("count,snapshots,customers,channels,noteMetadata,channelMetadata,report",СколькоЗаявок(),Снимки(),Клиенты,Каналы,СвойстваРеквизита(Метаданные.Справочники.Клиенты.Реквизиты.Найти("УчебнаяЗаметка")),СвойстваРеквизита(Реквизит),ГотовыйОтчет());
КонецФункции
Функция ЗаписатьЗаметку() Экспорт
    ДиагШаг("before-state"); До=СнятьСостояниеA4(); ДиагШаг("before-write"); О=Справочники.Клиенты.НайтиПоКоду("A3N1").ПолучитьОбъект(); О.УчебнаяЗаметка="Учебная заметка сохранена в новой копии."; О.Записать(); После=СнятьСостояниеA4();
    Возврат Новый Структура("before,after",До,После);
КонецФункции
Функция ЗаписатьКанал() Экспорт
    ДиагШаг("before-state"); До=СнятьСостояниеA4(); ДиагШаг("before-write"); О=Документы.ЗаявкаУслуги.НайтиПоНомеру("A30000001",Дата(2026,11,8,12,0,0)).ПолучитьОбъект(); О["УчебныйКанал"]="Учебная форма"; О.Записать(); После=СнятьСостояниеA4();
    Возврат Новый Структура("before,after",До,После);
КонецФункции

