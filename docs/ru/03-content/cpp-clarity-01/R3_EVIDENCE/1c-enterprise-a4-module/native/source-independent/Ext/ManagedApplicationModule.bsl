Процедура ПриНачалеРаботыСистемы()
    Части=СтрРазделить(ПараметрЗапуска,"|"); Если Части.Количество()<2 Тогда Возврат; КонецЕсли;
    Попытка
        Если Части[0]="main" Тогда Итог=УчебныйОбзор.ЗаписатьЗаметку(); ИначеЕсли Части[0]="independent" Тогда Итог=УчебныйОбзор.ЗаписатьКанал(); Иначе Итог=УчебныйОбзор.СнятьСостояниеA4(); КонецЕсли;
        Запись=Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись,Итог); Текст=Новый ТекстовыйДокумент; Текст.УстановитьТекст(Запись.Закрыть()); Текст.Записать(Части[1],КодировкаТекста.UTF8);
    Исключение
        Текст=Новый ТекстовыйДокумент; Текст.УстановитьТекст(ОписаниеОшибки()); Текст.Записать(Части[1]+".private-error",КодировкаТекста.UTF8);
    КонецПопытки;
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
