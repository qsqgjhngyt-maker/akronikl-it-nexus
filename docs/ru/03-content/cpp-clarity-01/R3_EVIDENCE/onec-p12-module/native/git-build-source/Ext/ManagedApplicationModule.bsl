Процедура ПриНачалеРаботыСистемы()
    Части = СтрРазделить(ПараметрЗапуска,"|");
    Режим = Части[0];
    Попытка
        Если Режим = "qa" Тогда
            Основной = УчебнаяИтоговая.ОпытПотерянногоКлиента();
            Самостоятельный = УчебнаяИтоговая.ОпытЛишнейЕдиницы();
            Текст = Новый ТекстовыйДокумент;
            Текст.УстановитьТекст("defense-main|" + Строка(Основной.ВнутреннихСтрок) + "|" + Строка(Основной.ЛевыхСтрок) + "|" + Строка(Основной.ПустойВозвращён) + "|" + Строка(Основной.ЗаявокПустого) + "|" + Строка(Основной.МинутВсего) + Символы.ПС + "defense-independent|" + Строка(Самостоятельный.НеверныхЗаявок) + "|" + Строка(Самостоятельный.ВерныхЗаявок) + "|" + Строка(Самостоятельный.ТотЖеПустой) + "|" + Строка(Самостоятельный.ВсегоЗаявок) + "|" + Строка(Самостоятельный.МинутВсего));
            Текст.Записать(Части[1],КодировкаТекста.UTF8);
        ИначеЕсли Режим = "snapshot" Или Режим = "seed" Тогда
            Итог = УчебнаяИтоговая.ИтоговыйОпыт(?(Режим = "seed","seed","verify"));
            Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(Итог); Текст.Записать(Части[1],КодировкаТекста.UTF8);
        Иначе
            УчебнаяИтоговая.ИтоговыйОпыт("verify");
            Если УчебнаяИтоговая.СвойМодульДоступен() Тогда
                Сообщить("Модуль расширения присутствует: Да");
                Сообщить(Вычислить("Расш1_Совет.Подсказка()"));
            Иначе
                Сообщить("Модуль расширения присутствует: Нет");
            КонецЕсли;
            Сообщить("Своих заявок: 12");
            Сообщить("Минут всего: 440");
            Сообщить("Версия учебного исходника: 2");
            Если Режим = "gui-defense-independent" Тогда
                Итог = УчебнаяИтоговая.ОпытЛишнейЕдиницы();
                Сообщить("COUNT(*), заявок пустого: " + Строка(Итог.НеверныхЗаявок));
                Сообщить("COUNT(З.Ссылка), заявок пустого: " + Строка(Итог.ВерныхЗаявок));
                Сообщить("Всего заявок: " + Строка(Итог.ВсегоЗаявок));
            Иначе
                Итог = УчебнаяИтоговая.ОпытПотерянногоКлиента();
                Сообщить("Клиентов с INNER JOIN: " + Строка(Итог.ВнутреннихСтрок));
                Сообщить("Клиентов с LEFT JOIN: " + Строка(Итог.ЛевыхСтрок));
                Сообщить("Заявок у пустого клиента: " + Строка(Итог.ЗаявокПустого));
            КонецЕсли;
        КонецЕсли;
    Исключение
        Если Части.Количество() > 1 Тогда
            Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(ОписаниеОшибки()); Текст.Записать(Части[1]+".private-error",КодировкаТекста.UTF8);
        Иначе
            Сообщить(ОписаниеОшибки());
        КонецЕсли;
    КонецПопытки;
    Если Части.Количество() > 1 Тогда ЗавершитьРаботуСистемы(Ложь); КонецЕсли;
КонецПроцедуры
