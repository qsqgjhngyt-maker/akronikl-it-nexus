Процедура ПриНачалеРаботыСистемы()
    Части = СтрРазделить(ПараметрЗапуска,"|");
    Попытка
        Снимок = УчебнаяИтоговая.ОпытНовогоИзменения(Части[0] = "edit-first");
        Если Части.Количество() > 1 Тогда
            Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(Снимок); Текст.Записать(Части[1],КодировкаТекста.UTF8);
        Иначе
            Сообщить("В отдельной копии заявок: 12");
            Сообщить("Первая заявка: 30 → 50 минут");
            Сообщить("Последняя заявка: 80 минут");
            Сообщить("Минут всего в копии: 475");
            Сообщить("Исходная база: отдельный путь, 440 минут");
        КонецЕсли;
    Исключение
        Если Части.Количество() > 1 Тогда
            Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(ОписаниеОшибки()); Текст.Записать(Части[1]+".private-error",КодировкаТекста.UTF8);
        Иначе Сообщить(ОписаниеОшибки()); КонецЕсли;
    КонецПопытки;
    Если Части.Количество() > 1 Тогда ЗавершитьРаботуСистемы(Ложь); КонецЕсли;
КонецПроцедуры
