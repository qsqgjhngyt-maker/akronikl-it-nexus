Функция ОпытНовогоИзменения(Изменить = Ложь) Экспорт
    Если Изменить Тогда
        Документ = Документы.ЗаявкаУслуги.НайтиПоНомеру("F00000001").ПолучитьОбъект();
        Документ.ДлительностьМинут = 50;
        Документ.Записать();
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.Номер,З.Дата,З.Клиент,З.Услуга,З.Статус,З.ДлительностьМинут КАК Минуты,З.Комментарий КАК Заметка ИЗ Документ.ЗаявкаУслуги КАК З УПОРЯДОЧИТЬ ПО З.Номер");
    Таблица = Запрос.Выполнить().Выгрузить(); Ожидание = 475;
    Если Таблица.Количество() <> 12 Или Таблица.Итог("Минуты") <> Ожидание Тогда ВызватьИсключение "A8 количество/сумма"; КонецЕсли;
    Альфа = Справочники.Клиенты.НайтиПоКоду("A8C1"); Бета = Справочники.Клиенты.НайтиПоКоду("A8C2"); Пустой = Справочники.Клиенты.НайтиПоКоду("A8C3");
    ИтогА = 0; ИтогБ = 0; Пустых = 0; Снимок = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Если Строка.Клиент = Альфа Тогда ИтогА = ИтогА + Строка.Минуты; КонецЕсли;
        Если Строка.Клиент = Бета Тогда ИтогБ = ИтогБ + Строка.Минуты; КонецЕсли;
        Если Строка.Клиент = Пустой Тогда Пустых = Пустых + 1; КонецЕсли;
        Снимок.Добавить(Строка.Номер+"|"+Строка(Строка.Ссылка.УникальныйИдентификатор())+"|"+Строка(Строка.Клиент.УникальныйИдентификатор())+"|"+Строка(Строка.Услуга.УникальныйИдентификатор())+"|"+Строка(Строка.Дата)+"|"+Строка(Строка.Статус)+"|"+Строка(Строка.Минуты)+"|"+Строка.Заметка);
    КонецЦикла;
    Если ИтогА <> 245 Или ИтогБ <> 230 Или Пустых <> 0 Или Альфа = Пустой Или Альфа.Наименование <> Пустой.Наименование Тогда ВызватьИсключение "A8 состав по ключам"; КонецЕсли;
    Возврат СтрСоединить(Снимок,Символы.ПС);
КонецФункции

