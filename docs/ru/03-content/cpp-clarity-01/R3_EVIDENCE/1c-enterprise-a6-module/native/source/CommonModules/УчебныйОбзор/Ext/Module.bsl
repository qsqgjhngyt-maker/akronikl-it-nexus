Функция НовыйКлиент(Код, Имя)
    О = Справочники.Клиенты.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция НоваяУслуга(Код, Имя)
    О = Справочники.Услуги.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.ТарифЗаЧас = 0; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция Заявка(Номер, Клиент, Услуга, Минуты, Комментарий)
    О = Документы.ЗаявкаУслуги.СоздатьДокумент(); О.Номер = Номер; О.Дата = Дата(2026,11,8,12,0,0); О.Клиент = Клиент; О.Услуга = Услуга; О.ДлительностьМинут = Минуты; О.Статус = Перечисления.СтатусыЗаявки.Новая; О.Комментарий = Комментарий; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция СколькоЗаявок()
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги");
    Возврат Запрос.Выполнить().Выгрузить().Количество();
КонецФункции
Функция СнимокЗаявки(Ссылка)
    О = Ссылка.ПолучитьОбъект(); Возврат Строка(Ссылка.УникальныйИдентификатор()) + "|" + О.Номер + "|" + Строка(О.Клиент.УникальныйИдентификатор()) + "|" + Строка(О.Услуга.УникальныйИдентификатор()) + "|" + Строка(О.Дата) + "|" + Строка(О.ДлительностьМинут) + "|" + Строка(О.Статус) + "|" + О.Комментарий;
КонецФункции

Функция Снимки()
    Результат = Новый Массив; Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги УПОРЯДОЧИТЬ ПО Номер");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл Результат.Добавить(СнимокЗаявки(Р.Ссылка)); КонецЦикла;
    Возврат Результат;
КонецФункции
Функция Числа(Порог = Неопределено, Убывание = Ложь)
    Текст = "ВЫБРАТЬ ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги";
    Если Порог <> Неопределено Тогда Текст = Текст + " ГДЕ ДлительностьМинут >= &Порог"; КонецЕсли;
    Текст = Текст + " УПОРЯДОЧИТЬ ПО ДлительностьМинут" + ?(Убывание," УБЫВ","") + ", Номер";
    Запрос = Новый Запрос(Текст); Если Порог <> Неопределено Тогда Запрос.УстановитьПараметр("Порог",Порог); КонецЕсли;
    Массив = Новый Массив; Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл Массив.Добавить(Р.Минуты); КонецЦикла; Возврат Массив;
КонецФункции
Процедура ОписатьСтрокиСКД(Строки, Итог, Уровень = 0)
    Для Каждого Р Из Строки Цикл
        Клиент = ""; Если ЗначениеЗаполнено(Р.Клиент) Тогда Клиент = Строка(Р.Клиент.УникальныйИдентификатор()); КонецЕсли;
        Итог.Добавить(Новый Структура("level,customer,count,minutes",Уровень,Клиент,Р.Количество,Р.Минуты));
        Если ТипЗнч(Р) = Тип("СтрокаДереваЗначений") Тогда ОписатьСтрокиСКД(Р.Строки,Итог,Уровень+1); КонецЕсли;
    КонецЦикла;
КонецПроцедуры
Функция ГотовыйОтчет(Клиент = Неопределено)
    ОбъектОтчета = Отчеты.ЗаявкиПоКлиентам.Создать(); Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"); Настройки = Схема.НастройкиПоУмолчанию;
    Если Клиент <> Неопределено Тогда Элемент = Настройки.Отбор.Элементы[0]; Элемент.Использование = Истина; Элемент.ПравоеЗначение = Клиент; КонецЕсли;
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных; Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет); Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; Коллекция = Вывод.Вывести(Процессор);
    Строки = ?(ТипЗнч(Коллекция) = Тип("ДеревоЗначений"),Коллекция.Строки,Коллекция); Итог = Новый Массив; ОписатьСтрокиСКД(Строки,Итог); Возврат Итог;
КонецФункции


Функция СнятьСостояниеA5() Экспорт
    Клиенты=Новый Массив; Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Клиенты УПОРЯДОЧИТЬ ПО Код");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл О=Р.Ссылка.ПолучитьОбъект(); Клиенты.Добавить(Новый Структура("id,code,name,note",Строка(Р.Ссылка.УникальныйИдентификатор()),О.Код,О.Наименование,О.УчебнаяЗаметка)); КонецЦикла;
    Услуги=Новый Массив; Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Услуги УПОРЯДОЧИТЬ ПО Код");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл О=Р.Ссылка.ПолучитьОбъект(); Услуги.Добавить(Новый Структура("id,code,name",Строка(Р.Ссылка.УникальныйИдентификатор()),О.Код,О.Наименование)); КонецЦикла;
    Таблицы=Новый Массив; Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги УПОРЯДОЧИТЬ ПО Номер");
    Для Каждого Р Из Запрос.Выполнить().Выгрузить() Цикл
      О=Р.Ссылка.ПолучитьОбъект(); Строки=Новый Массив;
      Для Каждого Позиция Из О.Работы Цикл Строки.Добавить(Новый Структура("service,minutes",Строка(Позиция.Услуга.УникальныйИдентификатор()),Позиция.Минуты)); КонецЦикла;
      Таблицы.Добавить(Новый Структура("id,number,header,rows,comment",Строка(Р.Ссылка.УникальныйИдентификатор()),О.Номер,О.ДлительностьМинут,Строки,О.Комментарий));
    КонецЦикла;
    Возврат Новый Структура("count,snapshots,customers,services,tables,report",СколькоЗаявок(),Снимки(),Клиенты,Услуги,Таблицы,ГотовыйОтчет());
КонецФункции
Процедура ДвеСтрокиA5(О,Услуга1,Услуга2,Минуты1,Минуты2)
    СтрокаТаблицы=О.Работы.Добавить(); СтрокаТаблицы.Услуга=Услуга1; СтрокаТаблицы.Минуты=Минуты1;
    СтрокаТаблицы=О.Работы.Добавить(); СтрокаТаблицы.Услуга=Услуга2; СтрокаТаблицы.Минуты=Минуты2;
КонецПроцедуры
Функция ОпытA5(Самостоятельный=Ложь) Экспорт
    Если СколькоЗаявок()<>4 Тогда ВызватьИсключение "Нужна новая восстановленная копия исходных четырёх заявок"; КонецЕсли;
    До=СнятьСостояниеA5(); Клиент=НовыйКлиент("A5C1",?(Самостоятельный,"Учебный перенос A5","Учебный A5")); Услуга1=НоваяУслуга("A5U1","Диагностика A5");
    Префикс=?(Самостоятельный,"A5200000","A5100000"); Первый=Заявка(Префикс+"1",Клиент,Услуга1,?(Самостоятельный,40,30),"Новая модель A5"); Второй=Заявка(Префикс+"2",Клиент,Услуга1,?(Самостоятельный,25,15),"Новая модель A5");
    МодельДо=Новый Массив; МодельДо.Добавить(СнимокЗаявки(Первый)); МодельДо.Добавить(СнимокЗаявки(Второй)); О=Клиент.ПолучитьОбъект(); О.Наименование=?(Самостоятельный,"Учебный перенос A5 — проверено","Учебный A5 — уточнено"); О.Записать();
    МодельПосле=Новый Массив; МодельПосле.Добавить(СнимокЗаявки(Первый)); МодельПосле.Добавить(СнимокЗаявки(Второй));
    Услуга2=НоваяУслуга("A5U2",?(Самостоятельный,"Учебная проверка A5","Диагностика A5 — выезд")); Третий=Заявка(Префикс+"3",Клиент,Услуга2,?(Самостоятельный,15,20),"Повтор услуги A5"); Четвертый=Заявка(Префикс+"4",Клиент,Услуга2,?(Самостоятельный,35,40),"Повтор услуги A5");
    УслугиДо=Новый Массив; УслугиДо.Добавить(СнимокЗаявки(Третий)); УслугиДо.Добавить(СнимокЗаявки(Четвертый)); О=Услуга2.ПолучитьОбъект(); О.Наименование=О.Наименование+" — проверено"; О.Записать();
    УслугиПосле=Новый Массив; УслугиПосле.Добавить(СнимокЗаявки(Третий)); УслугиПосле.Добавить(СнимокЗаявки(Четвертый));
    Табличный=Заявка(Префикс+"5",Клиент,Услуга1,?(Самостоятельный,50,30),"До проверки формы"); О=Табличный.ПолучитьОбъект(); ДвеСтрокиA5(О,Услуга1,Услуга2,?(Самостоятельный,35,20),?(Самостоятельный,15,10)); О.Записать(); НачальнаяШапка=Табличный.ДлительностьМинут;
    ПослеИзмененияСтроки=НачальнаяШапка;
    Если Самостоятельный Тогда О=Табличный.ПолучитьОбъект(); О.Работы[0].Минуты=40; О.Записать(); ПослеИзмененияСтроки=Табличный.ПолучитьОбъект().ДлительностьМинут; О=Табличный.ПолучитьОбъект(); О.ДлительностьМинут=55; О.Записать(); КонецЕсли;
    ПередОтказом=СколькоЗаявок(); Черновик=Документы.ЗаявкаУслуги.СоздатьДокумент(); Черновик.Номер=Префикс+"6"; Черновик.Дата=Дата(2026,11,9,12,0,0); Черновик.Услуга=Услуга1; Черновик.ДлительностьМинут=30; Черновик.Статус=Перечисления.СтатусыЗаявки.Новая; ДвеСтрокиA5(Черновик,Услуга1,Услуга2,20,10); Отказ=Ложь; Попытка Черновик.Записать(); Исключение Отказ=Истина; КонецПопытки;
    ПослеОтказа=СколькоЗаявок(); О=Табличный.ПолучитьОбъект(); О.Комментарий=?(Самостоятельный,"Форма самостоятельной работы A5","Форма A5 проверена"); О.Записать(); После=СнятьСостояниеA5();
    Возврат Новый Структура("before,after,modelBefore,modelAfter,servicesBefore,servicesAfter,initialHeader,headerAfterRowChange,refusedMissingCustomer,countBeforeRefusal,countAfterRefusal,rowsDocumentId",До,После,МодельДо,МодельПосле,УслугиДо,УслугиПосле,НачальнаяШапка,ПослеИзмененияСтроки,Отказ,ПередОтказом,ПослеОтказа,Строка(Табличный.УникальныйИдентификатор()));
КонецФункции

Функция СсылкаДокументаA5(Идентификатор) Экспорт
 Возврат Документы.ЗаявкаУслуги.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
КонецФункции
