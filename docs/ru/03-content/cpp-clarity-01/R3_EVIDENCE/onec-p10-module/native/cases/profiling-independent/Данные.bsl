Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция СравнитьПятьПовторов(ПервыеМинуты,ВторыеМинуты) Экспорт
    Д = НовыйНаборРегистров(ПервыеМинуты,ВторыеМинуты);
    Ключи = Новый Массив; Ключи.Добавить(Д.Первая); Ключи.Добавить(Д.Вторая);
    Измерения = Новый Массив; ВсёРавно = Истина;
    Для Номер = 1 По 5 Цикл
        // Набор и объём одинаковы. Порядок вариантов чередуется; таймер не обещает преимущество.
        Порядок = ?(Номер % 2 = 1,"отдельно,пакетом","пакетом,отдельно");
        Для Каждого Вариант Из СтрРазделить(Порядок,",") Цикл
            Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
            Сумма = 0; Количество = 0; Вызовы = 0; СвоиСсылки = Истина;
            Если Вариант = "отдельно" Тогда
                Для Каждого Ключ Из Ключи Цикл
                    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка = &Ключ");
                    Запрос.УстановитьПараметр("Ключ",Ключ);
                    Таблица = Запрос.Выполнить().Выгрузить(); Вызовы = Вызовы + 1;
                    Количество = Количество + Таблица.Количество();
                    Если Таблица.Количество() = 1 Тогда
                        Сумма = Сумма + Таблица[0].Минуты;
                        СвоиСсылки = СвоиСсылки И Таблица[0].Ссылка = Ключ;
                    Иначе
                        СвоиСсылки = Ложь;
                    КонецЕсли;
                КонецЦикла;
            Иначе
                Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка В (&Ключи)");
                Запрос.УстановитьПараметр("Ключи",Ключи);
                Таблица = Запрос.Выполнить().Выгрузить(); Вызовы = 1;
                Количество = Таблица.Количество(); Сумма = Таблица.Итог("Минуты");
                СвоиСсылки = Количество = 2 И Таблица.Найти(Д.Первая,"Ссылка") <> Неопределено И Таблица.Найти(Д.Вторая,"Ссылка") <> Неопределено;
            КонецЕсли;
            Миллисекунды = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
            ВсёРавно = ВсёРавно И Количество = 2 И Сумма = ПервыеМинуты + ВторыеМинуты И СвоиСсылки;
            Измерения.Добавить(Новый Структура("Повтор,Вариант,Вызовы,Строки,Минуты,Мс",Номер,Вариант,Вызовы,Количество,Сумма,Миллисекунды));
        КонецЦикла;
    КонецЦикла;
    Возврат Новый Структура("Эквивалентно,Наблюдений,ВызововОтдельно,ВызововПакетом,Минуты,СырыеЗамеры",ВсёРавно,Измерения.Количество(),2,1,ПервыеМинуты + ВторыеМинуты,Измерения);
КонецФункции

Функция ОпытНовогоНабораЗамеров() Экспорт
    Возврат СравнитьПятьПовторов(20,60);
КонецФункции
