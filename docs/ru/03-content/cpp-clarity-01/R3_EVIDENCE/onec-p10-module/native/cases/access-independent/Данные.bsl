Функция ПроверитьНовуюПаруПрав() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Метка");
    Запрос.УстановитьПараметр("Метка","P10 независимая пара");
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 1 Или Таблица[0].Минуты <> 30 Тогда
        ВызватьИсключение "Новый отбор: должна быть только своя строка30";
    КонецЕсли;
    Ссылка = Таблица[0].Ссылка; Объект = Ссылка.ПолучитьОбъект();
    ОтказПрав = Ложь;
    Попытка
        Объект.ДлительностьМинут = 25; Объект.Записать();
    Исключение
        ОтказПрав = Истина;
    КонецПопытки;
    Если Не ОтказПрав Или Ссылка.ДлительностьМинут <> 30 Тогда
        ВызватьИсключение "Корректная25 не должна менять запись читателем";
    КонецЕсли;
    Возврат "PASS|one-new-row|30|35-hidden|valid-update-rejected|30-retained";
КонецФункции
