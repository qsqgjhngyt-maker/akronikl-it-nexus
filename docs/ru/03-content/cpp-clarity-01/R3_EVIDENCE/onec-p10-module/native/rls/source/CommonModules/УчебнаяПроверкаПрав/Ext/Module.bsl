// Оригинальный инженерный эталон A8/P12; собственная отдельная база, не код новичка.
Функция ИтоговыйОпыт(Режим) Экспорт
    Если Режим = "seed" Тогда
        Для Индекс = 1 По 3 Цикл
            Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Код = "A8C" + Строка(Индекс); Клиент.Наименование = ?(Индекс = 2,"Учебная Бета","Учебная Альфа"); Клиент.Записать();
        КонецЦикла;
        Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Код = "A8S1"; Услуга.Наименование = "Учебная консультация"; Услуга.Записать();
        Части = СтрРазделить("30,45,15,0,60,20,25,35,40,50,55,65",",");
        Для Индекс = 0 По 11 Цикл
            Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Номер = "F" + Прав("00000000"+СокрЛП(Строка(Индекс+1)),8); Документ.Дата = Дата(2026,11,2,12,0,0);
            Документ.Клиент = Справочники.Клиенты.НайтиПоКоду(?(Индекс % 2 = 0,"A8C1","A8C2")); Документ.Услуга = Услуга.Ссылка;
            Документ.Статус = Перечисления.СтатусыЗаявки.Новая; Документ.ДлительностьМинут = Число(Части[Индекс]); Документ.Комментарий = "A8 собственная " + Строка(Индекс+1); Документ.Записать();
        КонецЦикла;
    КонецЕсли;
    Если Режим = "edit" Тогда
        Документ = Документы.ЗаявкаУслуги.НайтиПоНомеру("F00000012").ПолучитьОбъект(); Документ.ДлительностьМинут = 80; Документ.Записать();
    КонецЕсли;
    Если Режим = "invalid" Тогда
        Ссылка = Документы.ЗаявкаУслуги.НайтиПоНомеру("F00000001"); Документ = Ссылка.ПолучитьОбъект();
        Отказ = Ложь; Попытка Документ.ДлительностьМинут = 1441; Документ.Записать(); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Или Ссылка.ДлительностьМинут <> 30 Тогда ВызватьИсключение "A8 отказ не сохранил30"; КонецЕсли;
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.Номер,З.Дата,З.Клиент,З.Услуга,З.Статус,З.ДлительностьМинут КАК Минуты,З.Комментарий КАК Заметка ИЗ Документ.ЗаявкаУслуги КАК З УПОРЯДОЧИТЬ ПО З.Номер");
    Таблица = Запрос.Выполнить().Выгрузить(); Ожидание = ?(Режим = "edit" Или Режим = "verify-copy",455,440);
    Если Таблица.Количество() <> 12 Или Таблица.Итог("Минуты") <> Ожидание Тогда ВызватьИсключение "A8 количество/сумма"; КонецЕсли;
    Альфа = Справочники.Клиенты.НайтиПоКоду("A8C1"); Бета = Справочники.Клиенты.НайтиПоКоду("A8C2"); Пустой = Справочники.Клиенты.НайтиПоКоду("A8C3");
    ИтогА = 0; ИтогБ = 0; Пустых = 0; Снимок = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Если Строка.Клиент = Альфа Тогда ИтогА = ИтогА + Строка.Минуты; КонецЕсли;
        Если Строка.Клиент = Бета Тогда ИтогБ = ИтогБ + Строка.Минуты; КонецЕсли;
        Если Строка.Клиент = Пустой Тогда Пустых = Пустых + 1; КонецЕсли;
        Снимок.Добавить(Строка.Номер+"|"+Строка(Строка.Ссылка.УникальныйИдентификатор())+"|"+Строка(Строка.Клиент.УникальныйИдентификатор())+"|"+Строка(Строка.Услуга.УникальныйИдентификатор())+"|"+Строка(Строка.Дата)+"|"+Строка(Строка.Статус)+"|"+Строка(Строка.Минуты)+"|"+Строка.Заметка);
    КонецЦикла;
    Если ИтогА <> 225 Или ИтогБ <> Ожидание - 225 Или Пустых <> 0 Или Альфа = Пустой Или Альфа.Наименование <> Пустой.Наименование Тогда ВызватьИсключение "A8 состав по ключам"; КонецЕсли;
    Возврат СтрСоединить(Снимок,Символы.ПС);
КонецФункции

Функция ПодготовитьРоли() Экспорт
    ИтоговыйОпыт("seed");
    Для Каждого Имя Из СтрРазделить("NexusP10Admin|NexusP10Reader","|") Цикл
        Профиль = ПользователиИнформационнойБазы.СоздатьПользователя(); Профиль.Имя = Имя;
        Профиль.АутентификацияСтандартная = Истина; Профиль.АутентификацияОС = Ложь;
        Профиль.Роли.Добавить(?(Имя = "NexusP10Admin",Метаданные.Роли.УчебныйАдминистраторA6,Метаданные.Роли.УчебныйЧитательA6)); Профиль.Записать();
    КонецЦикла;
    Возврат "OWN_SYNTHETIC_PROFILES_READY";
КонецФункции
Функция ПроверитьОграничение() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З"); Данные = Запрос.Выполнить().Выгрузить();
    Если Данные.Количество() <> 5 Или Данные.Итог("Минуты") <> 90 Тогда ВызватьИсключение "RLS состав5/90"; КонецЕсли;
    Для Каждого Ряд Из Данные Цикл Если Ряд.Минуты > 30 Тогда ВызватьИсключение "RLS граница"; КонецЕсли; КонецЦикла;
    Отказ = Ложь; Попытка НовыйЗапрос = Новый Запрос("ВЫБРАТЬ З.Ссылка ИЗ Документ.ЗаявкаУслуги КАК З"); НовыйЗапрос.Выполнить(); Исключение Отказ = Истина; КонецПопытки;
    Если Не Отказ Тогда ВызватьИсключение "RLS unrestricted query unexpectedly allowed"; КонецЕсли;
    Ссылка = Данные[0].Ссылка; Ранее = Ссылка.ДлительностьМинут; Объект = Ссылка.ПолучитьОбъект(); Отказ = Ложь;
    Попытка Объект.ДлительностьМинут = 25; Объект.Записать(); Исключение Отказ = Истина; КонецПопытки;
    Если Не Отказ Или Ссылка.ДлительностьМинут <> Ранее Тогда ВызватьИсключение "RLS запись не защищена"; КонецЕсли;
    Возврат "PASS|five-rows-90|all-le30|unrestricted-query-rejected|valid-update-rejected|prior-value-retained";
КонецФункции
// PLANNED: только собственная синтетическая копия; не Nexus IAM.
Функция ПодготовитьНовуюПаруПрав() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный P10 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P10"; Услуга.Записать();
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,8,12,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка;
        Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,30,35);
        Документ.Комментарий = "P10 независимая пара"; Документ.Записать();
    КонецЦикла;
    Возврат "PREPARED|two-new-documents|30|35";
КонецФункции

Функция ПроверитьНовуюПаруПрав() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Метка");
    Запрос.УстановитьПараметр("Метка","P10 независимая пара");
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 1 Или Таблица[0].Минуты <> 30 Тогда
        ВызватьИсключение "Новый отбор: должна быть только своя строка30";
    КонецЕсли;
    Ссылка = Таблица[0].Ссылка; Объект = Ссылка.ПолучитьОбъект();
    ОтказПрав = Ложь;
    Попытка
        Объект.ДлительностьМинут = 25; Объект.Записать();
    Исключение
        ОтказПрав = Истина;
    КонецПопытки;
    Если Не ОтказПрав Или Ссылка.ДлительностьМинут <> 30 Тогда
        ВызватьИсключение "Корректная25 не должна менять запись читателем";
    КонецЕсли;
    Возврат "PASS|one-new-row|30|35-hidden|valid-update-rejected|30-retained";
КонецФункции

Функция ПроверитьНовыйИтогАдминистратором() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Метка");
    Запрос.УстановитьПараметр("Метка","P10 независимая пара");
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 2 Или Таблица.Итог("Минуты") <> 65 Тогда
        ВызватьИсключение "Новая пара изменена";
    КонецЕсли;
    Возврат "PASS|two-new-documents|65|30-and-35-preserved";
КонецФункции

