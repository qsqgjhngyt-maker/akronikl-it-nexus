Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытКомпоновки() Экспорт
    Д = НовыйНаборРегистров();
    Схема = Новый СхемаКомпоновкиДанных;
    Источник = Схема.ИсточникиДанных.Добавить(); Источник.Имя = "Основной"; Источник.ТипИсточникаДанных = "Local";
    Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных")); Набор.Имя = "Заявки"; Набор.ИсточникДанных = "Основной";
    Набор.Запрос = "ВЫБРАТЬ З.Ссылка КАК Ссылка, З.Клиент КАК Клиент, З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З";
    Для Каждого Имя Из СтрРазделить("Ссылка,Клиент,Минуты",",") Цикл
        Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных")); Поле.ПутьКДанным = Имя; Поле.Поле = Имя; Поле.Заголовок = Имя;
    КонецЦикла;
    Настройки = Новый НастройкиКомпоновкиДанных;
    Для Каждого Имя Из СтрРазделить("Ссылка,Минуты",",") Цикл
        Выбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); Выбор.Поле = Новый ПолеКомпоновкиДанных(Имя); Выбор.Использование = Истина;
    КонецЦикла;
    Группа = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных")); Группа.Использование = Истина; Группа.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
    Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Клиент"); Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; Отбор.ПравоеЗначение = Д.Клиент; Отбор.Использование = Истина;
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных; Процессор.Инициализировать(Макет);
    Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений; Таблица = Вывод.Вывести(Процессор);
    ПолныйВерный = Таблица.Количество() = 2 И Таблица.Итог("Минуты") = 75;
    ОтборМинут = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); ОтборМинут.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Минуты"); ОтборМинут.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше; ОтборМинут.ПравоеЗначение = 30; ОтборМинут.Использование = Истина;
    Макет = Компоновщик.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); Процессор.Инициализировать(Макет); Таблица = Вывод.Вывести(Процессор);
    Возврат Новый Структура("ПолныйВерный,ОтборВерный",ПолныйВерный,Таблица.Количество() = 1 И Таблица[0].Ссылка = Д.Вторая И Таблица.Итог("Минуты") = 45);
КонецФункции
