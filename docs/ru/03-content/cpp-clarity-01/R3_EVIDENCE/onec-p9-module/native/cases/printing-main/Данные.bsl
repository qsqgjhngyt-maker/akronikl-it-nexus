Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ТабличныйСнимокОпыта(Данные) Экспорт
    Док = Новый ТабличныйДокумент;
    Док.Область("R1C1").Текст = "Ключ заявки"; Док.Область("R1C2").Текст = "Минуты";
    Док.Область("R2C1").Текст = Строка(Данные.Первая.УникальныйИдентификатор());
    Док.Область("R3C1").Текст = Строка(Данные.Вторая.УникальныйИдентификатор());
    Док.Область("R2C2").СодержитЗначение = Истина; Док.Область("R2C2").ТипЗначения = Новый ОписаниеТипов("Число"); Док.Область("R2C2").Формат = "ЧДЦ=0; ЧН=0"; Док.Область("R2C2").Значение = Данные.Первая.ДлительностьМинут;
    Док.Область("R3C2").СодержитЗначение = Истина; Док.Область("R3C2").ТипЗначения = Новый ОписаниеТипов("Число"); Док.Область("R3C2").Формат = "ЧДЦ=0; ЧН=0"; Док.Область("R3C2").Значение = Данные.Вторая.ДлительностьМинут;
    Док.Область("R4C1").Текст = "Итого, минуты"; Док.Область("R4C2").СодержитЗначение = Истина; Док.Область("R4C2").ТипЗначения = Новый ОписаниеТипов("Число"); Док.Область("R4C2").Формат = "ЧДЦ=0; ЧН=0";
    Док.Область("R4C2").Значение = Данные.Первая.ДлительностьМинут + Данные.Вторая.ДлительностьМинут;
    Док.Область("R1C1:R4C1").ШиринаКолонки = 46; Док.Область("R1C2:R4C2").ШиринаКолонки = 15;
    Возврат Док;
КонецФункции

Функция ОпытСнимкаОсновной() Экспорт
    Д = НовыйНаборРегистров(); Док = ТабличныйСнимокОпыта(Д);
    Возврат Новый Структура("Итог,ПерваяСохранена,ВтораяСохранена,КлючПодписан,ТабДок",Док.Область("R4C2").Значение,Д.Первая.ДлительностьМинут = 30,Д.Вторая.ДлительностьМинут = 45,Док.Область("R2C1").Текст = Строка(Д.Первая.УникальныйИдентификатор()),Док);
КонецФункции
