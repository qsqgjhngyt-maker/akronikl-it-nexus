// Только собственный loopback mock из native/full-support/http-mock.mjs; не произвольный URL.
Функция ОпытHTTP(Порт) Экспорт
    Если ТипЗнч(Порт) <> Тип("Число") Тогда ВызватьИсключение "Нужен номер порта своего mock"; КонецЕсли;
    Если Порт < 1 Или Порт > 65535 Или Цел(Порт) <> Порт Тогда ВызватьИсключение "Неверный порт"; КонецЕсли;
    Соединение = Новый HTTPСоединение("127.0.0.1",Порт,,,,1);
    Ответ = Соединение.Получить(Новый HTTPЗапрос("/health"));
    Текст = Ответ.ПолучитьТелоКакСтроку();
    Успех = Ответ.КодСостояния = 200 И СтрДлина(Текст) < 4096 И СтрНайти(Текст,"nexus-course-mock") > 0;
    Отказ = Соединение.Получить(Новый HTTPЗапрос("/reject"));
    Таймаут = Ложь; Попытка Соединение.Получить(Новый HTTPЗапрос("/slow")); Исключение Таймаут = Истина; КонецПопытки;
    Возврат Новый Структура("HealthВерный,ОтказВерный,ТаймаутВерный",Успех,Отказ.КодСостояния = 400,Таймаут);
КонецФункции

Функция ПроверитьПакет(Текст) Экспорт
    Если ТипЗнч(Текст) <> Тип("Строка") Тогда ВызватьИсключение "Нужен текст"; КонецЕсли;
    Если СтрДлина(Текст) > 4096 Тогда ВызватьИсключение "Пакет слишком большой"; КонецЕсли;
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "Нужен объект"; КонецЕсли;
    Если Данные.Количество() <> 3 Тогда ВызватьИсключение "Ровно три поля"; КонецЕсли;
    Версия = Неопределено; Минуты = Неопределено; Метка = Неопределено;
    Если Не Данные.Свойство("schemaVersion",Версия) Или Не Данные.Свойство("minutes",Минуты) Или Не Данные.Свойство("text",Метка) Тогда ВызватьИсключение "Неверные поля"; КонецЕсли;
    Если ТипЗнч(Версия) <> Тип("Число") Или ТипЗнч(Минуты) <> Тип("Число") Или ТипЗнч(Метка) <> Тип("Строка") Тогда ВызватьИсключение "Неверные типы"; КонецЕсли;
    Если Версия <> 1 Или Минуты < 0 Или Минуты > 1440 Или Цел(Минуты) <> Минуты Или СтрДлина(Метка) > 80 Тогда ВызватьИсключение "Неверные значения"; КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ОпытJSONXML() Экспорт
    Данные = ПроверитьПакет("{""schemaVersion"":1,""minutes"":30,""text"":""Учебный & <текст>""}");
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись,Данные); Текст = Запись.Закрыть(); Повтор = ПроверитьПакет(Текст);
    Отказ = Ложь; Попытка ПроверитьПакет("{""schemaVersion"":1,""minutes"":""30"",""text"":""Учебный""}"); Исключение Отказ = Истина; КонецПопытки;
    Запись = Новый ЗаписьXML; Запись.УстановитьСтроку(); Запись.ЗаписатьНачалоЭлемента("request"); Запись.ЗаписатьАтрибут("minutes",Строка(Данные.minutes)); Запись.ЗаписатьТекст(Данные.text); Запись.ЗаписатьКонецЭлемента(); XML = Запись.Закрыть();
    Чтение = Новый ЧтениеXML; Чтение.УстановитьСтроку(XML); Чтение.Прочитать();
    XMLВерный = Чтение.Имя = "request" И Чтение.ПолучитьАтрибут("minutes") = "30"; Чтение.Закрыть();
    Возврат Новый Структура("JSONВерный,ТипОтклонен,XMLВерный",Повтор.minutes = 30 И Повтор.text = Данные.text,Отказ,XMLВерный);
КонецФункции

// Общая подготовка P6; определение в серверном модуле добавляется один раз.
Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

// Последовательный опыт. Два конкурирующих получателя и crash recovery отдельно не доказаны.
Функция ПринятьУчебнуюОперацию(Ключ,Минуты,Клиент,Услуга) Экспорт
    Если ТипЗнч(Ключ) <> Тип("Строка") Или ТипЗнч(Минуты) <> Тип("Число") Тогда ВызватьИсключение "Неверные типы"; КонецЕсли;
    Если СтрДлина(Ключ) <> 36 Или Минуты < 0 Или Минуты > 1440 Тогда ВызватьИсключение "Неверный договор"; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты,З.Клиент,З.Услуга ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Ключ");
        Запрос.УстановитьПараметр("Ключ",Ключ); Найдено = Запрос.Выполнить().Выгрузить();
        Если Найдено.Количество() > 0 Тогда
            Если Найдено.Количество() <> 1 Или Найдено[0].Минуты <> Минуты Или Найдено[0].Клиент <> Клиент Или Найдено[0].Услуга <> Услуга Тогда ВызватьИсключение "Конфликт ключа/содержимого"; КонецЕсли;
            Ссылка = Найдено[0].Ссылка;
        Иначе
            Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,12,0,0); Документ.Клиент = Клиент; Документ.Услуга = Услуга; Документ.Статус = Перечисления.СтатусыЗаявки.Новая; Документ.ДлительностьМинут = Минуты; Документ.Комментарий = Ключ; Документ.Записать(); Ссылка = Документ.Ссылка;
        КонецЕсли;
        ЗафиксироватьТранзакцию(); Возврат Ссылка;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ОпытПовторногоПриёма() Экспорт
    Д = НовыйНаборРегистров(); Ключ = Строка(Новый УникальныйИдентификатор);
    Первая = ПринятьУчебнуюОперацию(Ключ,30,Д.Клиент,Д.Услуга); Повтор = ПринятьУчебнуюОперацию(Ключ,30,Д.Клиент,Д.Услуга);
    Конфликт = Ложь; Попытка ПринятьУчебнуюОперацию(Ключ,31,Д.Клиент,Д.Услуга); Исключение Конфликт = Истина; КонецПопытки;
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий = &Ключ"); Запрос.УстановитьПараметр("Ключ",Ключ);
    Возврат Новый Структура("ПовторТотЖе,КонфликтОтклонен,ОдинЭффект",Первая = Повтор,Конфликт,Запрос.Выполнить().Выгрузить().Количество() = 1 И Первая.ДлительностьМинут = 30);
КонецФункции

Функция ОдинПакет(Знач Позиция,Размер,Всего) Экспорт
    Если ТипЗнч(Позиция) <> Тип("Число") Или ТипЗнч(Размер) <> Тип("Число") Или ТипЗнч(Всего) <> Тип("Число") Тогда ВызватьИсключение "Нужны числа"; КонецЕсли;
    Если Позиция < 0 Или Размер < 1 Или Всего < Позиция Или Цел(Позиция) <> Позиция Или Цел(Размер) <> Размер Или Цел(Всего) <> Всего Тогда ВызватьИсключение "Неверная граница пакета"; КонецЕсли;
    Возврат Мин(Позиция + Размер,Всего);
КонецФункции

Функция ОпытРучногоОбработчика() Экспорт
    Первая = ОдинПакет(0,5,12); Вторая = ОдинПакет(Первая,5,12); Третья = ОдинПакет(Вторая,5,12); ПовторКонца = ОдинПакет(Третья,5,12);
    Отказ = Ложь; Попытка ОдинПакет(0,0,12); Исключение Отказ = Истина; КонецПопытки;
    Возврат Новый Структура("ГраницыВерны,НольОтклонен",Первая = 5 И Вторая = 10 И Третья = 12 И ПовторКонца = 12,Отказ);
КонецФункции

// PLANNED: собственные новые задачи P11; до фактического запуска не PASS.
Функция ОпытНеуспешногоТела(Порт) Экспорт
    Если ТипЗнч(Порт) <> Тип("Число") Или Порт < 1 Или Порт > 65535 Или Цел(Порт) <> Порт Тогда
        ВызватьИсключение "Нужен порт своего готового mock";
    КонецЕсли;
    Соединение = Новый HTTPСоединение("127.0.0.1",Порт,,,,1);
    Неизвестный = Соединение.Получить(Новый HTTPЗапрос("/missing"));
    Плохой = Соединение.Получить(Новый HTTPЗапрос("/not-json"));
    ОтказТела = Ложь;
    Попытка
        Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Плохой.ПолучитьТелоКакСтроку());
        ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Исключение
        ОтказТела = Истина;
    КонецПопытки;
    Контроль = Соединение.Получить(Новый HTTPЗапрос("/health"));
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Контроль.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Возврат Новый Структура("КодНеизвестного,КодПлохого,ТелоОтклонено,КонтрольВерный",Неизвестный.КодСостояния,Плохой.КодСостояния,ОтказТела,Контроль.КодСостояния = 200 И Данные.service = "nexus-course-mock" И Данные.status = "ok");
КонецФункции

Функция ОпытНовыхГраницПакета() Экспорт
    Пакет = ПроверитьПакет("{""schemaVersion"":1,""minutes"":0,""text"":""Новый & <ноль>""}");
    ВерсияОтклонена = Ложь; ЛишнееОтклонено = Ложь; ДробьОтклонена = Ложь; ДлинаОтклонена = Ложь;
    Попытка ПроверитьПакет("{""schemaVersion"":2,""minutes"":0,""text"":""новый""}"); Исключение ВерсияОтклонена = Истина; КонецПопытки;
    Попытка ПроверитьПакет("{""schemaVersion"":1,""minutes"":0,""text"":""новый"",""extra"":1}"); Исключение ЛишнееОтклонено = Истина; КонецПопытки;
    Попытка ПроверитьПакет("{""schemaVersion"":1,""minutes"":0.5,""text"":""новый""}"); Исключение ДробьОтклонена = Истина; КонецПопытки;
    Длинный = ""; Для Индекс = 1 По 4097 Цикл Длинный = Длинный + "x"; КонецЦикла;
    Попытка ПроверитьПакет(Длинный); Исключение ДлинаОтклонена = Истина; КонецПопытки;
    Возврат Новый Структура("НольЧислом,ВерсияОтклонена,ЛишнееОтклонено,ДробьОтклонена,ДлинаОтклонена",Пакет.minutes = 0 И ТипЗнч(Пакет.minutes) = Тип("Число"),ВерсияОтклонена,ЛишнееОтклонено,ДробьОтклонена,ДлинаОтклонена);
КонецФункции

Функция ОпытДвухНамерений() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P11 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P11"; Услуга.Записать();
    ПервыйКлюч = Строка(Новый УникальныйИдентификатор); ВторойКлюч = Строка(Новый УникальныйИдентификатор);
    Первая = ПринятьУчебнуюОперацию(ПервыйКлюч,45,Клиент.Ссылка,Услуга.Ссылка);
    Повтор = ПринятьУчебнуюОперацию(ПервыйКлюч,45,Клиент.Ссылка,Услуга.Ссылка);
    Другая = ПринятьУчебнуюОперацию(ВторойКлюч,45,Клиент.Ссылка,Услуга.Ссылка);
    Конфликт = Ложь; Попытка ПринятьУчебнуюОперацию(ПервыйКлюч,46,Клиент.Ссылка,Услуга.Ссылка); Исключение Конфликт = Истина; КонецПопытки;
    Ключи = Новый Массив; Ключи.Добавить(ПервыйКлюч); Ключи.Добавить(ВторойКлюч);
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Комментарий В (&Ключи)");
    Запрос.УстановитьПараметр("Ключи",Ключи); Таблица = Запрос.Выполнить().Выгрузить();
    Возврат Новый Структура("ПовторТотЖе,НовоеНамерениеДругое,КонфликтОтклонен,Эффектов,Минуты",Первая = Повтор,Другая <> Первая,Конфликт,Таблица.Количество(),Таблица.Итог("Минуты"));
КонецФункции

Функция ОпытОстановкиМеждуПакетами() Экспорт
    // Ручные вызовы: позиции в памяти, не расписание и не доказанный crash recovery.
    Позиция = ОдинПакет(0,3,7); СохранённаяПозиция = Позиция;
    ОтменаЗапрошена = Истина;
    Если Не ОтменаЗапрошена Тогда Позиция = ОдинПакет(Позиция,3,7); КонецЕсли;
    ПослеОстановки = Позиция;
    ПослеПродолжения = ОдинПакет(СохранённаяПозиция,3,7);
    КонецРаботы = ОдинПакет(ПослеПродолжения,3,7);
    ПовторКонца = ОдинПакет(КонецРаботы,3,7);
    Возврат Новый Структура("ПервыйПакет,ПослеОстановки,ПослеПродолжения,Конец,ПовторКонца",СохранённаяПозиция,ПослеОстановки,ПослеПродолжения,КонецРаботы,ПовторКонца);
КонецФункции
