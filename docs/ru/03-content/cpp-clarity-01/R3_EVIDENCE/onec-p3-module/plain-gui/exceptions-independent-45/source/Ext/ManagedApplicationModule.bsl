Функция ПрочитатьМинуты(Знач ИсходныйТекст)
    Итог = Новый Структура("Успех,Минуты,Причина", Ложь, Неопределено, "");
    Если СокрЛП(ИсходныйТекст) = "" Тогда
        Итог.Причина = "empty_input";
        Возврат Итог;
    КонецЕсли;
    Попытка
        Минуты = Число(ИсходныйТекст);
    Исключение
        Итог.Причина = "invalid_format";
        Возврат Итог;
    КонецПопытки;
    Если Минуты < 0 Или Минуты > 180 Тогда
        Итог.Причина = "out_of_range";
        Возврат Итог;
    КонецЕсли;
    Итог.Успех = Истина;
    Итог.Минуты = Минуты;
    Итог.Причина = "ok";
    Возврат Итог;
КонецФункции

Процедура ПриНачалеРаботыСистемы()
    ИсходныйТекст = "45";
    Ответ = ПрочитатьМинуты(ИсходныйТекст);
    Сообщить(Ответ.Причина);
    Если Ответ.Успех Тогда
        Сообщить(Ответ.Минуты);
    Иначе
        Сообщить("empty");
    КонецЕсли;
    Сообщить("source=[" + ИсходныйТекст + "]");
КонецПроцедуры
