Функция Стоимость(Знач Минуты, Знач ТарифЗаЧас)
    Если ТипЗнч(Минуты) <> Тип("Число") Или ТипЗнч(ТарифЗаЧас) <> Тип("Число") Тогда
        ВызватьИсключение "Ожидались числа";
    КонецЕсли;
    Если Минуты < 0 Или ТарифЗаЧас < 0 Тогда
        ВызватьИсключение "Ожидались неотрицательные числа";
    КонецЕсли;
    Возврат Окр(Минуты * ТарифЗаЧас / 60, 2);
КонецФункции

Процедура ПроверитьРавно(Факт, Ожидание, Название)
    Если Факт <> Ожидание Тогда
        ВызватьИсключение "Не пройдено: " + Название;
    КонецЕсли;
КонецПроцедуры

Процедура ПриНачалеРаботыСистемы()
    ПроверитьРавно(Стоимость(30, 1200), 600, "полчаса");
    ПроверитьРавно(Стоимость(0, 1200), 0, "ноль минут");
    ПроверитьРавно(Стоимость(60, 1200), 1200, "час");
    ОтказНаблюден = Ложь;
    Попытка
        Стоимость(-1, 1200);
    Исключение
        ОтказНаблюден = Истина;
    КонецПопытки;
    ПроверитьРавно(ОтказНаблюден, Истина, "отрицательная длительность отвергнута");
    ПроверитьРавно(Стоимость(1, 1200), 20, "минута");
    Результат = 5;
    Сообщить("Пройдены пять учебных проверок");
КонецПроцедуры
