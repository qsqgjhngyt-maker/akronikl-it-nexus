Функция КопияМинут(Знач Источник)
    Копия = Новый Массив;
    Для Каждого Минуты Из Источник Цикл
        Копия.Добавить(Минуты);
    КонецЦикла;
    Возврат Копия;
КонецФункции

Процедура ПриНачалеРаботыСистемы()
    Исходный = Новый Массив;
    Исходный.Добавить(10);
    Исходный.Добавить(20);
    Копия = КопияМинут(Исходный);
    Если Копия.Количество() > 0 Тогда
        Копия[0] = 99;
        Сообщить(Исходный[0]);
        Сообщить(Копия[0]);
    Иначе
        Сообщить("empty");
        Сообщить("empty");
    КонецЕсли;
    Сообщить(Копия.Количество());
КонецПроцедуры
