    МинутыЗаявок = Новый Массив;
    МинутыЗаявок.Добавить(30);
    МинутыЗаявок.Добавить(45);
    МинутыЗаявок.Добавить(15);
    Результат = 0;
    Для Каждого Минуты Из МинутыЗаявок Цикл
        Результат = Результат + Минуты;
    КонецЦикла;
    Карточка = Новый Структура("Клиент,Минуты", "Учебный клиент", Результат);
    Итоги = Новый Соответствие;
    Итоги.Вставить("Клиент-А", Карточка.Минуты);
