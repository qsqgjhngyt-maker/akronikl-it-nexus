
Функция QABool(Знач Значение)
    Если Значение Тогда Возврат "true"; КонецЕсли;
    Возврат "false";
КонецФункции
Функция QAПервый(Знач МассивЗначений)
    Если МассивЗначений.Количество() = 0 Тогда Возврат "empty"; КонецЕсли;
    Возврат Строка(МассивЗначений[0]);
КонецФункции
Функция QAЗначение(Знач Значение)
    Если Значение = Неопределено Тогда Возврат "empty"; КонецЕсли;
    Возврат Строка(Значение);
КонецФункции

Функция QARun() Экспорт
    МинутыЗаявок = Новый Массив;
    МинутыЗаявок.Добавить(30);
    МинутыЗаявок.Добавить(45);
    Результат = 0;
    Для Каждого Минуты Из МинутыЗаявок Цикл
        Результат = Результат + Минуты;
    КонецЦикла;
    Карточка = Новый Структура("Клиент,Минуты", "Учебный клиент", Результат);
    Итоги = Новый Соответствие;
    Итоги.Вставить("Клиент-А", Карточка.Минуты);
    Сообщить(МинутыЗаявок[0]);
    Сообщить(Карточка.Минуты);
    Сообщить(Итоги.Получить("Клиент-А"));
    Сообщить(ТипЗнч(Итоги.Получить("нет такого ключа")));
    Возврат QAНеОпределено(Итоги.Получить("нет такого ключа"));
КонецФункции

Функция QAНеОпределено(Знач Значение)
    Если ТипЗнч(Значение) = ТипЗнч(Неопределено) Тогда
        Возврат "Неопределено";
    КонецЕсли;
    Возврат "unexpected:" + Строка(ТипЗнч(Значение));
КонецФункции
