Функция Стоимость(Знач Минуты, Знач ТарифЗаЧас)
    Если ТипЗнч(Минуты) <> Тип("Число") Или ТипЗнч(ТарифЗаЧас) <> Тип("Число") Тогда
        ВызватьИсключение "Минуты и тариф должны быть числами";
    КонецЕсли;
    Если Минуты < 0 Или ТарифЗаЧас < 0 Тогда
        ВызватьИсключение "Минуты и тариф не могут быть отрицательными";
    КонецЕсли;
    Возврат Окр(Минуты * ТарифЗаЧас / 60, 2);
КонецФункции

Функция QABool(Знач Значение)
    Если Значение Тогда Возврат "true"; КонецЕсли;
    Возврат "false";
КонецФункции
Функция QAПервый(Знач МассивЗначений)
    Если МассивЗначений.Количество() = 0 Тогда Возврат "empty"; КонецЕсли;
    Возврат Строка(МассивЗначений[0]);
КонецФункции
Функция QAЗначение(Знач Значение)
    Если Значение = Неопределено Тогда Возврат "empty"; КонецЕсли;
    Возврат Строка(Значение);
КонецФункции

Функция QARun() Экспорт
    Минуты = -1;
    Результат = Стоимость(Минуты, 1200);
    Сообщить(Результат);
    Сообщить(Минуты);
    Возврат Строка(Результат) + "|" + Строка(Минуты);
КонецФункции
