Процедура ПриНачалеРаботыСистемы()
    УчебноеЧисло = 7.5;
    Представление = Формат(УчебноеЧисло, "ЧДЦ=2; ЧРД=.; ЧГ=0");
    НачалоРаботы = Дата(2026, 11, 30, 23, 58, 30);
    МинутыРаботы = 3;
    ДополнительныеСекунды = 30;
    ДлительностьСекунд = МинутыРаботы + ДополнительныеСекунды;
    КонецРаботы = НачалоРаботы + ДлительностьСекунд;
    РазностьСекунд = КонецРаботы - НачалоРаботы;
    Сообщить(Формат(КонецРаботы, "ДФ='dd.MM.yyyy HH:mm:ss'"));
    Сообщить(РазностьСекунд);
    Сообщить(Представление);
    Сообщить(ТипЗнч(УчебноеЧисло));
    Сообщить(ТипЗнч(Представление));
КонецПроцедуры
