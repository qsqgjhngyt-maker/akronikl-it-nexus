Функция ОпытДругойУслуги() Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент();
    Клиент.Наименование = "Учебный клиент для 45 минут";
    Клиент.Записать();
    Первая = Справочники.Услуги.СоздатьЭлемент();
    Первая.Наименование = "Учебная услуга А";
    Первая.ТарифЗаЧас = 600;
    Первая.Записать();
    Вторая = Справочники.Услуги.СоздатьЭлемент();
    Вторая.Наименование = "Учебная услуга Б";
    Вторая.ТарифЗаЧас = 900;
    Вторая.Записать();
    Заявка = Документы.ЗаявкаУслуги.СоздатьДокумент();
    Заявка.Дата = Дата(2026, 11, 8, 10, 0, 0);
    Заявка.Клиент = Клиент.Ссылка;
    Заявка.Услуга = Первая.Ссылка;
    Заявка.ДлительностьМинут = 45;
    Заявка.Статус = Перечисления.СтатусыЗаявки.ВРаботе;
    Заявка.Комментарий = "Отдельный учебный опыт замены ссылки";
    Заявка.Записать();
    СсылкаЗаявки = Заявка.Ссылка;
    Заявка.Услуга = Вторая.Ссылка;
    Заявка.Записать();
    Вторая.Наименование = "Учебная услуга Б — новое имя";
    Вторая.Записать();
    Повторно = СсылкаЗаявки.ПолучитьОбъект();
    Возврат Новый Структура("ТаЖеЗаявка,КлиентТотЖе,УслугаЗаменена,МинутыСохранены,ИмяУслуги",
        Повторно.Ссылка = СсылкаЗаявки, Повторно.Клиент = Клиент.Ссылка,
        Повторно.Услуга = Вторая.Ссылка И Повторно.Услуга <> Первая.Ссылка,
        Повторно.ДлительностьМинут = 45, Повторно.Услуга.Наименование);
КонецФункции
