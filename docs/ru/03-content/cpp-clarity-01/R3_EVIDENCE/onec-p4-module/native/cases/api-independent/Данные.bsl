Функция ОпытСохраненияТарифа() Экспорт
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебное сохранение тарифа";
    Услуга.ТарифЗаЧас = 600;
    Услуга.Записать();
    СсылкаДо = Услуга.Ссылка;
    Код = Услуга.Код;
    Черновик = СсылкаДо.ПолучитьОбъект();
    Черновик.ТарифЗаЧас = 800;
    ДоЗаписи = СсылкаДо.ПолучитьОбъект().ТарифЗаЧас;
    Черновик.Записать();
    ПослеЗаписи = Справочники.Услуги.НайтиПоКоду(Код).ПолучитьОбъект();
    Возврат Новый Структура("ТарифЧерновика,ТарифДоЗаписи,ТарифПослеЗаписи,ТаЖеСсылка",
        Черновик.ТарифЗаЧас, ДоЗаписи, ПослеЗаписи.ТарифЗаЧас,
        ПослеЗаписи.Ссылка = СсылкаДо);
КонецФункции
