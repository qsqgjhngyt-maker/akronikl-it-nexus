Функция ОпытТарифа() Экспорт
    Первая = Справочники.Услуги.СоздатьЭлемент();
    Первая.Наименование = "Учебная услуга с тарифом";
    Первая.ТарифЗаЧас = 600;
    Первая.Записать();
    СсылкаДо = Первая.Ссылка;
    Первая.ТарифЗаЧас = 800;
    Первая.Записать();
    Вторая = Справочники.Услуги.СоздатьЭлемент();
    Вторая.Наименование = Первая.Наименование;
    Вторая.ТарифЗаЧас = 900;
    Вторая.Записать();
    Возврат Новый Структура("ТаЖеСсылка,РазныеСсылки,ПервыйТариф,ВторойТариф",
        Первая.Ссылка = СсылкаДо, Вторая.Ссылка <> СсылкаДо,
        Первая.Ссылка.ПолучитьОбъект().ТарифЗаЧас,
        Вторая.Ссылка.ПолучитьОбъект().ТарифЗаЧас);
КонецФункции
