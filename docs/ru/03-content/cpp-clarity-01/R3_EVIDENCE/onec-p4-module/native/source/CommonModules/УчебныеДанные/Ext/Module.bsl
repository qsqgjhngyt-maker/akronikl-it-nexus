Функция ОпытТиповМетаданных() Экспорт
    Поля = Метаданные.Документы.ЗаявкаУслуги.Реквизиты;
    ТипКлиента = Поля.Клиент.Тип;
    ТипМинут = Поля.ДлительностьМинут.Тип;
    Статус = Перечисления.СтатусыЗаявки.Новая;
    Возврат Новый Структура("КлиентСсылка,МинутыЧисло,СтатусПеречисление,СтрокаНеСтатус",
        ТипКлиента.СодержитТип(Тип("СправочникСсылка.Клиенты")),
        ТипМинут.СодержитТип(Тип("Число")),
        ТипЗнч(Статус) = Тип("ПеречислениеСсылка.СтатусыЗаявки"),
        ТипЗнч("Новая") <> ТипЗнч(Статус));
КонецФункции

Функция ОпытМенеджераОбъектаВыборки() Экспорт
    Объект = Справочники.Клиенты.СоздатьЭлемент();
    Объект.Наименование = "Учебный API — сохранено";
    Объект.Записать();
    Ссылка = Объект.Ссылка;
    Код = Объект.Код;
    Черновик = Ссылка.ПолучитьОбъект();
    Черновик.Наименование = "Учебный API — ещё не записано";
    ДоЗаписи = Ссылка.ПолучитьОбъект().Наименование;
    Черновик.Записать();
    ПослеЗаписи = Справочники.Клиенты.НайтиПоКоду(Код).ПолучитьОбъект().Наименование;
    Выборка = Справочники.Клиенты.Выбрать();
    Найден = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Выборка.Ссылка = Ссылка Тогда
            Найден = Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("ДоЗаписиНеИзменилось,ПослеЗаписиИзменилось,НайденВыборкой",
        ДоЗаписи = "Учебный API — сохранено",
        ПослеЗаписи = "Учебный API — ещё не записано", Найден);
КонецФункции

