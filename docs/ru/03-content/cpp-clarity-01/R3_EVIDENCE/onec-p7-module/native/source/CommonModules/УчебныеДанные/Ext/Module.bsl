Функция НовыйНаборРегистров(ПервыеМинуты = 30, ВторыеМинуты = 45) Экспорт
    Клиент = Справочники.Клиенты.СоздатьЭлемент(); Клиент.Наименование = "Учебный P6 " + Строка(Новый УникальныйИдентификатор); Клиент.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент(); Услуга.Наименование = "Учебная P6"; Услуга.Записать();
    Ссылки = Новый Массив;
    Для Индекс = 1 По 2 Цикл
        Документ = Документы.ЗаявкаУслуги.СоздатьДокумент(); Документ.Дата = Дата(2026,11,2,11+Индекс,0,0);
        Документ.Клиент = Клиент.Ссылка; Документ.Услуга = Услуга.Ссылка; Документ.Статус = Перечисления.СтатусыЗаявки.Новая;
        Документ.ДлительностьМинут = ?(Индекс = 1,ПервыеМинуты,ВторыеМинуты); Документ.Записать(); Ссылки.Добавить(Документ.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("Клиент,Услуга,Первая,Вторая",Клиент.Ссылка,Услуга.Ссылка,Ссылки[0],Ссылки[1]);
КонецФункции

Функция ОпытПараметров() Экспорт
    Д = НовыйНаборРегистров();
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка, З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент И З.Дата >= &Начало И З.Дата < &Конец");
    Запрос.УстановитьПараметр("Клиент", Д.Клиент);
    Запрос.УстановитьПараметр("Начало", Дата(2026,11,2,12,0,0));
    Запрос.УстановитьПараметр("Конец", Дата(2026,11,2,13,0,0));
    Таблица = Запрос.Выполнить().Выгрузить();
    НаГранице = Таблица.Количество() = 1 И Таблица[0].Ссылка = Д.Первая И Таблица.Итог("Минуты") = 30;
    Запрос.УстановитьПараметр("Клиент", Справочники.Клиенты.ПустаяСсылка());
    Возврат Новый Структура("ГраницаВерна,ПустойКлюч", НаГранице, Запрос.Выполнить().Пустой());
КонецФункции

Функция ОпытСоединения() Экспорт
    Д = НовыйНаборРегистров();
    Пустой = Справочники.Клиенты.СоздатьЭлемент(); Пустой.Наименование = Д.Клиент.Наименование; Пустой.Записать();
    Ключи = Новый Массив; Ключи.Добавить(Д.Клиент); Ключи.Добавить(Пустой.Ссылка);
    Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Клиент, ЕСТЬNULL(СУММА(З.ДлительностьМинут),0) КАК Минуты ИЗ Справочник.Клиенты КАК К ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаУслуги КАК З ПО З.Клиент = К.Ссылка ГДЕ К.Ссылка В (&Ключи) СГРУППИРОВАТЬ ПО К.Ссылка");
    Запрос.УстановитьПараметр("Ключи", Ключи); Таблица = Запрос.Выполнить().Выгрузить();
    Первая = Таблица.Найти(Д.Клиент,"Клиент"); Вторая = Таблица.Найти(Пустой.Ссылка,"Клиент");
    Возврат Новый Структура("ДваКлюча,ИтогВерный,ПустойСохранен",Таблица.Количество() = 2, Первая <> Неопределено И Первая.Минуты = 75, Вторая <> Неопределено И Вторая.Минуты = 0);
КонецФункции

Функция ОпытВременнойТаблицы() Экспорт
    Д = НовыйНаборРегистров(); Менеджер = Новый МенеджерВременныхТаблиц;
    Запрос = Новый Запрос; Запрос.МенеджерВременныхТаблиц = Менеджер;
    Запрос.Текст = "ВЫБРАТЬ З.Ссылка, З.ДлительностьМинут КАК Минуты ПОМЕСТИТЬ СвоиЗаявки ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент";
    Запрос.УстановитьПараметр("Клиент", Д.Клиент); Запрос.Выполнить();
    Итоги = Новый Запрос("ВЫБРАТЬ СУММА(Т.Минуты) КАК Минуты, КОЛИЧЕСТВО(*) КАК ЧислоСтрок ИЗ СвоиЗаявки КАК Т");
    Итоги.МенеджерВременныхТаблиц = Менеджер; Таблица = Итоги.Выполнить().Выгрузить();
    Верно = Таблица[0].Минуты = 75 И Таблица[0].ЧислоСтрок = 2;
    Менеджер.Закрыть();
    Отказ = Ложь; Попытка Итоги.Выполнить(); Исключение Отказ = Истина; КонецПопытки;
    Возврат Новый Структура("НаборВерный,КонтекстЗакрыт",Верно,Отказ);
КонецФункции

Функция ОпытЧислаЗапросов() Экспорт
    Д = НовыйНаборРегистров(); Ссылки = Новый Массив; Ссылки.Добавить(Д.Первая); Ссылки.Добавить(Д.Вторая);
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах(); Сумма = 0; ОтдельныхВызовов = 0;
    Для Каждого Ссылка Из Ссылки Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка = &Ключ");
        Запрос.УстановитьПараметр("Ключ", Ссылка); Сумма = Сумма + Запрос.Выполнить().Выгрузить()[0].Минуты; ОтдельныхВызовов = ОтдельныхВызовов + 1;
    КонецЦикла;
    ОтдельноМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пакет = Новый Запрос("ВЫБРАТЬ З.Ссылка, З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка В (&Ключи)");
    Пакет.УстановитьПараметр("Ключи",Ссылки); Таблица = Пакет.Выполнить().Выгрузить();
    ПакетомМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Возврат Новый Структура("Эквивалентно,ВызовыУменьшены,ОтдельноМс,ПакетомМс",Сумма = 75 И Таблица.Количество() = 2 И Таблица.Итог("Минуты") = Сумма, ОтдельныхВызовов = 2, ОтдельноМс, ПакетомМс);
КонецФункции

Функция ОпытСоседнихОкон() Экспорт
    Д = НовыйНаборРегистров(20,40);
    Запрос = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент И З.Дата >= &Начало И З.Дата < &Конец");
    Запрос.УстановитьПараметр("Клиент",Д.Клиент);
    Запрос.УстановитьПараметр("Начало",Дата(2026,11,2,12,0,0)); Запрос.УстановитьПараметр("Конец",Дата(2026,11,2,13,0,0));
    Первая = Запрос.Выполнить().Выгрузить();
    Запрос.УстановитьПараметр("Начало",Дата(2026,11,2,13,0,0)); Запрос.УстановитьПараметр("Конец",Дата(2026,11,2,14,0,0));
    Вторая = Запрос.Выполнить().Выгрузить();
    Запрос.УстановитьПараметр("Клиент",Справочники.Клиенты.ПустаяСсылка()); Пустая = Запрос.Выполнить().Пустой();
    Возврат Новый Структура("ПервоеОкно,ВтороеОкно,КлючиВерны,ПустойКлюч",
        Первая.Итог("Минуты"),Вторая.Итог("Минуты"),
        Первая.Количество() = 1 И Первая[0].Ссылка = Д.Первая И Вторая.Количество() = 1 И Вторая[0].Ссылка = Д.Вторая,Пустая);
КонецФункции

Функция ОпытУсловияСоединения() Экспорт
    Д = НовыйНаборРегистров(20,40);
    Пустой = Справочники.Клиенты.СоздатьЭлемент(); Пустой.Наименование = Д.Клиент.Наименование; Пустой.Записать();
    Ключи = Новый Массив; Ключи.Добавить(Д.Клиент); Ключи.Добавить(Пустой.Ссылка);
    ТекстВерный = "ВЫБРАТЬ К.Ссылка КАК Клиент,ЕСТЬNULL(СУММА(З.ДлительностьМинут),0) КАК Минуты ИЗ Справочник.Клиенты КАК К ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаУслуги КАК З ПО З.Клиент = К.Ссылка И З.ДлительностьМинут >= &Порог ГДЕ К.Ссылка В (&Ключи) СГРУППИРОВАТЬ ПО К.Ссылка";
    Запрос = Новый Запрос(ТекстВерный); Запрос.УстановитьПараметр("Порог",30); Запрос.УстановитьПараметр("Ключи",Ключи);
    Верная = Запрос.Выполнить().Выгрузить(); Первая = Верная.Найти(Д.Клиент,"Клиент"); Вторая = Верная.Найти(Пустой.Ссылка,"Клиент");
    Неверный = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Клиент,ЕСТЬNULL(СУММА(З.ДлительностьМинут),0) КАК Минуты ИЗ Справочник.Клиенты КАК К ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаУслуги КАК З ПО З.Клиент = К.Ссылка ГДЕ К.Ссылка В (&Ключи) И З.ДлительностьМинут >= &Порог СГРУППИРОВАТЬ ПО К.Ссылка");
    Неверный.УстановитьПараметр("Порог",30); Неверный.УстановитьПараметр("Ключи",Ключи);
    Потеря = Неверный.Выполнить().Выгрузить();
    Возврат Новый Структура("ВерныхСтрок,МинутыПервого,МинутыВторого,НеверныхСтрок",Верная.Количество(),Первая.Минуты,Вторая.Минуты,Потеря.Количество());
КонецФункции

Функция ОпытГраницыМенеджера() Экспорт
    Д = НовыйНаборРегистров(20,40); Менеджер = Новый МенеджерВременныхТаблиц;
    Создание = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ПОМЕСТИТЬ МойОтбор ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Клиент = &Клиент И З.ДлительностьМинут >= &Порог");
    Создание.МенеджерВременныхТаблиц = Менеджер; Создание.УстановитьПараметр("Клиент",Д.Клиент); Создание.УстановитьПараметр("Порог",30); Создание.Выполнить();
    Итоги = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Строк,СУММА(Т.Минуты) КАК Минуты ИЗ МойОтбор КАК Т"); Итоги.МенеджерВременныхТаблиц = Менеджер;
    Факт = Итоги.Выполнить().Выгрузить()[0];
    ДругойМенеджер = Новый МенеджерВременныхТаблиц; ДругойЗапрос = Новый Запрос(Итоги.Текст); ДругойЗапрос.МенеджерВременныхТаблиц = ДругойМенеджер;
    ДругойОтклонен = Ложь; Попытка ДругойЗапрос.Выполнить(); Исключение ДругойОтклонен = Истина; КонецПопытки; ДругойМенеджер.Закрыть();
    СохраненСвой = Итоги.Выполнить().Выгрузить()[0].Минуты = 40;
    Менеджер.Закрыть(); ЗакрытыйОтклонен = Ложь; Попытка Итоги.Выполнить(); Исключение ЗакрытыйОтклонен = Истина; КонецПопытки;
    Возврат Новый Структура("Строк,Минуты,ДругойОтклонен,СвойСохранен,ЗакрытыйОтклонен",Факт.Строк,Факт.Минуты,ДругойОтклонен,СохраненСвой,ЗакрытыйОтклонен);
КонецФункции

Функция ОпытТрехКлючей() Экспорт
    Д = НовыйНаборРегистров(20,40);
    Третья = Документы.ЗаявкаУслуги.СоздатьДокумент(); Третья.Дата = Дата(2026,11,2,14,0,0); Третья.Клиент = Д.Клиент; Третья.Услуга = Д.Услуга;
    Третья.Статус = Перечисления.СтатусыЗаявки.Новая; Третья.ДлительностьМинут = 60; Третья.Записать();
    Ключи = Новый Массив; Ключи.Добавить(Д.Первая); Ключи.Добавить(Д.Вторая); Ключи.Добавить(Третья.Ссылка);
    ПоОдному = 0; Сумма = 0;
    Для Каждого Ключ Из Ключи Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка = &Ключ"); Запрос.УстановитьПараметр("Ключ",Ключ);
        Сумма = Сумма + Запрос.Выполнить().Выгрузить()[0].Минуты; ПоОдному = ПоОдному + 1;
    КонецЦикла;
    Пакет = Новый Запрос("ВЫБРАТЬ З.Ссылка,З.ДлительностьМинут КАК Минуты ИЗ Документ.ЗаявкаУслуги КАК З ГДЕ З.Ссылка В (&Ключи)"); Пакет.УстановитьПараметр("Ключи",Ключи);
    Таблица = Пакет.Выполнить().Выгрузить(); Пакетных = 1;
    Совпало = Таблица.Количество() = 3 И Сумма = 120 И Таблица.Итог("Минуты") = Сумма;
    Для Каждого Ключ Из Ключи Цикл Совпало = Совпало И Таблица.Найти(Ключ,"Ссылка") <> Неопределено; КонецЦикла;
    Возврат Новый Структура("Совпало,ПоОдному,Пакетных,Минуты",Совпало,ПоОдному,Пакетных,Таблица.Итог("Минуты"));
КонецФункции
