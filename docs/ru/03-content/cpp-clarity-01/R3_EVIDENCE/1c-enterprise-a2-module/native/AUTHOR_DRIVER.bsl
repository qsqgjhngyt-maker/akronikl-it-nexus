Функция НовыйКлиент(Код, Имя)
    О = Справочники.Клиенты.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция НоваяУслуга(Код, Имя)
    О = Справочники.Услуги.СоздатьЭлемент(); О.Код = Код; О.Наименование = Имя; О.ТарифЗаЧас = 0; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция Заявка(Номер, Клиент, Услуга, Минуты, Комментарий)
    О = Документы.ЗаявкаУслуги.СоздатьДокумент(); О.Номер = Номер; О.Дата = Дата(2026,11,8,12,0,0); О.Клиент = Клиент; О.Услуга = Услуга; О.ДлительностьМинут = Минуты; О.Статус = Перечисления.СтатусыЗаявки.Новая; О.Комментарий = Комментарий; О.Записать(); Возврат О.Ссылка;
КонецФункции
Функция СколькоЗаявок()
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги");
    Возврат Запрос.Выполнить().Выгрузить().Количество();
КонецФункции
Функция СнимокЗаявки(Ссылка)
    О = Ссылка.ПолучитьОбъект(); Возврат Строка(Ссылка.УникальныйИдентификатор()) + "|" + О.Номер + "|" + Строка(О.Клиент.УникальныйИдентификатор()) + "|" + Строка(О.Услуга.УникальныйИдентификатор()) + "|" + Строка(О.Дата) + "|" + Строка(О.ДлительностьМинут) + "|" + Строка(О.Статус) + "|" + О.Комментарий;
КонецФункции
Функция ОсновнойОпыт() Экспорт
    Если СколькоЗаявок() <> 0 Тогда ВызватьИсключение "Нужна отдельная пустая практика"; КонецЕсли;
    Север = НовыйКлиент("A2N1","Учебный Север"); КодДо = Север.Код; О = Север.ПолучитьОбъект(); О.Наименование = "Учебный Север — ремонт"; О.Записать(); КлиентТаЖеСсылка = О.Ссылка = Север;
    Юг = НовыйКлиент("A2S1","Учебный Юг"); Услуга = НоваяУслуга("A2U1","Учебная диагностика");
    Первая = Заявка("A20000001",Север,Услуга,30,"Первое учебное обращение"); О = Первая.ПолучитьОбъект(); О.Статус = Перечисления.СтатусыЗаявки.ВРаботе; О.Записать();
    Вторая = Заявка("A20000002",Юг,Услуга,45,"Второе учебное обращение");
    Отказ = Ложь;
    Попытка Заявка("A29999999",Справочники.Клиенты.ПустаяСсылка(),Услуга,30,"Ошибочная новая форма"); Исключение Отказ = Истина; КонецПопытки;
    Поиск = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаявкаУслуги ГДЕ Номер = &Номер"); Поиск.УстановитьПараметр("Номер","A20000001"); Найдено = Поиск.Выполнить().Выгрузить().Количество(); Поиск.УстановитьПараметр("Номер","ABSENT001"); ПустойПоиск = Поиск.Выполнить().Выгрузить().Количество();
    Возврат Новый Структура("renameSameRef,renameSameCode,customers,documents,firstMinutes,secondMinutes,firstInProgress,missingCustomerRefused,foundFirst,missingSearch,firstSnapshot,secondSnapshot,postingFalse",КлиентТаЖеСсылка,Север.Код = КодДо,2,СколькоЗаявок(),Первая.ДлительностьМинут,Вторая.ДлительностьМинут,Первая.Статус = Перечисления.СтатусыЗаявки.ВРаботе,Отказ,Найдено,ПустойПоиск,СнимокЗаявки(Первая),СнимокЗаявки(Вторая),Не Первая.Проведен И Не Вторая.Проведен);
КонецФункции
Функция НовыйСамостоятельныйОпыт() Экспорт
    ПерваяОсновная = Документы.ЗаявкаУслуги.НайтиПоНомеру("A20000001"); ВтораяОсновная = Документы.ЗаявкаУслуги.НайтиПоНомеру("A20000002"); До1 = СнимокЗаявки(ПерваяОсновная); До2 = СнимокЗаявки(ВтораяОсновная);
    Восток = НовыйКлиент("A2E1","Учебный Восток"); СсылкаДо = Восток; КодДо = Восток.Код; Клиент = Восток.ПолучитьОбъект(); Клиент.Наименование = "Учебный Восток — сервис"; Клиент.Записать();
    Запад = НовыйКлиент("A2W1","Учебный Запад"); Услуга = НоваяУслуга("A2U2","Учебная настройка");
    Первая = Заявка("A20000003",Восток,Услуга,20,"Моя первая новая заявка"); Вторая = Заявка("A20000004",Запад,Услуга,55,"Моя вторая новая заявка"); ДоВторой = СнимокЗаявки(Вторая); О = Первая.ПолучитьОбъект(); О.Комментарий = "Моя навигация"; О.Записать();
    Возврат Новый Структура("renameSameRef,renameSameCode,distinctCustomerRefs,firstMinutes,secondMinutes,firstComment,secondUnchanged,workedPairUnchanged,totalDocuments,firstSnapshot,secondSnapshot",Клиент.Ссылка = СсылкаДо,Восток.Код = КодДо,Восток <> Запад,Первая.ДлительностьМинут,Вторая.ДлительностьМинут,Первая.Комментарий,СнимокЗаявки(Вторая) = ДоВторой,До1 = СнимокЗаявки(ПерваяОсновная) И До2 = СнимокЗаявки(ВтораяОсновная),СколькоЗаявок(),СнимокЗаявки(Первая),СнимокЗаявки(Вторая));
КонецФункции

Функция ПовторноеЧтение() Экспорт
    Номера = Новый Массив; Номера.Добавить("A20000001"); Номера.Добавить("A20000002"); Номера.Добавить("A20000003"); Номера.Добавить("A20000004");
    Снимки = Новый Массив;
    Для Каждого Номер Из Номера Цикл Снимки.Добавить(СнимокЗаявки(Документы.ЗаявкаУслуги.НайтиПоНомеру(Номер))); КонецЦикла;
    Возврат Новый Структура("documents,snapshots",СколькоЗаявок(),Снимки);
КонецФункции
