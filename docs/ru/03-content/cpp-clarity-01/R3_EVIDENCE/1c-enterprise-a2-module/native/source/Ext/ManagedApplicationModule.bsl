Процедура ПриНачалеРаботыСистемы()
    Части = СтрРазделить(ПараметрЗапуска,"|");
    Если Части.Количество() = 1 Тогда Сообщить("Моя учебная служба работает"); Возврат; КонецЕсли;
    Попытка
        Если Части[0] = "main" Тогда Итог = УчебныйОбзор.ОсновнойОпыт(); ИначеЕсли Части[0] = "independent" Тогда Итог = УчебныйОбзор.НовыйСамостоятельныйОпыт(); Иначе Итог = УчебныйОбзор.ПовторноеЧтение(); КонецЕсли;
        Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись,Итог); СтрокаJSON = Запись.Закрыть();
        Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(СтрокаJSON); Текст.Записать(Части[1],КодировкаТекста.UTF8);
    Исключение
        Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(ОписаниеОшибки()); Текст.Записать(Части[1]+".private-error",КодировкаТекста.UTF8);
    КонецПопытки;
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
