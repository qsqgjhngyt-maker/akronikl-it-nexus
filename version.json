{
  "version": "0.1.6-alpha.2",
  "channel": "alpha",
  "build": "multi-file-code-studio",
  "date": "2026-09-22",
  "foundation": "v0.3",
  "legacyCpp": "v7",
  "content": {
    "cppLessonsRu": 40,
    "cppLessonsEnAuthored": 3,
    "cppPracticumsRu": 6,
    "cppProjectsRu": 7,
    "benchmarkLessonsComplete": 3
  },
  "notes": "Multi-file Code Studio: persistent workspace, file tree and tabs, add/rename/delete, 4-file C++ demo, real multi-translation-unit Clang/WASM builds, and file-aware Problems navigation.",
  "lessonStandard": "1.0-normative-production",
  "runtime": {
    "router": "language-neutral",
    "providers": [
      "browser-jscpp",
      "wasm-cpp-clang-wasi",
      "secure-cloud-build-planned"
    ],
    "wasmCompiler": "@yowasp/clang@22.0.0-git20542-10",
    "wasiRunner": "@runno/wasi@0.10.0",
    "target": "wasm32-wasip1",
    "execution": "dedicated-worker",
    "languageRegistryCount": 24,
    "cppExceptions": "disabled-by-pinned-yowasp-sysroot"
  },
  "codeStudio": {
    "status": "multi-file",
    "editor": "overlay-textarea-with-local-highlighter",
    "features": [
      "syntax-highlighting",
      "line-numbers",
      "bracket-matching",
      "auto-indent",
      "find",
      "per-file-undo-redo",
      "file-tree",
      "file-tabs",
      "add-rename-delete",
      "clickable-file-aware-diagnostics",
      "problems-panel",
      "persistent-workspace",
      "multi-translation-unit-build"
    ],
    "workspace": "multi-file-ui-and-runtime",
    "runtimeBaseline": "0.1.5-alpha.2.2"
  }
}
