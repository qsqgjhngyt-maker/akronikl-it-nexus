<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#07111f">
  <meta name="description" content="AKRONIKL IT NEXUS — инженерная образовательная IT-платформа.">
  <title>AKRONIKL IT NEXUS</title>
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="icon" href="./assets/icons/anx-icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="./assets/icons/apple-touch-icon.png">
  <link rel="stylesheet" href="./styles/app.css?v=0.1.0-alpha.1.2">
  <style>
    html,body{margin:0;min-height:100%;background:#07111f;color:#eef6ff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    #anx-boot{box-sizing:border-box;min-height:100vh;display:grid;place-items:center;padding:28px;background:radial-gradient(circle at 50% 20%,#102843 0,#07111f 52%,#040a12 100%)}
    .anx-boot-card{width:min(760px,100%);box-sizing:border-box;border:1px solid rgba(145,196,255,.2);border-radius:24px;padding:28px;background:rgba(8,22,38,.86);box-shadow:0 24px 80px rgba(0,0,0,.32)}
    .anx-boot-mark{display:inline-grid;place-items:center;width:52px;height:52px;border-radius:16px;background:#e9f5ff;color:#07111f;font-weight:900;letter-spacing:.04em}
    .anx-boot-card h1{margin:18px 0 6px;font-size:clamp(28px,5vw,48px);letter-spacing:-.04em}.anx-boot-card p{margin:8px 0;color:#a8bdd0;line-height:1.6}
    .anx-loader{height:4px;margin:24px 0 10px;border-radius:999px;overflow:hidden;background:rgba(255,255,255,.08)}.anx-loader i{display:block;width:42%;height:100%;background:#e9f5ff;animation:anxload 1.2s ease-in-out infinite alternate}@keyframes anxload{from{transform:translateX(-70%)}to{transform:translateX(240%)}}
    .anx-error{white-space:pre-wrap;word-break:break-word;margin-top:18px;padding:16px;border-radius:14px;background:#2a1218;color:#ffd7df;font:13px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace}.anx-hint{font-size:13px;color:#8ca4ba}
  </style>
</head>
<body>
  <div id="app">
    <main id="anx-boot">
      <section class="anx-boot-card">
        <span class="anx-boot-mark">ANX</span>
        <h1>AKRONIKL IT NEXUS</h1>
        <p>Запускаю Platform Shell v0.1.0-alpha.1.2…</p>
        <div class="anx-loader"><i></i></div>
        <p class="anx-hint">Если основной модуль не загрузится, здесь появится точная диагностическая ошибка вместо пустой страницы.</p>
      </section>
    </main>
  </div>
  <script>
  (() => {
    const VERSION = '0.1.0-alpha.1.2';
    window.__ANX_DISABLE_SW__ = true;
    const app = document.getElementById('app');
    const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    const showError = (title, err) => {
      const text = err && (err.stack || err.message) ? (err.stack || err.message) : String(err || 'Unknown error');
      app.innerHTML = `<main id="anx-boot"><section class="anx-boot-card"><span class="anx-boot-mark">ANX</span><h1>${esc(title)}</h1><p>Platform Shell не смог продолжить запуск. Ошибка показана ниже — её можно прислать разработчику целиком.</p><div class="anx-error">${esc(text)}</div><p class="anx-hint">Версия: ${VERSION}</p></section></main>`;
    };
    const cleanupOldPwa = async () => {
      try {
        if ('serviceWorker' in navigator) {
          const regs = await navigator.serviceWorker.getRegistrations();
          await Promise.all(regs.map(r => r.unregister()));
        }
        if ('caches' in window) {
          const keys = await caches.keys();
          await Promise.all(keys.filter(k => k.startsWith('anx-')).map(k => caches.delete(k)));
        }
      } catch (e) {
        console.warn('ANX PWA cleanup warning', e);
      }
    };
    (async () => {
      try {
        await cleanupOldPwa();
        await import(`./core/app.js?v=${encodeURIComponent(VERSION)}`);
      } catch (err) {
        console.error('ANX bootstrap failed', err);
        showError('Ошибка запуска AKRONIKL IT NEXUS', err);
      }
    })();
  })();
  </script>
</body>
</html>
