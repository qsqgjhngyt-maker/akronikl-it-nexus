// Только новая отдельная синтетическая база учебной службы.
// Общий модуль: Сервер + Вызов сервера; без Глобальный/Привилегированный.
Функция ПодготовитьНабор(ПервыеМинуты, ВторыеМинуты, ИмяКлиента) Экспорт
    Первый = Справочники.Клиенты.СоздатьЭлемент();
    Первый.Наименование = ИмяКлиента;
    Первый.Записать();
    Пустой = Справочники.Клиенты.СоздатьЭлемент();
    Пустой.Наименование = ИмяКлиента;
    Пустой.Записать();
    Услуга = Справочники.Услуги.СоздатьЭлемент();
    Услуга.Наименование = "Учебная услуга R3";
    Услуга.Записать();

    Заявки = Новый Массив;
    Для Номер = 1 По 2 Цикл
        Заявка = Документы.ЗаявкаУслуги.СоздатьДокумент();
        Заявка.Дата = Дата(2026, 11, 5, 10 + Номер, 0, 0);
        Заявка.Клиент = Первый.Ссылка;
        Заявка.Услуга = Услуга.Ссылка;
        Заявка.Статус = Перечисления.СтатусыЗаявки.Новая;
        Заявка.ДлительностьМинут = ?(Номер = 1, ПервыеМинуты, ВторыеМинуты);
        Заявка.Записать();
        Заявки.Добавить(Заявка.Ссылка);
    КонецЦикла;
    Ключи = Новый Массив;
    Ключи.Добавить(Первый.Ссылка);
    Ключи.Добавить(Пустой.Ссылка);
    Возврат Новый Структура("ПервыйКлиент,ПустойКлиент,ПерваяЗаявка,ВтораяЗаявка,Ключи",
        Первый.Ссылка, Пустой.Ссылка, Заявки[0], Заявки[1], Ключи);
КонецФункции

Функция ТекстДетальногоЗапроса() Экспорт
    Возврат "ВЫБРАТЬ
    |    К.Ссылка КАК Клиент,
    |    З.Ссылка КАК Заявка,
    |    З.ДлительностьМинут КАК Минуты
    |ИЗ
    |    Справочник.Клиенты КАК К
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаУслуги КАК З
    |        ПО К.Ссылка = З.Клиент
    |ГДЕ
    |    К.Ссылка В (&Ключи)";
КонецФункции

Функция ТекстИтоговогоЗапроса() Экспорт
    Возврат "ВЫБРАТЬ
    |    К.Ссылка КАК Клиент,
    |    ЕСТЬNULL(СУММА(З.ДлительностьМинут), 0) КАК Минуты
    |ИЗ
    |    Справочник.Клиенты КАК К
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаУслуги КАК З
    |        ПО К.Ссылка = З.Клиент
    |ГДЕ
    |    К.Ссылка В (&Ключи)
    |СГРУППИРОВАТЬ ПО
    |    К.Ссылка";
КонецФункции

Функция ВыполнитьЗапрос(ТекстЗапроса, Ключи) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("Ключи", Ключи);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция МеткаКлиента(Ссылка, Данные, ПерваяМетка = "A", ВтораяМетка = "B") Экспорт
    Если Ссылка = Данные.ПервыйКлиент Тогда
        Возврат ПерваяМетка;
    КонецЕсли;
    Если Ссылка = Данные.ПустойКлиент Тогда
        Возврат ВтораяМетка;
    КонецЕсли;
    ВызватьИсключение "Неизвестная ссылка вне собственного набора R3";
КонецФункции

Функция ТекстМинут(Значение) Экспорт
    Если ТипЗнч(Значение) = Тип("Null") Тогда
        Возврат "NULL";
    КонецЕсли;
    Возврат Строка(Значение);
КонецФункции
